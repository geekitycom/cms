{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "initial-version": "0.1.0",
  "include-component-in-tag": false,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(release): release ${version}",
  "packages": {
    "packages/cms": {
      "package-name": "@geekity/cms",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/plugin-wordpress": {
      "package-name": "@geekity/plugin-wordpress",
      "component": "plugin-wordpress",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/version.ts"],
      "pull-request-title-pattern": "chore(release): release plugin-wordpress ${version}"
    },
    "packages/plugin-llm": {
      "package-name": "@geekity/plugin-llm",
      "component": "plugin-llm",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/version.ts"],
      "pull-request-title-pattern": "chore(release): release plugin-llm ${version}"
    }
  }
}
