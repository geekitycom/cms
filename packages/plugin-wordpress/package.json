{
  "name": "@geekity/plugin-wordpress",
  "version": "0.4.0",
  "type": "module",
  "description": "Geekity CMS plugin for a site that moved from the WordPress ActivityPub plugin: its old inbox and collection paths, and the import that brings each person across.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "geekity": {
    "plugin": true,
    "hostApi": 2,
    "requires": {}
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-plugin-bundle.js",
    "test": "tsx --import ../cms/src/__testing__/offline.ts --test \"test/*.test.ts\"",
    "prefed:smoke": "pnpm --filter @geekity/cms build",
    "fed:smoke": "tsx scripts/fed-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fedify/fedify": "^2.4.3",
    "@fedify/vocab": "^2.4.3",
    "entities": "^8.1.0",
    "sax": "^1.6.1",
    "turndown": "^7.2.4"
  },
  "peerDependencies": {
    "@geekity/cms": "workspace:^"
  },
  "devDependencies": {
    "@fedify/cli": "2.4.3",
    "@geekity/cms": "workspace:*",
    "@geekity/plugin-llm": "workspace:*",
    "@geekity/plugin-post-summary": "workspace:*",
    "@geekity/plugin-tag-suggest": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@types/node": "^26.6.5",
    "@types/sax": "^1.2.7",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
