{# The signed-in admin: the bar across the top, the sections down the left,
   the screen itself beside them. Every screen behind the login extends this
   and fills in `content`, starting with its own <h1>.

   The menu is a DaisyUI drawer: always open from `lg` up, and below that a
   panel the Menu button slides in over the screen. The checkbox only shows
   or hides the panel. Which section is open, and which screen is current,
   the server already wrote into the list, so no script decides anything.
   The panel sits under the fixed bar by the bar's own height. #}
{% extends "layouts/base.njk" %}
{% from "components/menu.njk" import menu %}

{% block chrome %}
  {# View site, because in here you are not looking at it; + New, as on the
     public site; and, on the editor of something readers can see, the way to
     go and look at it. #}
  {% set siteHref = adminUrl %}
  {% set barLinks = [{ label: "View site", url: siteUrl }, { label: "+ New", url: newPostUrl }] %}
  {% if viewUrl and kind %}
    {% set barLinks = barLinks.concat([{ label: "View " + (kind.singular | capitalize), url: viewUrl }]) %}
  {% endif %}
  {% include "components/admin-bar.njk" %}
{% endblock %}

{% block main %}
  <div class="drawer lg:drawer-open">
    {# Off, so a browser going back to this page does not bring the panel
       back open over it. #}
    <input id="admin-menu" type="checkbox" class="drawer-toggle" autocomplete="off" />
    {# Ahead of the screen, so a keyboard meets the menu first, as it did
       in the old shell. DaisyUI places the two by grid column, not order. #}
    <div class="drawer-side lg:top-(--geekity-admin-bar-height) lg:h-[calc(100dvh-var(--geekity-admin-bar-height))]">
      <label for="admin-menu" class="drawer-overlay" aria-hidden="true"></label>
      <nav aria-label="Sections" class="min-h-full w-64 bg-base-100 pt-(--geekity-admin-bar-height) lg:pt-0">
        {{ menu(navigation) }}
      </nav>
    </div>
    <div class="drawer-content">
      <label for="admin-menu" class="btn btn-sm drawer-button mx-4 mt-4 lg:hidden">Menu</label>
      <main id="main" class="p-4 sm:p-6 lg:p-8">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>
{% endblock %}
