{# What every settings page is: a heading, one form that saves the fields that
   page carries, and whatever panels sit under it. A page fills in the three
   blocks, and names in `settingsProblems` each field a save can refuse, so
   the summary at the top links to it; nothing about the chrome is written six
   times. The form and the panels keep to one column, as wide as a field reads
   comfortably, since every field fills the width it is given. #}
{% extends "layouts/shell.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/button.njk" import button %}

{% block title %}{{ settingsLabel }} settings{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">{{ settingsLabel }}</h1>

  {% if hasProblems %}
    <div class="mb-6 max-w-2xl">
      {% call field.summary('Nothing was saved. Fix the fields marked below and try again.') %}
        {% block settingsProblems %}{% endblock %}
      {% endcall %}
    </div>
  {% endif %}

  <form class="flex max-w-2xl flex-col gap-2" method="post" action="{{ settingsUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

    {% block settingsFields %}{% endblock %}

    <div class="mt-4">
      {{ button('Save settings', type='submit', color='primary') }}
    </div>
  </form>

  <div class="mt-10 flex max-w-2xl flex-col gap-6">
    {% block settingsPanels %}{% endblock %}
  </div>
{% endblock %}
