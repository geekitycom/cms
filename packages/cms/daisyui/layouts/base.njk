{# The admin's base layout, the bare page: head, the compiled stylesheet and
   one column. It keeps the blocks of admin/layouts/base.njk, so a screen not
   yet converted to DaisyUI renders inside it unchanged. `dataTheme` is the
   signed-in user's theme; with none, the light and dark defaults follow the
   system. #}
<!doctype html>
<html lang="en"{% if dataTheme %} data-theme="{{ dataTheme }}"{% endif %}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Admin{% endblock %}{% if site.title %} · {{ site.title }}{% endif %}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="{{ assetPrefix }}admin.css" />
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <a class="sr-only focus:not-sr-only" href="#main">Skip to main content</a>
    {% block chrome %}{% endblock %}
    {% block main %}
      <main id="main" class="mx-auto max-w-md p-6">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    {% endblock %}
  </body>
</html>
