{# An alert: `{% call alert(…) %}body{% endcall %}` emits
   `<div role="alert" class="alert">body</div>`. The body is markup.

   Modifiers, each a name from a closed set that maps to DaisyUI classes:

     color      info, success, warning, error
     style      outline, dash, soft
     direction  vertical, horizontal, or responsive (stacked on a phone,
                in a row from `sm` up)

   A value outside its set is a render error.

   `labelledby` names the id of the heading inside the body, so the alert is
   read out under that name. `focus` makes it take focus when the page loads
   (`tabindex="-1"` and `autofocus`, with no script), which a refused form's
   summary needs; only one element on a page should ask for it. #}

{% set COLORS = { info: 'alert-info', success: 'alert-success', warning: 'alert-warning', error: 'alert-error' } %}
{% set STYLES = { outline: 'alert-outline', dash: 'alert-dash', soft: 'alert-soft' } %}
{% set DIRECTIONS = {
  vertical: 'alert-vertical',
  horizontal: 'alert-horizontal',
  responsive: 'alert-vertical sm:alert-horizontal'
} %}

{% macro alert(color=none, style=none, direction=none, labelledby='', focus=false) -%}
<div role="alert"{% if labelledby %} aria-labelledby="{{ labelledby }}"{% endif %}{% if focus %} tabindex="-1" autofocus{% endif %} class="alert{{ COLORS | modifier(color) }}{{ STYLES | modifier(style) }}{{ DIRECTIONS | modifier(direction) }}">{{ caller() }}</div>
{%- endmacro %}
