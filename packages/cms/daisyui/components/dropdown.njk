{# A dropdown: a button that opens its body as a popover.

   `{% call dropdown(id, label, …) %}body{% endcall %}` emits

     <button type="button" class="btn btn-sm" popovertarget="id">label</button>
     <div class="dropdown rounded-box bg-base-100 z-1 w-52 shadow-sm" popover id="id">
       body
     </div>

   The browser opens it and closes it on Escape or a click outside. `id` must
   be unique on the page. The body is markup. The label is escaped.

   No inline `anchor-name` or `position-anchor` styles, which the admin's CSP
   refuses: the button that opens a popover is its implicit anchor.

   The trigger is `button` from `components/button.njk` and takes its
   `color`, `style` and `size` (sm by default). `placement` is start, center,
   end, top, bottom, left or right, each mapping to its `dropdown-*` class. A
   value outside its set is a render error. #}

{% from "components/button.njk" import button %}

{% set PLACEMENTS = {
  start: 'dropdown-start',
  center: 'dropdown-center',
  end: 'dropdown-end',
  top: 'dropdown-top',
  bottom: 'dropdown-bottom',
  left: 'dropdown-left',
  right: 'dropdown-right'
} %}

{% macro dropdown(id, label, color=none, style=none, size='sm', placement=none) -%}
{{ button(label, color=color, style=style, size=size, popovertarget=id) }}
<div class="dropdown rounded-box bg-base-100 z-1 w-52 shadow-sm{{ PLACEMENTS | modifier(placement) }}" popover id="{{ id }}">{{ caller() }}</div>
{%- endmacro %}
