{# /admin/forgot: ask for a link to set a new password.

   The page has three states and one rule. The rule is that a request never
   says whether the name matched: the answer below is the same sentence
   whoever asked and whatever was found, so this form cannot be used to find
   out which accounts a site has. #}
{% extends "layouts/base.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card %}

{% block title %}Forgotten password{% endblock %}

{% block content %}
  {% call card() %}
    <h1 class="card-title text-2xl">Forgotten password</h1>

    {% if not configured %}
      {# No provider and no credential, so there is nothing to send a link
         with. Saying so beats a form that quietly does nothing. #}
      <p>This site cannot send email, so a password cannot be reset from here.</p>
      <p>
        Whoever runs the server can add an account from a shell with
        <code>geekity user add &lt;username&gt;</code>, and sign in with that to
        change anything else. Turning on a mail provider under
        <strong>Settings &rarr; Email</strong> makes this page work.
      </p>
      <p><a class="link" href="{{ loginUrl }}">Back to the login form</a></p>
    {% elif sent %}
      <p>{{ answer }}</p>
      <p><a class="link" href="{{ loginUrl }}">Back to the login form</a></p>
    {% else %}
      <p>Type your username or your email address, and a link to set a new password is sent to the address on your account.</p>

      {% if error %}
        {{ field.summary(error) }}
      {% endif %}

      <form class="flex flex-col gap-2" method="post" action="{{ forgotUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

        {{ field.text('identifier', fields.identifier, 'Username or email address',
             autocomplete='username', required=true, autofocus=true) }}

        <div class="mt-4">
          {{ button('Send a reset link', type='submit', color='primary', shape='block') }}
        </div>
      </form>

      <p class="text-sm"><a class="link" href="{{ loginUrl }}">Back to the login form</a></p>
    {% endif %}
  {% endcall %}
{% endblock %}
