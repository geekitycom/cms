{% extends "layouts/base.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card %}

{% block title %}Set up{% endblock %}

{% block content %}
  {% call card() %}
    <h1 class="card-title text-2xl">Create the first admin</h1>
    <p>Nobody can sign in to this site yet. Pick a username and a password.</p>

    {% if error %}
      {{ field.summary(error) }}
    {% endif %}

    <form class="flex flex-col gap-2" method="post" action="{{ setupUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

      {{ field.text('username', 'username', 'Username', username,
           autocomplete='username', required=true, autofocus=true) }}

      {{ field.password('password', 'password', 'Password',
           autocomplete='new-password', required=true) }}

      {{ field.password('password_confirmation', 'password_confirmation', 'Repeat the password',
           autocomplete='new-password', required=true) }}

      <div class="mt-4">
        {{ button('Create admin', type='submit', color='primary', shape='block') }}
      </div>
    </form>
  {% endcall %}
{% endblock %}
