{# The signed-in admin: a bar across the top, the sections down the left, the
   screen itself in the middle. Every screen behind the login extends this. #}
{% extends "layouts/base.njk" %}

{% block chrome %}
  <header class="admin-bar">
    <a class="admin-bar-site" href="{{ adminUrl }}">{{ site.title }}</a>
    <a href="{{ siteUrl }}">View site</a>
    <span class="admin-bar-spacer"></span>
    {% if user %}
      <span class="admin-bar-user">Signed in as {{ user.username }}</span>
      <form method="post" action="{{ logoutUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <button type="submit">Log out</button>
      </form>
    {% endif %}
  </header>
{% endblock %}

{% block main %}
  <div class="admin-shell">
    <nav class="admin-nav" aria-label="Sections">
      <ul>
        {% for item in navigation %}
          <li>
            <a href="{{ item.url }}"{% if item.section == section %} aria-current="page"{% endif %}>{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <main class="admin-main">
      {% include "layouts/_flash.njk" %}
      {% block content %}{% endblock %}
    </main>
  </div>
{% endblock %}
