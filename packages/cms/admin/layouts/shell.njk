{# The signed-in admin: a bar across the top, the sections down the left, the
   screen itself in the middle. Every screen behind the login extends this. #}
{% extends "layouts/base.njk" %}

{% block chrome %}
  <header class="admin-bar">
    <a class="admin-bar-site" href="{{ adminUrl }}">{{ site.title }}</a>
    <a href="{{ siteUrl }}">View site</a>
    <span class="admin-bar-spacer"></span>
    {% if user %}
      <span class="admin-bar-user">Signed in as {{ user.username }}</span>
      <form method="post" action="{{ logoutUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <button type="submit">Log out</button>
      </form>
    {% endif %}
  </header>
{% endblock %}

{% block main %}
  <div class="admin-shell">
    {# WordPress classic: a section is a heading over its screens. The heading
       goes to the first of them, the open section shows the rest, and the one
       you are on carries aria-current. Nothing here is scripted — the server
       already knows which section is open, so expanding one is a page the
       browser asks for rather than a class JavaScript toggles. #}
    <nav class="admin-nav" aria-label="Sections">
      <ul>
        {% for item in navigation %}
          <li class="admin-nav-section{% if item.open %} admin-nav-open{% endif %}">
            <a class="admin-nav-heading" href="{{ item.url }}">{{ item.label }}</a>
            {% if item.open %}
              <ul class="admin-nav-children">
                {% for entry in item.children %}
                  <li>
                    <a href="{{ entry.url }}"{% if entry.current %} aria-current="page"{% endif %}>{{ entry.label }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <main class="admin-main">
      {% include "components/flash.njk" %}
      {% block content %}{% endblock %}
    </main>
  </div>
{% endblock %}
