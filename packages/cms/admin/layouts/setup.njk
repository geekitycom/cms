{% extends "layouts/base.njk" %}
{% import "layouts/_fields.njk" as field %}

{% block title %}Set up{% endblock %}

{% block content %}
  <h1>Create the first admin</h1>
  <p>Nobody can sign in to this site yet. Pick a username and a password.</p>

  {% if error %}
    <p class="error">{{ error }}</p>
  {% endif %}

  <form method="post" action="{{ setupUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

    {{ field.text('username', 'username', 'Username', username,
         autocomplete='username', required=true, autofocus=true) }}

    {{ field.password('password', 'password', 'Password',
         autocomplete='new-password', required=true) }}

    {{ field.password('password_confirmation', 'password_confirmation', 'Repeat the password',
         autocomplete='new-password', required=true) }}

    <button type="submit">Create admin</button>
  </form>
{% endblock %}
