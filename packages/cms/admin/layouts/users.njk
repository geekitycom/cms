{# /admin/users and /admin/users/new: who can sign in, and how to add one.

   A listing and nothing else (TASK-97). Every field a user has is edited on
   that user's own screen, which the Edit link in each row goes to, so no box
   in this table can be mistaken for another one.

   Two screens out of one template, because Users > Add new is the same chrome
   around one of the two things below: `adding` says which of them the menu
   sent the browser to. #}
{% extends "layouts/shell.njk" %}

{% block title %}{% if adding %}Add new user{% else %}Users{% endif %}{% endblock %}

{% block content %}
{% if not adding %}
  <h1>Users <a class="admin-button admin-button-small" href="{{ addUserUrl }}">Add new</a></h1>

  <table class="admin-list">
    <thead>
      <tr>
        <th scope="col">Username</th>
        <th scope="col">Email</th>
        <th scope="col">Created</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in users %}
        <tr>
          <td>
            <a href="{{ entry.editUrl }}">{{ entry.username }}</a>{% if entry.you %} <span class="admin-status">(you)</span>{% endif %}
            <br /><a href="{{ entry.archiveUrl }}">{{ entry.archiveUrl }}</a>
          </td>
          <td>{% if entry.email %}{{ entry.email }}{% else %}<span class="admin-status">None</span>{% endif %}</td>
          <td>{{ entry.createdAt | date('html') }}</td>
          <td class="admin-actions">
            <a class="admin-button admin-button-small" href="{{ entry.editUrl }}">Edit</a>
            {% if entry.deletable %}
              <form method="post" action="{{ deleteUserUrl }}">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                <input type="hidden" name="{{ fields.userId }}" value="{{ entry.id }}" />
                <button type="submit">Delete</button>
              </form>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

{% else %}
  <h1>Add new user</h1>

  <form class="admin-settings" method="post" action="{{ addUserUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

    {% if addProblems.username or addProblems.password or addProblems.email %}
      <p class="admin-error">Nobody was added. Fix the fields marked below and try again.</p>
    {% endif %}

    <label for="add-username">Username</label>
    <input id="add-username" name="{{ fields.username }}" type="text" value="{{ addForm.username }}" required />
    {% if addProblems.username %}<p class="admin-field-error">{{ addProblems.username }}</p>{% endif %}

    <label for="add-email">Email <span class="admin-status">(optional)</span></label>
    <input id="add-email" name="{{ fields.email }}" type="email" autocomplete="email" value="{{ addForm.email }}" />
    {% if addProblems.email %}<p class="admin-field-error">{{ addProblems.email }}</p>{% endif %}

    <label for="add-password">Password</label>
    <input id="add-password" name="{{ fields.password }}" type="password" autocomplete="new-password" />
    {% if addProblems.password %}<p class="admin-field-error">{{ addProblems.password }}</p>{% endif %}

    <p class="admin-check">
      <input id="add-generate" name="{{ fields.generate }}" type="checkbox" value="1"{% if addForm.generate %} checked{% endif %} />
      <label for="add-generate">Generate one instead, and show it to me once</label>
    </p>
    <p class="admin-hint">A generated password is shown on the next page and nowhere else. Copy it before you leave.</p>

    <p class="admin-settings-buttons">
      <button type="submit">Add user</button>
    </p>
  </form>

  <p class="admin-hint"><a href="{{ usersUrl }}">Back to all users</a></p>
{% endif %}
{% endblock %}
