{# /admin/settings: the values doc-5 lists, stored in SQLite and mirrored to
   content/_data/site.json on every save. #}
{% extends "layouts/shell.njk" %}

{% block title %}Settings{% endblock %}

{% block content %}
  <h1>Settings</h1>

  {% if problems.title or problems.tagline or problems.baseUrl or problems.timezone or problems.postsPerPage or problems.author or problems.actorHandle or problems.actorType or problems.commentsCloseAfterDays or problems.notifyServer or problems.relays or problems.navigation %}
    <p class="admin-error">Nothing was saved. Fix the fields marked below and try again.</p>
  {% endif %}

  <form class="admin-settings" method="post" action="{{ settingsUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

    <h2>Site</h2>

    <label for="settings-title">Title</label>
    <input id="settings-title" name="{{ fields.title }}" type="text" value="{{ form.title }}" required autofocus />
    {% if problems.title %}<p class="admin-field-error">{{ problems.title }}</p>{% endif %}

    <label for="settings-tagline">Tagline</label>
    <input id="settings-tagline" name="{{ fields.tagline }}" type="text" value="{{ form.tagline }}" />
    <p class="admin-hint">One line, shown under the title and used as the feed subtitle.</p>

    <label for="settings-author">Author</label>
    <input id="settings-author" name="{{ fields.author }}" type="text" value="{{ form.author }}" />
    <p class="admin-hint">The name on the feeds.</p>

    <label for="settings-base-url">Base URL</label>
    <input
      id="settings-base-url"
      name="{{ fields.baseUrl }}"
      type="text"
      value="{{ form.baseUrl }}"
      inputmode="url"
      {% if baseUrlOverridden %}readonly disabled{% endif %}
    />
    {% if problems.baseUrl %}<p class="admin-field-error">{{ problems.baseUrl }}</p>{% endif %}
    <p class="admin-hint">
      In effect: <code>{{ baseUrlInEffect }}</code>. {{ baseUrlNote }}
    </p>

    <label for="settings-timezone">Time zone</label>
    <input id="settings-timezone" name="{{ fields.timezone }}" type="text" value="{{ form.timezone }}" required />
    {% if problems.timezone %}<p class="admin-field-error">{{ problems.timezone }}</p>{% endif %}
    <p class="admin-hint">An IANA name, such as <code>Europe/London</code> or <code>UTC</code>.</p>

    <label for="settings-language">Language</label>
    <input id="settings-language" name="{{ fields.language }}" type="text" value="{{ form.language }}" required />
    {% if problems.language %}<p class="admin-field-error">{{ problems.language }}</p>{% endif %}
    <p class="admin-hint">A BCP 47 tag, such as <code>en</code> or <code>en-GB</code>. It is the page's <code>lang</code> and the feeds' language.</p>

    <label for="settings-posts-per-page">Posts per page</label>
    <input id="settings-posts-per-page" name="{{ fields.postsPerPage }}" type="text" inputmode="numeric" value="{{ form.postsPerPage }}" required />
    {% if problems.postsPerPage %}<p class="admin-field-error">{{ problems.postsPerPage }}</p>{% endif %}

    <h2>Navigation</h2>

    <label for="settings-navigation">Menu</label>
    <textarea id="settings-navigation" name="{{ fields.navigation }}" rows="4" spellcheck="false">{{ form.navigation }}</textarea>
    {% if problems.navigation %}<p class="admin-field-error">{{ problems.navigation }}</p>{% endif %}
    <p class="admin-hint">
      One item per line, written <code>Label | URL</code> &mdash; for example
      <code>About | /about/</code> or <code>Mastodon | https://example.social/@me</code>.
      They are the menu in the site header, in this order. A page can put itself
      on the end of it by ticking <em>Show in navigation</em> in the editor.
    </p>

    <h2>Archives</h2>

    <label for="settings-tag-base">Tag base</label>
    <input id="settings-tag-base" name="{{ fields.tagBase }}" type="text" value="{{ form.tagBase }}" required />
    {% if problems.tagBase %}<p class="admin-field-error">{{ problems.tagBase }}</p>{% endif %}
    <p class="admin-hint">The tag archives live at <code>/{{ form.tagBase }}/{tag}/</code>. One path segment, no slashes.</p>

    <label for="settings-category-base">Category base</label>
    <input id="settings-category-base" name="{{ fields.categoryBase }}" type="text" value="{{ form.categoryBase }}" required />
    {% if problems.categoryBase %}<p class="admin-field-error">{{ problems.categoryBase }}</p>{% endif %}
    <p class="admin-hint">The category archives live at <code>/{{ form.categoryBase }}/{name}/</code>.</p>

    <h2>Comments</h2>

    <p class="admin-check">
      <input id="settings-comments" name="{{ fields.comments }}" type="checkbox" value="1"{% if form.comments %} checked{% endif %} />
      <label for="settings-comments">Take comments on this site</label>
    </p>
    <p class="admin-hint">
      Clear this and no post shows a comment form and every submission is
      refused. Fediverse replies keep arriving and keep being shown either way:
      a remote server sends those, and nothing here can stop it.
    </p>

    <label for="settings-comments-close">Close comments after</label>
    <input id="settings-comments-close" name="{{ fields.commentsCloseAfterDays }}" type="number" min="0" step="1" value="{{ form.commentsCloseAfterDays }}" />
    {% if problems.commentsCloseAfterDays %}<p class="admin-field-error">{{ problems.commentsCloseAfterDays }}</p>{% endif %}
    <p class="admin-hint">
      Days after a post's date that it stops taking comments; <code>0</code>
      never closes one. A post overrides this for itself with
      <code>comments: true</code> or <code>comments: false</code>, which the
      editor offers as a field. Pages are closed unless they say otherwise.
    </p>

    <h2>Webmentions</h2>

    <p class="admin-check">
      <input id="settings-webmentions-send" name="{{ fields.webmentionsSend }}" type="checkbox" value="1"{% if form.webmentionsSend %} checked{% endif %} />
      <label for="settings-webmentions-send">Tell the pages a post links to</label>
    </p>
    <p class="admin-hint">
      When a post is published or edited, every external page it links to is
      asked whether it takes webmentions and told about the post if it does.
      The Resend button on the federation screen sends them again.
    </p>

    <p class="admin-check">
      <input id="settings-webmentions-receive" name="{{ fields.webmentionsReceive }}" type="checkbox" value="1"{% if form.webmentionsReceive %} checked{% endif %} />
      <label for="settings-webmentions-receive">Accept webmentions sent here</label>
    </p>
    <p class="admin-hint">
      Every post advertises an endpoint, and a page that links to one and says
      so lands in the comment queue like a comment. Clear this and the endpoint
      is gone from the pages and answers nothing; what has already arrived
      stays where it is.
    </p>

    <h2>Federation</h2>

    <label for="settings-actor-handle">Actor handle</label>
    <input id="settings-actor-handle" name="{{ fields.actorHandle }}" type="text" value="{{ form.actorHandle }}" required />
    {% if problems.actorHandle %}<p class="admin-field-error">{{ problems.actorHandle }}</p>{% endif %}
    <p class="admin-hint">The local part of the site's handle: <code>@{{ form.actorHandle }}@…</code>.</p>

    <label for="settings-actor-type">Actor type</label>
    <select id="settings-actor-type" name="{{ fields.actorType }}">
      {% for type in actorTypes %}
        <option value="{{ type }}"{% if type == form.actorType %} selected{% endif %}>{{ type }}</option>
      {% endfor %}
    </select>
    {% if problems.actorType %}<p class="admin-field-error">{{ problems.actorType }}</p>{% endif %}
    <p class="admin-hint">Some clients hide <code>Service</code> actors from timelines; <code>Person</code> is the safer default.</p>

    <label for="settings-relays">Relays</label>
    <textarea id="settings-relays" name="{{ fields.relays }}" rows="3" spellcheck="false">{{ form.relays }}</textarea>
    {% if problems.relays %}<p class="admin-field-error">{{ problems.relays }}</p>{% endif %}
    <p class="admin-hint">
      One relay inbox per line, such as
      <code>https://tags.pub/user/_____relay_____/inbox</code>. Adding one sends
      it a follow; every public post then goes to it as well as to the
      followers, and it boosts them on to instances nobody here follows. The
      Federation screen says where each subscription stands.
    </p>

    <h2>Notifications</h2>

    <label for="settings-notify-server">Notify server</label>
    <input id="settings-notify-server" name="{{ fields.notifyServer }}" type="text" value="{{ form.notifyServer }}" inputmode="url" />
    {% if problems.notifyServer %}<p class="admin-field-error">{{ problems.notifyServer }}</p>{% endif %}
    <p class="admin-hint">
      An rssCloud and WebSub server, told whenever a feed changes so subscribers
      hear at once instead of waiting for their next poll. Every feed advertises
      it. Leave it empty for none.
    </p>

    <p class="admin-settings-buttons">
      <button type="submit">Save settings</button>
    </p>
  </form>

  {# Akismet is its own pair of forms for the reason the avatar is: the key is
     a credential in data/akismet.json rather than a setting in site.json, and
     a key Akismet will not take must not lose an edit to the title. #}
  <section class="admin-settings admin-akismet-panel">
    <h2>Spam checking</h2>

    <p class="admin-akismet-state admin-akismet-{{ akismetState }}">
      {% if akismetState == 'valid' %}
        <strong>Connected</strong> &mdash; key {{ akismetKeyHint }}, checked {{ akismetCheckedAt }}.
      {% elif akismetState == 'invalid' %}
        <strong>Akismet does not recognise this key</strong> &mdash; key {{ akismetKeyHint }}, checked {{ akismetCheckedAt }}.
      {% elif akismetState == 'unchecked' %}
        <strong>Akismet could not be reached</strong> to check key {{ akismetKeyHint }}.
      {% else %}
        <strong>Not connected</strong> &mdash; this site has no key.
      {% endif %}
    </p>
    <p class="admin-hint">{{ akismetHint }}</p>

    <form method="post" action="{{ akismetUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      <label for="settings-akismet-key">Akismet API key</label>
      <input
        id="settings-akismet-key"
        name="{{ akismetFields.key }}"
        type="password"
        value=""
        autocomplete="off"
        spellcheck="false"
        placeholder="{% if akismetPresent %}Replace the stored key{% else %}Paste your key{% endif %}"
      />
      <p class="admin-settings-buttons">
        <button type="submit">{% if akismetPresent %}Replace key{% else %}Save key{% endif %}</button>
      </p>
    </form>

    {% if akismetPresent %}
      <form method="post" action="{{ akismetUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ akismetFields.action }}" value="{{ akismetRemove }}" />
        <p class="admin-settings-buttons">
          <button type="submit">Remove key</button>
        </p>
      </form>
    {% endif %}

    <p class="admin-hint">
      A key from <a href="https://akismet.com/">akismet.com</a> turns on spam
      checking for native comments and incoming webmentions. It is checked with
      Akismet when it is saved and kept in <code>data/akismet.json</code>, never
      in <code>site.json</code> and never on the public site. Marking something
      spam or not spam on the Comments screen tells Akismet, which is the only
      way it learns. Fediverse replies are never sent to it.
    </p>
  </section>

  {# The avatar is its own pair of forms: a file cannot travel in the
     urlencoded body the settings form posts, and a rejected image must not
     take an edit to the title down with it. #}
  <section class="admin-settings admin-avatar-panel">
    <h2>Avatar</h2>

    <div class="admin-avatar-current">
      {% if avatar %}
        <img class="admin-avatar admin-avatar-large" src="{{ avatar }}" alt="The site's avatar" width="96" height="96" />
      {% else %}
        <span class="admin-avatar admin-avatar-large admin-avatar-blank" aria-hidden="true"></span>
      {% endif %}

      <div class="admin-avatar-forms">
        <form method="post" action="{{ avatarUrl }}" enctype="multipart/form-data">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          <label for="settings-avatar">Image</label>
          <input id="settings-avatar" name="{{ avatarFields.file }}" type="file" accept="image/png,image/jpeg,image/webp,image/gif" required />
          <p class="admin-settings-buttons">
            <button type="submit">Upload avatar</button>
          </p>
        </form>

        {% if avatar %}
          <form method="post" action="{{ avatarUrl }}">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
            <input type="hidden" name="{{ avatarFields.action }}" value="{{ avatarRemove }}" />
            <p class="admin-settings-buttons">
              <button type="submit">Remove avatar</button>
            </p>
          </form>
        {% endif %}
      </div>
    </div>

    <p class="admin-hint">
      A PNG, JPEG, WebP or GIF, stored with the site's other uploads. It is the
      picture on the site's fediverse profile, and saving or removing it tells
      the followers.
    </p>
  </section>
{% endblock %}
