{# The admin's base layout. It lives outside the theme search path on purpose:
   a site's theme/ can override any public template, and must never be able to
   shadow the login form.

   This is the bare page: head, stylesheet and one centred column. Screens that
   need the navigation extend layouts/shell.njk, which extends this and wraps
   the same content block in the admin chrome. Login and setup extend this one
   directly, because a visitor who cannot log in yet has nowhere to navigate. #}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Admin{% endblock %}{% if site.title %} · {{ site.title }}{% endif %}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="{{ assetPrefix }}admin-bar.css" />
    <link rel="stylesheet" href="{{ assetPrefix }}admin.css" />
  </head>
  <body>
    {# First on every screen, so a keyboard gets past the bar and the menu
       in one key. It moves no focus of its own: a refused form's summary
       still takes focus on load (TASK-142). #}
    <a class="admin-skip-link" href="#main">Skip to main content</a>
    {% block chrome %}{% endblock %}
    {% block main %}
      <main id="main" class="admin-plain">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    {% endblock %}
  </body>
</html>
