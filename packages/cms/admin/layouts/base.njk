{# The admin's base layout, the bare page: head, the compiled stylesheet and
   one column. `dataTheme` is the signed-in user's theme; with none, the light
   and dark defaults follow the system. #}
<!doctype html>
<html lang="en"{% if dataTheme %} data-theme="{{ dataTheme }}"{% endif %}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}Admin{% endblock %}{% if site.title %} · {{ site.title }}{% endif %}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="{{ assetPrefix }}admin.css" />
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    {# First on every screen, so a keyboard gets past the bar and the menu in
       one key. Held above the top edge until it has focus, then drawn over
       the fixed admin bar, whose z-index is 99999. #}
    <a class="fixed top-0 left-0 z-[100000] -translate-y-full bg-base-100 p-3 font-semibold focus:translate-y-0" href="#main">Skip to main content</a>
    {% block chrome %}{% endblock %}
    {% block main %}
      <main id="main" class="mx-auto flex min-h-screen max-w-md flex-col justify-center p-6">
        {% include "components/flash.njk" %}
        {% block content %}{% endblock %}
      </main>
    {% endblock %}
  </body>
</html>
