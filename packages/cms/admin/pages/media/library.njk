{# /admin/media: everything under content/uploads as a grid of tiles, each a
   link to its details screen (TASK-429). The directory is walked on every
   request, so a file copied in by hand is here without a restart.

   Everything works with JavaScript switched off: the upload form opens from a
   <details>, the filters are a GET form, and a tile is a link. media.js opens
   a tile's details in a dialog instead and steps through them with the arrow
   keys, and upload-drop.js takes files dropped anywhere on the page. #}
{% extends "layouts/shell.njk" %}
{% from "components/alert.njk" import alert %}
{% from "components/badge.njk" import badge %}
{% from "components/button.njk" import button, buttonLink %}
{% from "components/pagination.njk" import pagination %}
{% from "components/tabs.njk" import tabs %}
{% from "components/upload.njk" import uploadControl %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">{{ heading }}</h1>
    <details class="dropdown">
      <summary class="btn btn-primary btn-sm">Upload</summary>
      <form class="dropdown-content z-10 mt-2 w-80 rounded-box bg-base-100 p-4 shadow sm:w-96" method="post" action="{{ uploadUrl }}" enctype="multipart/form-data">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <div class="fieldset">
          <label class="fieldset-legend" for="media-file">Add a file</label>
          <input id="media-file" name="{{ fields.file }}" type="file" accept="{{ accepts }}" required class="file-input file-input-sm w-full" />
          <p class="label block whitespace-normal">
            This site accepts {{ accepts | replace(',', ', ') }}, up to {{ maxBytes | fileSize }}, or
            {{ mediaMaxBytes | fileSize }} for audio and video. The same rules the editor’s upload
            control enforces.
          </p>
        </div>
        <div class="mt-2">{{ button('Upload', type='submit', color='primary') }}</div>
      </form>
    </details>
    {{ uploadControl('library', 'main', uploadsUrl) }}
  </div>

  {% if sweepNotice %}
    <section id="strip-metadata-notice" class="mb-6 max-w-4xl" aria-label="Location and camera metadata"{% if sweepNotice.sweep %} data-job-status="{{ sweepNotice.sweep.name }}" data-job-state="{{ sweepNotice.sweep.state }}" data-job-label="{{ sweepNotice.sweep.label }}"{% if sweepNotice.sweep.active %} data-job-refresh="{{ sweepNotice.panelUrl }}" data-job-redraw="{{ listUrl }}"{% endif %}{% endif %}>
      {% call alert(color='info', style='soft', direction='responsive', polite=true) %}
        <span data-job-message>
          {% if sweepNotice.sweep and sweepNotice.sweep.active %}
            The sweep that strips location and camera metadata from older uploads is {{ sweepNotice.sweep.label | lower }}.
          {% else %}
            Uploads from before files were cleaned on arrival may still carry location or camera metadata.
          {% endif %}
        </span>
        <div class="flex flex-wrap gap-2">
          {% if not sweepNotice.sweep or not sweepNotice.sweep.active %}
            <form method="post" action="{{ sweepNotice.url }}">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
              {{ button('Strip it now', type='submit') }}
            </form>
          {% endif %}
          {{ buttonLink('Details in Maintenance', sweepNotice.panelUrl, style='ghost') }}
        </div>
      {% endcall %}
    </section>
  {% endif %}

  {% if total == 0 %}
    <p>Nothing has been uploaded yet.</p>
  {% else %}
    <div class="mb-4 flex flex-col gap-3">
      {{ tabs(kindTabs, 'Kinds of file', size='sm') }}
      <form class="flex flex-wrap items-center gap-3" method="get" action="{{ listUrl }}">
        {% if view.kind %}<input type="hidden" name="kind" value="{{ view.kind }}" />{% endif %}
        <label class="sr-only" for="media-search">Search file names and alt text</label>
        <input id="media-search" name="q" type="search" value="{{ view.search }}" placeholder="Search file names and alt text" class="input input-sm w-64" />
        <label class="label text-sm text-base-content">
          <input name="alt" type="checkbox" value="missing" class="checkbox checkbox-sm"{% if view.needsAlt %} checked{% endif %} />
          Needs alt text
        </label>
        <label class="label text-sm text-base-content">
          <input name="unused" type="checkbox" value="1" class="checkbox checkbox-sm"{% if view.unused %} checked{% endif %} />
          Not used anywhere
        </label>
        <label class="sr-only" for="media-sort">Sort</label>
        <select id="media-sort" name="sort" class="select select-sm w-40">
          {% for value, label in sorts %}
            <option value="{{ value }}"{% if value == view.sort %} selected{% endif %}>{{ label }}</option>
          {% endfor %}
        </select>
        {{ button('Filter', type='submit') }}
        {% if filtered %}{{ buttonLink('Clear', clearUrl, style='ghost') }}{% endif %}
      </form>
    </div>

    <p class="mb-3 text-sm">{{ shown }} of {{ total }} {% if total == 1 %}file{% else %}files{% endif %}</p>

    {% if shown == 0 %}
      <p>Nothing matches.</p>
    {% else %}
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
        {% for file in files %}
          <li>
            <a class="block overflow-hidden rounded-box bg-base-100 shadow-sm ring-primary hover:ring-2 focus-visible:ring-2 focus-visible:outline-none" href="{{ file.detailsUrl }}" data-media-tile>
              <span class="relative block aspect-square bg-base-200">
                {% if file.kind == 'image' %}
                  <img class="size-full object-cover" src="{{ file.thumbnailUrl }}" alt="" loading="lazy" />
                {% else %}
                  <span class="flex size-full items-center justify-center text-sm font-bold" aria-hidden="true">{{ file.extension | replace('.', '') | upper }}</span>
                {% endif %}
                {% if file.needsAlt or not file.references.length %}
                  <span class="absolute top-2 left-2 flex flex-col items-start gap-1">
                    {% if file.needsAlt %}{{ badge('No alt text', color='warning') }}{% endif %}
                    {% if not file.references.length %}{{ badge('Unused', color='neutral') }}{% endif %}
                  </span>
                {% endif %}
              </span>
              <span class="block truncate px-2 py-1.5 text-xs">{{ file.name }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>

      <div class="mt-6">
        {{ pagination(page, pages=pages, previousUrl=previousUrl, nextUrl=nextUrl) }}
      </div>
    {% endif %}

    <p class="mt-6 max-w-prose text-sm">
      The library is the <code>content/uploads</code> directory itself, read afresh on every request,
      so a file copied in by hand is here without a restart. Deleting one removes the file and
      whatever was derived from it; it does not touch the documents that link to it, which is why
      a file something still points at asks first.
    </p>
  {% endif %}

  <script defer src="{{ adminAsset('copy.js') }}"></script>
  <script defer src="{{ adminAsset('upload-drop.js') }}"></script>
  <script defer src="{{ adminAsset('media.js') }}"></script>
  <script defer src="{{ adminAsset('job-status.js') }}"></script>
{% endblock %}
