{# /admin/appearance/themes: the theme the site is wearing, everything else on
   disk, and the one button that changes it (decision-15).

   One card per theme. The packaged theme comes first because it is the floor
   the others are laid over rather than a peer in the list: a site theme ships
   what it changes and inherits the rest. The themes directory is read on
   every request, so a theme copied in over ssh or pulled down by git is here
   without a restart. #}
{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import badge, status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">{{ heading }}</h1>

  <ul class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 2xl:grid-cols-3">
    {% for theme in themes %}
      <li>
        {% call card(title=theme.name, style=('border' if theme.active else none)) %}
          <p class="flex flex-wrap items-center gap-2">
            <code>{{ theme.id }}</code>
            {% if theme.active %}
              {{ status('active', 'Active') }}
            {% endif %}
            {% if theme.packaged %}
              {{ badge('the theme this package ships', style='outline') }}
            {% endif %}
          </p>

          {% if theme.description %}
            <p>{{ theme.description }}</p>
          {% endif %}

          {% if not theme.active %}
            <form method="post" action="{{ themesUrl }}">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
              <input type="hidden" name="{{ fields.theme }}" value="{{ theme.value }}" />
              {% call cardActions() %}
                {{ button('Activate', type='submit', color='primary') }}
              {% endcall %}
            </form>
          {% endif %}
        {% endcall %}
      </li>
    {% endfor %}
  </ul>

  {% if unreadable.length %}
    <div class="mb-8 max-w-2xl">
      {% call card(title='Not themes') %}
        <p class="text-sm">
          These are directories in <code class="break-all">{{ themesDir }}</code> that were meant to be themes and
          are not. They are listed rather than skipped, so a typo in a <code>theme.json</code> is
          something you can see rather than a theme that quietly stopped appearing. None of them
          can be activated.
        </p>
        <ul class="list-disc ps-5">
          {% for entry in unreadable %}
            <li class="break-all"><code>{{ entry.id }}</code> — {{ entry.reason }}</li>
          {% endfor %}
        </ul>
      {% endcall %}
    </div>
  {% endif %}

  <p class="max-w-prose text-sm">
    A theme is a directory in <code class="break-all">{{ themesDir }}</code> with a <code>theme.json</code> in it,
    named by that directory. It is laid over the theme this package ships, one file at a time, so
    it need only carry what it changes. Activating one writes the directory name into
    <code>content/_data/site.json</code>; the next request is already wearing it.
  </p>
{% endblock %}
