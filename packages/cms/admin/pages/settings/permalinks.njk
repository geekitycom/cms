{# /admin/settings/permalinks: the URLs the archives and the wiki live at, and
   the ones the archives used to. #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/card.njk" import card %}
{% from "components/table.njk" import table %}

{% block settingsProblems %}
  {{ field.problem('settings-tag-base', problems.tag_base) }}
  {{ field.problem('settings-category-base', problems.category_base) }}
  {{ field.problem('settings-wiki-base', problems.wiki_base) }}
{% endblock %}

{% block settingsFields %}
  {% set tagBaseHint %}The tag archives live at <code>/{{ form.tag_base }}/{tag}/</code>. One path segment, no slashes.{% endset %}
  {{ field.text('settings-tag-base', fields.tag_base, 'Tag base', form.tag_base,
       error=problems.tag_base, hintHtml=tagBaseHint, required=true, autofocus=true) }}

  {% set categoryBaseHint %}The category archives live at <code>/{{ form.category_base }}/{name}/</code>.{% endset %}
  {{ field.text('settings-category-base', fields.category_base, 'Category base', form.category_base,
       error=problems.category_base, hintHtml=categoryBaseHint, required=true) }}

  {% set wikiBaseHint %}The wiki pages live at <code>/{{ form.wiki_base }}/{page}/</code>, and the index of them at <code>/{{ form.wiki_base }}/</code>.{% endset %}
  {{ field.text('settings-wiki-base', fields.wiki_base, 'Wiki base', form.wiki_base,
       error=problems.wiki_base, hintHtml=wikiBaseHint, required=true) }}
{% endblock %}

{% block settingsPanels %}
  {# The recorded renames are a record of what happened rather than a
     preference: the taxonomy screens write them as a term is renamed or merged,
     and this page is where the URLs they are about are decided. #}
  {% call card(title='Archive redirects') %}
    {% if taxonomyRedirects.length %}
      {% call table('Archive redirects', inCard=true) %}
        <thead>
          <tr><th scope="col">Taxonomy</th><th scope="col">Was</th><th scope="col">Is now</th></tr>
        </thead>
        <tbody>
          {% for redirect in taxonomyRedirects %}
            <tr>
              <td>{{ redirect.label }}</td>
              <td><code>{{ redirect.from }}</code></td>
              <td><code>{{ redirect.to }}</code></td>
            </tr>
          {% endfor %}
        </tbody>
      {% endcall %}
      <p class="text-sm">
        Every one of these answers with a permanent redirect to the archive the
        term lives at now, so a link somebody published still arrives.
      </p>
    {% else %}
      <p class="text-sm">
        Nothing has moved yet. Renaming or merging a term on the Tags or
        Categories screen records the archive URL it used to have here, and the
        site answers that URL with a permanent redirect from then on.
      </p>
    {% endif %}
  {% endcall %}
{% endblock %}
