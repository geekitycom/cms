{# /admin/settings/discussion: comments, webmentions, and what checks them. #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}

{# What a retention field says about the period as it stands: kept forever at
   0, removed after so many days otherwise. Nothing for a value the form is
   about to refuse, which has its own error line. #}
{% macro retention(days) %}
  {%- if days == '0' -%}
    <strong>Kept forever.</strong>
  {%- elif days | int > 0 -%}
    <strong>Removed after {{ days }} day{% if days != '1' %}s{% endif %}.</strong>
  {%- endif -%}
{% endmacro %}

{% block settingsProblems %}
  {{ field.problem('settings-comments-close', problems.comments_close_after_days) }}
  {{ field.problem('settings-comment-email-retention', problems.comment_email_retention_days) }}
  {{ field.problem('settings-address-hash-retention', problems.address_hash_retention_days) }}
  {{ field.problem('settings-contact-message-retention', problems.contact_message_retention_days) }}
{% endblock %}

{% block settingsFields %}
  <h2 class="mt-2 text-lg font-semibold">Comments</h2>

  {% set commentsHint %}
    Clear this and nothing shows a comment form and every submission is
    refused. What was already said stays under its post or page. Fediverse replies keep arriving and keep being shown either way:
    a remote server sends those, and nothing here can stop it.
  {% endset %}
  {{ field.checkbox('settings-comments', fields.comments, 'Take comments on this site',
       checked=form.comments, hintHtml=commentsHint) }}

  <fieldset class="fieldset">
    <legend class="fieldset-legend">Take comments by default on</legend>
    {{ field.checkbox('settings-comments-on-posts', fields.comments_on_posts, 'Posts',
         checked=form.comments_on_posts) }}
    {{ field.checkbox('settings-comments-on-pages', fields.comments_on_pages, 'Pages',
         checked=form.comments_on_pages) }}
    <p class="label block whitespace-normal">
      What a document left on "Follow the site settings" in the editor does. A
      document set to Open or Closed there, which writes
      <code>comments: true</code> or <code>comments: false</code> into its
      front matter, overrides this in both directions. Drafts take none, and
      nothing reopens a site with comments switched off above.
    </p>
  </fieldset>

  {% set closeHint %}
    Days after a document's date that it stops taking comments, for posts and
    pages alike; <code>0</code> never closes one. A document with no date,
    which most pages are, never closes, and one set to Open in the editor
    ignores the window.
  {% endset %}
  {{ field.text('settings-comments-close', fields.comments_close_after_days, 'Close comments after',
       form.comments_close_after_days, type='number', min='0', step='1',
       error=problems.comments_close_after_days, hintHtml=closeHint) }}

  <h2 class="mt-6 text-lg font-semibold">Webmentions</h2>

  {% set sendHint %}
    When a post is published or edited, every external page it links to is
    asked whether it takes webmentions and told about the post if it does.
    The Resend button on the federation screen sends them again.
  {% endset %}
  {{ field.checkbox('settings-webmentions-send', fields.webmentions_send,
       'Tell the pages a post links to', checked=form.webmentions_send, hintHtml=sendHint) }}

  {% set receiveHint %}
    Every post advertises an endpoint, and a page that links to one and says
    so lands in the comment queue like a comment. Clear this and the endpoint
    is gone from the pages and answers nothing; what has already arrived
    stays where it is.
  {% endset %}
  {{ field.checkbox('settings-webmentions-receive', fields.webmentions_receive,
       'Accept webmentions sent here', checked=form.webmentions_receive, hintHtml=receiveHint) }}

  <h2 class="mt-6 text-lg font-semibold">Keeping personal data</h2>

  <p class="max-w-prose text-sm">
    How long the site keeps what commenters and people writing through the
    contact form hand it, in days from when it arrived; <code>0</code> keeps
    it forever. A site that has never set these keeps everything, so upgrading
    removes nothing. The recommended periods are 180 days for emails, 30 for
    address hashes and 365 for contact messages, which is what a new site
    starts with. A sweep removes whatever has outlived its period every few
    hours. Tools &rsaquo; Personal data erases one person's data on request.
  </p>

  {% set emailHint %}
    {{ retention(form.comment_email_retention_days) }}
    Past this a comment loses its author's email. The comment, its place in
    the thread and its moderation status stay; the author is no longer told
    about replies, and their next comment waits for a moderator. Recommended:
    <code>180</code>.
  {% endset %}
  {{ field.text('settings-comment-email-retention', fields.comment_email_retention_days,
       'Keep commenter emails for', form.comment_email_retention_days, type='number', min='0',
       step='1', error=problems.comment_email_retention_days, hintHtml=emailHint) }}

  {% set hashHint %}
    {{ retention(form.address_hash_retention_days) }}
    The salted hash of the address a comment, webmention or contact message
    came from, which shows a moderator that two came from one place.
    Recommended: <code>30</code>.
  {% endset %}
  {{ field.text('settings-address-hash-retention', fields.address_hash_retention_days,
       'Keep address hashes for', form.address_hash_retention_days, type='number', min='0',
       step='1', error=problems.address_hash_retention_days, hintHtml=hashHint) }}

  {% set contactHint %}
    {{ retention(form.contact_message_retention_days) }}
    Past this a contact message is deleted from the Messages screen and from
    <code>data/contact/</code>. Recommended: <code>365</code>.
  {% endset %}
  {{ field.text('settings-contact-message-retention', fields.contact_message_retention_days,
       'Keep contact messages for', form.contact_message_retention_days, type='number', min='0',
       step='1', error=problems.contact_message_retention_days, hintHtml=contactHint) }}
{% endblock %}

{% block settingsPanels %}
  {# Akismet is its own pair of forms for the reason the avatar is: the key is
     the secret akismet.key setting in data/akismet.json rather than a setting
     in site.json, and a key Akismet will not take must not lose an edit to the
     fields above. #}
  {% call card(title='Spam checking') %}
    <p>
      {% if akismetState == 'valid' %}
        {{ status('connected', 'Connected') }} Key {{ akismetKeyHint }}, checked {{ akismetCheckedAt }}.
      {% elif akismetState == 'invalid' %}
        {{ status('rejected', 'Not recognised') }} Akismet does not recognise this key: key {{ akismetKeyHint }}, checked {{ akismetCheckedAt }}.
      {% elif akismetState == 'unchecked' %}
        {{ status('unreachable', 'Not checked') }} Akismet could not be reached to check key {{ akismetKeyHint }}.
      {% else %}
        {{ status('disconnected', 'Not connected') }} This site has no key.
      {% endif %}
    </p>
    <p class="text-sm">{{ akismetHint }}</p>

    {% if akismetSetBy %}
      <p class="text-sm">The key is set by <code>{{ akismetSetBy }}</code> and cannot be changed here.</p>
    {% else %}
      <form method="post" action="{{ akismetUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        {% if akismetPresent %}
          {% set akismetPlaceholder = 'Replace the stored key' %}
        {% else %}
          {% set akismetPlaceholder = 'Paste your key' %}
        {% endif %}
        {{ field.password('settings-akismet-key', akismetFields.key, 'Akismet API key',
             autocomplete='off', spellcheck='false', placeholder=akismetPlaceholder) }}
        <div class="mt-2">
          {{ button('Replace key' if akismetPresent else 'Save key', type='submit', color='primary') }}
        </div>
      </form>
    {% endif %}

    {% if akismetPresent %}
      <form method="post" action="{{ akismetUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ akismetFields.action }}" value="{{ akismetVerify }}" />
        <div class="mt-2">{{ button('Check key with Akismet', type='submit') }}</div>
      </form>
    {% endif %}

    <p class="text-sm">
      A key from <a class="link" href="https://akismet.com/">akismet.com</a> turns on spam
      checking for native comments and incoming webmentions. It is checked with
      Akismet when it is saved and kept in <code>data/akismet.json</code>, never
      in <code>site.json</code> and never on the public site. A deployment can
      set it instead with <code>GEEKITY_AKISMET__KEY</code>. Marking something
      spam or not spam on the Comments screen tells Akismet, which is the only
      way it learns. Fediverse replies are never sent to it.
    </p>

    {% if akismetPresent and not akismetSetBy %}
      <form method="post" action="{{ akismetUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ akismetFields.action }}" value="{{ akismetRemove }}" />
        {% call cardActions() %}
          {{ button('Remove key', type='submit', color='error', style='ghost') }}
        {% endcall %}
      </form>
    {% endif %}
  {% endcall %}
{% endblock %}
