{# /admin/settings: what the site is called, where it lives, and its picture. #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/upload.njk" import uploadControl %}

{% block settingsProblems %}
  {{ field.problem('settings-title', problems.title) }}
  {{ field.problem('settings-base-url', problems.base_url) }}
  {{ field.problem('settings-timezone', problems.timezone) }}
  {{ field.problem('settings-language', problems.language) }}
  {{ field.problem('settings-locale', problems.locale) }}
  {{ field.problem('settings-icon', problems.icon) }}
  {{ field.problem('settings-license', problems.license) }}
  {{ field.problem('settings-license-url', problems.license_url) }}
  {{ field.problem('settings-license-name', problems.license_name) }}
{% endblock %}

{% block settingsFields %}
  {{ field.text('settings-title', fields.title, 'Title', form.title,
       error=problems.title, required=true, autofocus=true) }}

  {{ field.text('settings-tagline', fields.tagline, 'Tagline', form.tagline,
       hint='One line, shown under the title and used as the feed subtitle.') }}

  {% set authorHint %}A user makes this their blog: the homepage shows their bio and links, claims their author archive and profiles with <code>rel="me"</code>, and is their IndieAuth sign-in URL. The feeds and the footer credit them by name. Several authors credits the site title instead.{% endset %}
  {% call field.select('settings-author', fields.author, 'Site author', hintHtml=authorHint) %}
    <option value=""{% if not form.author %} selected{% endif %}>Several authors</option>
    {% for choice in authorChoices %}
      <option value="{{ choice.username }}"{% if choice.username == form.author %} selected{% endif %}>{{ choice.name }}</option>
    {% endfor %}
  {% endcall %}

  {% set baseUrlHint %}In effect: <code>{{ baseUrlInEffect }}</code>. {{ baseUrlNote }}{% endset %}
  {{ field.text('settings-base-url', fields.base_url, 'Base URL', form.base_url,
       error=problems.base_url, hintHtml=baseUrlHint, inputmode='url',
       readonly=baseUrlOverridden, disabled=baseUrlOverridden) }}

  {% set timezoneHint %}An IANA name, such as <code>Europe/London</code> or <code>UTC</code>.{% endset %}
  {{ field.text('settings-timezone', fields.timezone, 'Time zone', form.timezone,
       error=problems.timezone, hintHtml=timezoneHint, required=true) }}

  {% set languageHint %}A BCP 47 tag, such as <code>en</code> or <code>en-GB</code>. It is the page's <code>lang</code> and the feeds' language.{% endset %}
  {{ field.text('settings-language', fields.language, 'Language', form.language,
       error=problems.language, hintHtml=languageHint, required=true) }}

  {% set localeHint %}How the public site writes dates and counts, such as <code>en-US</code> for <code>September 2, 2026</code>. Leave it empty to follow the language.{% endset %}
  {{ field.text('settings-locale', fields.locale, 'Locale', form.locale,
       error=problems.locale, hintHtml=localeHint) }}

  {% set iconHint %}A square image at least 512 pixels wide in the media library: a path such as <code>/uploads/2026/10/icon.png</code>. It is the favicon, the home screen icon, <code>/favicon.ico</code> and the web app manifest's icon. Anything not square is cropped to its middle.{% endset %}
  {{ field.text('settings-icon', fields.icon, 'Site icon', form.icon,
       error=problems.icon, hintHtml=iconHint) }}
  {{ uploadControl('field', 'settings-icon', uploadsUrl, images=true) }}
  <script defer src="{{ adminAsset('upload-drop.js') }}"></script>

  <div class="flex items-center gap-4">
    {% if iconPreview %}
      <div class="avatar shrink-0">
        <div class="w-24 rounded-box">
          <img class="object-cover" src="{{ iconPreview }}" alt="The current site icon" width="96" height="96" />
        </div>
      </div>
    {% else %}
      <div class="avatar avatar-placeholder shrink-0" aria-hidden="true">
        <div class="w-24 rounded-box bg-base-300"></div>
      </div>
    {% endif %}
    <p class="text-sm">
      {% if iconUnderived and not imageOptimization %}
        Image optimization is off, so no icons are derived and the site links none.
      {% elif iconUnderived %}
        The site cannot derive icons from <code>{{ iconInEffect }}</code>, so it links none.
      {% elif iconPreview and iconFromAvatar %}
        The current icon, from the <code>avatar</code> in <code>site.json</code>. Saving this page writes it as the icon; clearing the field leaves the avatar in use.
      {% elif iconPreview %}
        The current icon, as a browser tab and a home screen show it.
      {% else %}
        The site has no icon yet, so browsers show their own.
      {% endif %}
    </p>
  </div>

  {{ field.checkbox('settings-header-icon', fields.header_icon,
       'Show the icon before the site title in the header', checked=form.header_icon,
       hint='The default theme shows it at the size of the title on every page, once the site has an icon.') }}

  {% set licenseHint %}What readers may do with your posts. The footer links it, and the structured data and the feeds declare it. A post can name its own with <code>license</code> in its front matter.{% endset %}
  {% call field.select('settings-license', fields.license, 'License', error=problems.license, hintHtml=licenseHint) %}
    <option value=""{% if not form.license %} selected{% endif %}>No license (all rights reserved)</option>
    {% for choice in licenseChoices %}
      <option value="{{ choice.key }}"{% if choice.key == form.license %} selected{% endif %}>{{ choice.name }}</option>
    {% endfor %}
    <option value="custom"{% if form.license == 'custom' %} selected{% endif %}>Custom license</option>
  {% endcall %}

  {{ field.text('settings-license-url', fields.license_url, 'Custom license URL', form.license_url,
       error=problems.license_url, inputmode='url', hint='Where its terms are. Only read for a custom license.') }}

  {{ field.text('settings-license-name', fields.license_name, 'Custom license name', form.license_name,
       error=problems.license_name, hint='What the footer calls it. Only read for a custom license.') }}
{% endblock %}

{% block settingsPanels %}
  {% call card(title='Movies and TV shows') %}
    <p>
      {% if tmdbPresent %}
        {{ status('connected', 'Connected') }} Key {{ tmdbKeyHint }}.
      {% else %}
        {{ status('disconnected', 'Not connected') }} This site has no TMDb key.
      {% endif %}
    </p>

    {% if tmdbSetBy %}
      <p class="text-sm">The key is set by <code>{{ tmdbSetBy }}</code> and cannot be changed here.</p>
    {% else %}
      <form method="post" action="{{ tmdbUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        {{ field.password('settings-tmdb-key', tmdbFields.key, 'TMDb API key',
             autocomplete='off', spellcheck='false',
             placeholder=('Replace the stored key' if tmdbPresent else 'Paste your key')) }}
        <div class="mt-2">
          {{ button('Replace key' if tmdbPresent else 'Save key', type='submit', color='primary') }}
        </div>
      </form>
    {% endif %}

    <p class="text-sm">
      With a key from <a class="link" href="https://www.themoviedb.org/settings/api">themoviedb.org</a>,
      Look up on a review fills in a movie or TV show from its TMDb or IMDb link:
      its title, director or network, year and poster. Either the API key or
      the API read access token works. It is kept in <code>data/tmdb.json</code>,
      never in <code>site.json</code> and never on the public site. A deployment
      can set it instead with <code>GEEKITY_TMDB__KEY</code>. This site uses TMDB
      and the TMDB APIs but is not endorsed, certified or otherwise approved by TMDB.
    </p>

    {% if tmdbPresent and not tmdbSetBy %}
      <form method="post" action="{{ tmdbUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ tmdbFields.action }}" value="{{ tmdbRemove }}" />
        {% call cardActions() %}
          {{ button('Remove key', type='submit', color='error', style='ghost') }}
        {% endcall %}
      </form>
    {% endif %}
  {% endcall %}
{% endblock %}
