{# /admin/settings: what the site is called, where it lives, and its picture. #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}

{% block settingsFields %}
  {{ field.text('settings-title', fields.title, 'Title', form.title,
       error=problems.title, required=true, autofocus=true) }}

  {{ field.text('settings-tagline', fields.tagline, 'Tagline', form.tagline,
       hint='One line, shown under the title and used as the feed subtitle.') }}

  {{ field.text('settings-author', fields.author, 'Author', form.author,
       hint='The name on the feeds.') }}

  {% set baseUrlHint %}In effect: <code>{{ baseUrlInEffect }}</code>. {{ baseUrlNote }}{% endset %}
  {{ field.text('settings-base-url', fields.baseUrl, 'Base URL', form.baseUrl,
       error=problems.baseUrl, hint=baseUrlHint, inputmode='url',
       readonly=baseUrlOverridden, disabled=baseUrlOverridden) }}

  {% set timezoneHint %}An IANA name, such as <code>Europe/London</code> or <code>UTC</code>.{% endset %}
  {{ field.text('settings-timezone', fields.timezone, 'Time zone', form.timezone,
       error=problems.timezone, hint=timezoneHint, required=true) }}

  {% set languageHint %}A BCP 47 tag, such as <code>en</code> or <code>en-GB</code>. It is the page's <code>lang</code> and the feeds' language.{% endset %}
  {{ field.text('settings-language', fields.language, 'Language', form.language,
       error=problems.language, hint=languageHint, required=true) }}
{% endblock %}

{% block settingsPanels %}{% endblock %}
