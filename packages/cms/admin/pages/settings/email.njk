{# /admin/settings/email: how the site sends mail, and where a message written
   to it goes. #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}

{% block settingsFields %}
  {% set providerHint %}
    The key or password each one needs is a credential and is saved below,
    in <code>data/mail.json</code> rather than in <code>site.json</code>.
  {% endset %}
  {% call field.select('settings-mail-provider', fields.mailProvider, 'Provider',
       error=problems.mailProvider, hint=providerHint) %}
    {% for provider in mailProviders %}
      <option value="{{ provider }}"{% if form.mailProvider == provider %} selected{% endif %}>
        {% if provider == 'none' %}None &mdash; this site sends no email{% elif provider == 'brevo' %}Brevo (transactional API){% else %}SMTP{% endif %}
      </option>
    {% endfor %}
  {% endcall %}

  {{ field.text('settings-mail-from-name', fields.mailFromName, 'From name', form.mailFromName,
       hint='The name on the From line. Empty uses the site title.') }}

  {% set fromAddressHint %}
    Providers only send from an address they have verified, so this should be
    one you own. Empty falls back to <code>no-reply@</code> at the site's host.
  {% endset %}
  {{ field.text('settings-mail-from-address', fields.mailFromAddress, 'From address',
       form.mailFromAddress, error=problems.mailFromAddress, hint=fromAddressHint,
       inputmode='email') }}

  {{ field.text('settings-mail-reply-to', fields.mailReplyTo, 'Reply-to', form.mailReplyTo,
       error=problems.mailReplyTo, inputmode='email',
       hint='Where a reply goes. Empty replies to the From address.') }}

  {% set contactHint %}
    Where a message from a page&rsquo;s contact form is sent, with reply-to set to whoever
    wrote it. Empty writes to the first admin with an email address. It is read when a
    message arrives and never appears on the public site.
  {% endset %}
  {{ field.text('settings-contact-email', fields.contactEmail, 'Contact address',
       form.contactEmail, error=problems.contactEmail, hint=contactHint, inputmode='email') }}
{% endblock %}

{% block settingsPanels %}
  {# The mail credential is its own pair of forms for the reason the Akismet
     key is: an API key and an SMTP password belong in data/mail.json, not in
     the public site.json, and a mistyped one must not lose an edit to the
     From line. #}
  <section class="admin-settings admin-mail-panel">
    <h2>Mail credentials</h2>

    <p class="admin-mail-state admin-mail-{{ mailProvider }}">
      {% if mailConfigured %}
        <strong>Configured</strong> &mdash; sending through {{ mailProvider }}.
      {% elif mailProvider == 'none' %}
        <strong>Not sending</strong> &mdash; no provider is chosen.
      {% else %}
        <strong>Not configured</strong> &mdash; {{ mailProvider }} is chosen but has no credential.
      {% endif %}
    </p>
    <p class="admin-hint">{{ mailHint }}</p>

    <form method="post" action="{{ mailUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />

      <h3>Brevo</h3>
      {% if mailBrevoPresent %}
        <p class="admin-hint">A key is stored, ending {{ mailBrevoKeyHint }}.</p>
        {% set brevoPlaceholder = 'Leave blank to keep the stored key' %}
      {% else %}
        {% set brevoPlaceholder = 'Paste your key' %}
      {% endif %}
      {{ field.password('settings-mail-brevo-key', mailFields.brevoApiKey, 'API key',
           autocomplete='off', spellcheck='false', placeholder=brevoPlaceholder) }}

      <h3>SMTP</h3>
      {{ field.text('settings-mail-smtp-host', mailFields.smtpHost, 'Host', mailSmtp.host,
           autocomplete='off') }}

      {{ field.text('settings-mail-smtp-port', mailFields.smtpPort, 'Port',
           mailSmtp.port if mailSmtp else 587, inputmode='numeric') }}

      {# Its own box with the sentence beside it, like every other switch in
         the admin. It used to be a label wrapped round the tick in a class the
         stylesheet has never heard of, so it was the one switch here that
         rendered unstyled. #}
      {{ field.checkbox('settings-mail-smtp-secure', mailFields.smtpSecure,
           'TLS from the first byte (port 465)', checked=mailSmtp.secure,
           hint='Leave this off for port 587, which upgrades with STARTTLS.') }}

      {{ field.text('settings-mail-smtp-user', mailFields.smtpUser, 'Username', mailSmtp.user,
           autocomplete='off') }}

      {% if mailSmtp.hasPassword %}
        {% set smtpPlaceholder = 'Leave blank to keep the stored password' %}
      {% else %}
        {% set smtpPlaceholder = 'The SMTP password' %}
      {% endif %}
      {{ field.password('settings-mail-smtp-password', mailFields.smtpPassword, 'Password',
           autocomplete='off', spellcheck='false', placeholder=smtpPlaceholder) }}

      <p class="admin-settings-buttons">
        <button type="submit">Save credentials</button>
      </p>
    </form>

    {% if mailBrevoPresent or mailSmtpPresent %}
      <form method="post" action="{{ mailUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ mailFields.action }}" value="{{ mailRemove }}" />
        <p class="admin-settings-buttons">
          <button type="submit">Remove credentials</button>
        </p>
      </form>
    {% endif %}

    <form method="post" action="{{ mailTestUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      {{ field.text('settings-mail-test-to', mailTestFields.to, 'Send a test message to', '',
           inputmode='email', placeholder='you@example.com') }}
      <p class="admin-settings-buttons">
        <button type="submit">Send test email</button>
      </p>
    </form>

    <p class="admin-hint">
      Neither the API key nor the SMTP password is ever printed back into this
      page. Both are kept in <code>data/mail.json</code> at mode
      <code>0600</code>, beside the password hashes and the actor's private
      keys, and never in <code>site.json</code>, which is public and in git.
      Leaving a secret blank keeps the one already stored.
    </p>
  </section>
{% endblock %}
