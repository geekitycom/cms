{# /admin/plugins: every installed plugin and where it stands (decision-33).

   Enabling writes the plugins key of content/_data/site.json and takes effect
   on the next request. A plugin's row names each plugin it requires with the
   range it needs, linked to that plugin's row when it is installed, because
   nothing is enabled on the operator's behalf. Under geekity serve, Reload
   appears when the plugins folder differs from what this worker loaded
   (TASK-288). #}
{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/button.njk" import buttonLink %}
{% import "components/fields.njk" as fields %}
{% from "components/table.njk" import table %}

{% block title %}Plugins{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Plugins</h1>

  {% if reloaded %}
    <div role="status" class="alert alert-success mb-6"><span>Plugins reloaded.</span></div>
  {% endif %}

  {% if reloadFailure %}
    <div role="alert" class="alert alert-error mb-6">
      <span>The last reload failed, so this server carried on with the plugins it had. {{ reloadFailure }}</span>
    </div>
  {% endif %}

  {% if reload %}
    <div id="plugins-reload" class="mb-8 max-w-prose">
      {% call card(title="The plugins folder has changed") %}
        <p>Reload starts a new server with the plugins folder as it is now, then retires this one. No request is turned away.{% if reload.watching %} The site also reloads by itself once the folder has stood still for a few seconds.{% endif %}</p>
        <dl class="text-sm">
          {% for heading, names in [["Added", reload.changes.added], ["Removed", reload.changes.removed], ["Updated", reload.changes.updated]] %}
            {% if names.length %}
              <dt class="font-semibold">{{ heading }}:</dt>
              <dd class="mb-2">
                {% for name in names %}<code class="break-all">{{ name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
              </dd>
            {% endif %}
          {% endfor %}
        </dl>
        <form method="post" action="{{ reload.url }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          {% call cardActions() %}
            {{ button('Reload', type='submit', color='primary') }}
          {% endcall %}
        </form>
      {% endcall %}
    </div>
  {% endif %}

  {% if installer == 'on' %}
    <div class="mb-8 grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
      {% call card(title="Add plugin") %}
        <p class="text-sm">
          A plugin runs as the site, with access to everything under <code>data/</code>,
          the accounts and keys and other plugins' secrets. Add only plugins you trust.
        </p>
        {% if addProblems.package or addProblems.password %}
          {% call fields.summary('Nothing was installed. Fix the fields marked below and try again.') %}
            {{ fields.problem('plugin-package', addProblems.package) }}
            {{ fields.problem('plugin-add-password', addProblems.password) }}
          {% endcall %}
        {% endif %}
        <form id="plugin-add" method="post" action="{{ add.url }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          {{ fields.text('plugin-package', 'package', 'Package', value=add.package,
               hint='An npm package name, such as @geekity/plugin-llm.', error=addProblems.package,
               required=true,
               spellcheck='false', autocomplete='off') }}
          {{ fields.text('plugin-version', 'version', 'Version (optional)', value=add.version,
               hint='A version, a range or a dist-tag. Empty takes latest.', spellcheck='false',
               autocomplete='off') }}
          {{ fields.password('plugin-add-password', 'password', 'Your password',
               error=addProblems.password, autocomplete='current-password', required=true) }}
          {% call cardActions() %}
            {{ button('Add plugin', type='submit', color='primary') }}
          {% endcall %}
        </form>
      {% endcall %}

      {% call card(title="Updates") %}
        <p class="text-sm">
          {% if checkedAt %}Last checked {{ checkedAt }}.{% else %}Not checked since this server started.{% endif %}
          Update installs the newest version this site can run.
        </p>
        <form method="post" action="{{ checkUrl }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          {% call cardActions() %}
            {{ button('Check for updates', type='submit') }}
            {% if updateAllUrl %}{{ buttonLink('Update all', updateAllUrl, color='primary') }}{% endif %}
          {% endcall %}
        </form>
      {% endcall %}
    </div>
  {% elif installer == 'off' %}
    <p class="mb-6 max-w-prose text-sm">
      Adding, updating and removing plugins here is turned off on this site
      (<code>GEEKITY_PLUGIN_INSTALL=off</code>). Use <code>geekity plugin</code> on the command line.
    </p>
  {% endif %}

  {% if not plugins.length %}
    <p class="max-w-prose">
      No plugins are installed. A site with its own <code>server.ts</code> passes them in
      <code>plugins</code> on its config.
    </p>
  {% endif %}

  <ul class="mb-8 grid grid-cols-1 gap-6 xl:grid-cols-2">
    {% for plugin in plugins %}
      <li id="{{ plugin.anchor }}">
        {% call card(title=plugin.label) %}
          <p class="flex flex-wrap items-center gap-2">
            <code class="break-all">{{ plugin.name }}</code>
            <span>{{ plugin.version }}</span>
            {{ status(plugin.badge.status, plugin.badge.label) }}
          </p>
          <p>{{ plugin.description }}</p>
          <p class="text-sm">From {{ plugin.source }}.{% if plugin.inCode %} Managed in code: change it in the site's own code, not here.{% endif %}</p>

          {% if plugin.update %}
            <p class="text-sm">{{ plugin.update.to }} is available.</p>
          {% elif plugin.checkNote %}
            <p class="text-sm">{{ plugin.checkNote }}</p>
          {% endif %}

          {% if plugin.problem %}
            <p class="text-sm text-error">{{ plugin.problem }}</p>
          {% endif %}

          {% if plugin.requirements.length %}
            <div class="text-sm">
              <p>Requires:</p>
              <ul class="list-disc ps-5">
                {% for requirement in plugin.requirements %}
                  <li>
                    {% if requirement.satisfied %}
                      <code>{{ requirement.name }}</code> <code>{{ requirement.range }}</code>, which is enabled.
                    {% else %}
                      Needs <code>{{ requirement.name }}</code> <code>{{ requirement.range }}</code>, which is {{ requirement.words }}.
                      {% if requirement.anchor %}
                        <a class="link" href="#{{ requirement.anchor }}">Go to it</a>.
                      {% endif %}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if plugin.canEnable or plugin.canDisable or plugin.update or plugin.removeUrl %}
            <form method="post" action="{{ enableUrl if plugin.canEnable else disableUrl }}">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
              <input type="hidden" name="{{ field }}" value="{{ plugin.name }}" />
              {% call cardActions() %}
                {% if plugin.update %}{{ buttonLink('Update to ' + plugin.update.to, plugin.update.url, color='primary', style='soft') }}{% endif %}
                {% if plugin.removeUrl %}{{ buttonLink('Remove', plugin.removeUrl, color='error', style='ghost') }}{% endif %}
                {% if plugin.canEnable %}
                  {{ button('Enable', type='submit', color='primary') }}
                {% elif plugin.canDisable %}
                  {{ button('Disable', type='submit') }}
                {% endif %}
              {% endcall %}
            </form>
          {% endif %}
        {% endcall %}
      </li>
    {% endfor %}
  </ul>

  {% if changeLog.length %}
    <h2 class="mb-4 text-xl font-bold">Recent changes</h2>
    {% call table('Plugins added, updated and removed here, newest first') %}
      <thead>
        <tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">Plugin</th><th scope="col">Version</th></tr>
      </thead>
      <tbody>
        {% for change in changeLog %}
          <tr>
            <td class="whitespace-nowrap">{{ change.when }}</td>
            <td>{{ change.user }}</td>
            <td>{{ change.action }}</td>
            <td><code class="break-all">{{ change.name }}</code></td>
            <td>{{ change.versions }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {% endcall %}
  {% endif %}
{% endblock %}
