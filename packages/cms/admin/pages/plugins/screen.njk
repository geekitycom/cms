{# /admin/plugins/<package name>: a plugin's own screen (decision-33). The
   plugin hands over cards of paragraphs and tables as data and this draws
   them, so a plugin writes no markup and everything it says is escaped.

   A plugin with settings gets a form here too (TASK-283), drawn by the
   generic settings form over the plugin's settings namespace (TASK-390). #}
{% extends "layouts/shell.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/setting-fields.njk" import settingFields %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/table.njk" import table %}

{% macro text(parts) -%}
  {%- for part in parts -%}
    {%- if part.code is defined -%}<code>{{ part.code }}</code>{%- else -%}{{ part }}{%- endif -%}
  {%- endfor -%}
{%- endmacro %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">{{ title }}</h1>

  {% if problems.length %}
    {% call field.summary('Nothing was saved. Fix the fields marked below.') %}
      {% for setting in problems %}{{ field.problem(setting.id, setting.error) }}{% endfor %}
    {% endcall %}
  {% endif %}

  <div class="grid max-w-5xl grid-cols-1 gap-6">
    {% if settings.length or actions.length %}
      {% call card(title='Settings' if settings.length else 'Actions') %}
        {% if settings.length %}
          <form method="post" action="{{ postUrl }}">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
            <input type="hidden" name="{{ actionField }}" value="{{ saveAction }}" />
            {{ settingFields(settings, secretsFile) }}
            <div class="mt-2">{{ button('Save settings', type='submit', color='primary') }}</div>
          </form>
        {% endif %}

        {% for action in actions %}
          <form method="post" action="{{ postUrl }}">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
            <input type="hidden" name="{{ actionField }}" value="{{ action.id }}" />
            {{ button(action.label, type='submit') }}
          </form>
        {% endfor %}

        {% if settings.length %}
          <p class="text-sm">
            Settings other than secrets are kept in <code>{{ settingsFile }}</code>. Secrets are
            kept in <code>{{ secretsFile }}</code> at mode <code>0600</code> and are never shown here.
          </p>
        {% endif %}
      {% endcall %}
    {% endif %}

    {% for entry in cards %}
      {% call card(title=entry.title) %}
        {% for block in entry.blocks %}
          {% if block.table %}
            {% call table(block.table.caption, inCard=true) %}
              <thead>
                <tr>
                  {% for column in block.table.columns %}<th scope="col">{{ column }}</th>{% endfor %}
                </tr>
              </thead>
              <tbody>
                {% for row in block.table.rows %}
                  <tr>
                    {% for cell in row %}
                      {% if cell.time is defined %}
                        <td class="whitespace-nowrap">{% if cell.time %}{{ cell.time | date('readable') }}{% else %}Never{% endif %}</td>
                      {% else %}
                        <td>{{ text([cell]) }}</td>
                      {% endif %}
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            {% endcall %}
          {% else %}
            <p class="text-sm">{{ text(block.paragraph) }}</p>
          {% endif %}
        {% endfor %}
      {% endcall %}
    {% endfor %}
  </div>
{% endblock %}
