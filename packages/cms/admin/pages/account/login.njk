{% extends "layouts/base.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card %}

{% block title %}Log in{% endblock %}

{% block content %}
  {% call card() %}
    <h1 class="card-title text-2xl">Log in</h1>

    {% if error %}
      {{ field.summary(error) }}
    {% endif %}

    <form class="flex flex-col gap-2" method="post" action="{{ loginUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      {% if returnTo %}
        <input type="hidden" name="return_to" value="{{ returnTo }}" />
      {% endif %}

      {{ field.text('username', 'username', 'Username', username,
           autocomplete='username', required=true, autofocus=true) }}

      {{ field.password('password', 'password', 'Password',
           autocomplete='current-password', required=true) }}

      <div class="mt-4">
        {{ button('Log in', type='submit', color='primary', shape='block') }}
      </div>
    </form>

    <p class="text-sm"><a class="link" href="{{ forgotUrl }}">Forgotten your password?</a></p>
  {% endcall %}
{% endblock %}
