{# /admin/reset: set a new password, for somebody holding a link.

   The token travels from the link's query string into a hidden field, so the
   form posts to a plain URL and the token stays out of the browser's history
   for the POST. Nothing typed here is ever echoed back: both fields are
   passwords. #}
{% extends "layouts/base.njk" %}
{% import "components/fields.njk" as field %}

{% block title %}Set a new password{% endblock %}

{% block content %}
  <h1>Set a new password</h1>

  {% if invalid %}
    <p class="error">That link is no longer valid. A reset link lasts an hour and works once, and asking for a new password again invalidates the old one.</p>
    <p><a href="{{ forgotUrl }}">Ask for another one</a></p>
  {% else %}
    {% if problem %}
      <p class="error">{{ problem }}</p>
    {% endif %}

    <form method="post" action="{{ resetUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      <input type="hidden" name="{{ fields.token }}" value="{{ token }}" />

      {{ field.password('password', fields.password, 'New password',
           autocomplete='new-password', required=true, autofocus=true) }}

      {{ field.password('password_confirmation', fields.passwordConfirmation,
           'Repeat the password', autocomplete='new-password', required=true) }}

      <p class="admin-hint">Every browser signed in as you is signed out, and this link stops working.</p>

      <button type="submit">Set the password</button>
    </form>
  {% endif %}
{% endblock %}
