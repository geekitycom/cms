{# /admin/reset: set a new password, for somebody holding a link.

   The token travels from the link's query string into a hidden field, so the
   form posts to a plain URL and the token stays out of the browser's history
   for the POST. Nothing typed here is ever echoed back: both fields are
   passwords. #}
{% extends "layouts/base.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/alert.njk" import alert %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card %}

{% block title %}Set a new password{% endblock %}

{% block content %}
  {% call card() %}
    <h1 class="card-title text-2xl">Set a new password</h1>

    {% if invalid %}
      {% call alert(color='error') %}
        <span>That link is no longer valid. A reset link lasts an hour and works once, and asking for a new password again invalidates the old one.</span>
      {% endcall %}
      <p><a class="link" href="{{ forgotUrl }}">Ask for another one</a></p>
    {% else %}
      {% if problem %}
        {% call field.summary('The password was not set.') %}
          {{ field.problem('password', problem) }}
        {% endcall %}
      {% endif %}

      <form class="flex flex-col gap-2" method="post" action="{{ resetUrl }}">
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
        <input type="hidden" name="{{ fields.token }}" value="{{ token }}" />

        {{ field.password('password', fields.password, 'New password', error=problem,
             autocomplete='new-password', required=true, autofocus=true) }}

        {{ field.password('password_confirmation', fields.passwordConfirmation,
             'Repeat the password', autocomplete='new-password', required=true) }}

        <p class="text-sm">Every browser signed in as you is signed out, and this link stops working.</p>

        <div class="mt-4">
          {{ button('Set the password', type='submit', color='primary', shape='block') }}
        </div>
      </form>
    {% endif %}
  {% endcall %}
{% endblock %}
