{% extends "layouts/shell.njk" %}
{% from "components/stat.njk" import stats, stat %}
{% from "components/card.njk" import card %}
{% from "components/badge.njk" import badge %}
{% from "components/blocks.njk" import block %}
{% from "components/tabs.njk" import tabs %}
{% from "components/button.njk" import button %}
{% from "components/dropdown.njk" import dropdown %}

{% block title %}Dashboard{% endblock %}

{% macro widgetBody(widget) -%}
  {% if widget.status == 'stale' %}
    <p class="text-sm">{{ badge('Stale', color='warning') }} The latest load failed. These figures are from {{ widget.loadedAt }}.</p>
  {% elif widget.status == 'unavailable' %}
    <p>These stats are unavailable right now.</p>
  {% endif %}
  {% for data in widget.blocks %}{{ block(data) }}{% endfor %}
{%- endmacro %}

{% macro widgetCard(widget, tone=none) -%}
  {% call card(title=widget.title, tone=tone) %}
    {{ widgetBody(widget) }}
  {% endcall %}
{%- endmacro %}

{% macro arrangedCard(widget) -%}
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 class="card-title">{{ widget.title }}</h2>
        <form method="post" action="{{ layoutUrl }}" class="flex shrink-0 items-center gap-1">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          <input type="hidden" name="widget" value="{{ widget.key }}" />
          {% if period %}<input type="hidden" name="period" value="{{ period }}" />{% endif %}
          {% for key in widget.shown %}<input type="hidden" name="shown" value="{{ key }}" />{% endfor %}
          {{ button('↑', type='submit', name='action', value='earlier', style='ghost', size='xs', shape='square', ariaLabel='Move ' + widget.title + ' earlier', disabled=widget.first) }}
          {{ button('↓', type='submit', name='action', value='later', style='ghost', size='xs', shape='square', ariaLabel='Move ' + widget.title + ' later', disabled=widget.last) }}
          {{ button('←', type='submit', name='action', value='left', style='ghost', size='xs', shape='square', ariaLabel='Move ' + widget.title + ' to the left column', hidden=widget.side == 'left') }}
          {{ button('→', type='submit', name='action', value='right', style='ghost', size='xs', shape='square', ariaLabel='Move ' + widget.title + ' to the right column', hidden=widget.side == 'right') }}
          {% if widget.collapsed %}
            {{ button('+', type='submit', name='action', value='expand', style='ghost', size='xs', shape='square', ariaLabel='Expand ' + widget.title) }}
          {% else %}
            {{ button('−', type='submit', name='action', value='collapse', style='ghost', size='xs', shape='square', ariaLabel='Collapse ' + widget.title) }}
          {% endif %}
          {{ button('✕', type='submit', name='action', value='remove', style='ghost', size='xs', shape='square', ariaLabel='Remove ' + widget.title) }}
        </form>
      </div>
      {% if not widget.collapsed %}
        {{ widgetBody(widget) }}
      {% endif %}
    </div>
  </div>
{%- endmacro %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Dashboard</h1>

  {% set glance = [
    { label: 'Published posts', value: counts.posts },
    { label: 'Drafts', value: counts.drafts },
    { label: 'Pages', value: counts.pages },
    { label: 'Wiki pages', value: counts.wiki },
    { label: 'Followers', value: followers, href: federationUrl },
    { label: 'Comments waiting', value: pendingComments, href: commentsUrl + '?status=pending' },
    { label: 'Messages unread', value: unreadMessages, href: messagesUrl }
  ] %}

  <section class="@container mb-8">
    <h2 class="mb-3 text-lg font-semibold">At a glance</h2>
    <div class="grid grid-cols-2 gap-4 @2xl:grid-cols-4 @5xl:grid-cols-7">
      {% for count in glance %}
        {% call stats() %}{{ stat(count.label, count.value, href=count.href) }}{% endcall %}
      {% endfor %}
    </div>
  </section>

  {% for widget in alerts %}
    <section class="mb-8">{{ widgetCard(widget, tone='warning') }}</section>
  {% endfor %}

  {% if arrangeable %}
    <div class="@container">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Activity</h2>
        <div class="flex items-center gap-2">
          {{ tabs(periods, 'Period', size='sm') }}
          {% call dropdown('dashboard-cards', '⚙', style='ghost', placement='end', ariaLabel='Removed cards') %}
            <div class="p-3">
              <p class="mb-2 text-sm font-semibold">Removed cards</p>
              {% if removed.length %}
                <ul class="space-y-2">
                  {% for card in removed %}
                    <li>
                      <form method="post" action="{{ layoutUrl }}" class="flex items-center justify-between gap-2">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                        <input type="hidden" name="widget" value="{{ card.key }}" />
                        {% if period %}<input type="hidden" name="period" value="{{ period }}" />{% endif %}
                        <span class="min-w-0 text-sm">{{ card.title }}</span>
                        {{ button('Add back', type='submit', name='action', value='restore', size='xs', ariaLabel='Add back ' + card.title) }}
                      </form>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <p class="text-sm">No cards are removed.</p>
              {% endif %}
            </div>
          {% endcall %}
        </div>
      </div>
      <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2" data-dashboard-cards data-layout-url="{{ layoutUrl }}">
        {% for column in columns %}
          <div class="flex min-w-0 flex-col gap-6 @3xl:min-h-24" data-dashboard-column="{{ column.side }}">
            {% for widget in column.cards %}
              <div class="min-w-0" data-dashboard-card="{{ widget.key }}">
                {{ arrangedCard(widget) }}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
    <script defer src="{{ adminAsset('dashboard.js') }}"></script>
  {% endif %}
{% endblock %}
