{% extends "layouts/shell.njk" %}
{% from "components/stat.njk" import stats, stat %}
{% from "components/card.njk" import card %}
{% from "components/badge.njk" import badge %}
{% from "components/blocks.njk" import block %}
{% from "components/tabs.njk" import tabs %}

{% block title %}Dashboard{% endblock %}

{% macro widgetCard(widget, tone=none) -%}
  {% call card(title=widget.title, tone=tone) %}
    {% if widget.status == 'stale' %}
      <p class="text-sm">{{ badge('Stale', color='warning') }} The latest load failed. These figures are from {{ widget.loadedAt }}.</p>
    {% elif widget.status == 'unavailable' %}
      <p>These stats are unavailable right now.</p>
    {% endif %}
    {% for data in widget.blocks %}{{ block(data) }}{% endfor %}
  {% endcall %}
{%- endmacro %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Dashboard</h1>

  {% set glance = [
    { label: 'Published posts', value: counts.posts },
    { label: 'Drafts', value: counts.drafts },
    { label: 'Pages', value: counts.pages },
    { label: 'Followers', value: followers, href: federationUrl },
    { label: 'Comments waiting', value: pendingComments, href: commentsUrl + '?status=pending' },
    { label: 'Messages unread', value: unreadMessages, href: messagesUrl }
  ] %}

  <section class="@container mb-8">
    <h2 class="mb-3 text-lg font-semibold">At a glance</h2>
    <div class="grid grid-cols-2 gap-4 @2xl:grid-cols-3 @5xl:grid-cols-6">
      {% for count in glance %}
        {% call stats() %}{{ stat(count.label, count.value, href=count.href) }}{% endcall %}
      {% endfor %}
    </div>
  </section>

  {# Core widgets placed as alerts, such as Needs attention: they draw only
     when something is wrong, and no period applies to them. #}
  {% for widget in alerts %}
    <section class="mb-8">{{ widgetCard(widget, tone='warning') }}</section>
  {% endfor %}

  {# The core's widgets, then each running plugin's (src/admin/widgets.ts). A
     half widget sits beside another once the main area is wide enough; a full
     one spans the row. #}
  {% if widgets.length %}
    <div class="@container">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">Activity</h2>
        {{ tabs(periods, 'Period', size='sm') }}
      </div>
      <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2">
        {% for widget in widgets %}
          <div class="min-w-0{% if widget.width == 'full' %} @3xl:col-span-2{% endif %}">
            {{ widgetCard(widget) }}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endblock %}
