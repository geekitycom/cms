{# /admin/federation/settings: which relays boost the site. It is Federation >
   Settings rather than Settings > Federation (TASK-109): the section holds
   everything about federation, and Followers beside it is where the actors and
   the people following them are. Who the site's people are on the fediverse is
   a user's profile now (decision-14). #}
{% extends "layouts/settings-page.njk" %}
{% import "components/fields.njk" as field %}

{% block settingsProblems %}
  {{ field.problem('settings-relays', problems.relays) }}
{% endblock %}

{% block settingsFields %}
  {% set relaysHint %}
    One relay inbox per line, such as
    <code>https://tags.pub/user/_____relay_____/inbox</code>. Adding one sends
    it a follow; every public post then goes to it as well as to the
    followers, and it boosts them on to instances nobody here follows. The
    Followers screen says where each subscription stands.
  {% endset %}
  {{ field.textarea('settings-relays', fields.relays, 'Relays', form.relays,
       error=problems.relays, hint=relaysHint, rows='3', spellcheck='false', autofocus=true) }}
{% endblock %}
