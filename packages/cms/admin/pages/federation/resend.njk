{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/job-status.njk" import jobStatus %}

{% block title %}Resend{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Resend</h1>

  <section id="resend" class="max-w-2xl" aria-label="Resend" data-job-region>
    {% call card() %}
      <p class="max-w-prose">
        A resend builds each post again from its file and sends it to every one of its
        author's followers and every accepted relay: an update for a published post, a
        withdrawal for one in the trash. It runs in the background. The Resend button on
        a post's row under Federation › Followers resends that one post and also tells
        every page the post links to.
      </p>
      {% if resend %}
        {% call jobStatus(resend, resendUrl, verb='Sent', unit='posts') %}
          {% if resendResult %}
            {% set totals = resendResult.totals %}
            <p>
              Resent {{ resendResult.sent.length }} {% if resendResult.sent.length == 1 %}post{% else %}posts{% endif %}{% if totals.inboxes %} to {{ totals.inboxes }} {% if totals.inboxes == 1 %}inbox{% else %}inboxes{% endif %}: {{ totals.reached }} reached{% if totals.queued %}, {{ totals.queued }} queued{% endif %}{% if totals.failed %}, {{ status('failed', totals.failed + ' failed') }}{% endif %}{% endif %}.
              {% if totals.queued %}Queued deliveries go out in the background; the Delivery table under Federation › Followers shows how they landed.{% endif %}
            </p>
            {% if resendResult.sent.length %}
              <details>
              <summary class="cursor-pointer">Each post</summary>
              <ul class="mt-2 list-disc pl-6">
                {% for post in resendResult.sent %}
                  <li>
                  <code class="break-all">{{ post.slug }}</code>:
                  {% if post.activity and post.activity.heldByDevMode %}
                    dev mode held the {{ post.activity.activityType }}, nothing was sent.
                  {% elif post.activity and post.activity.inboxes == 0 %}
                    the {{ post.activity.activityType }} had no follower or relay to go to.
                  {% elif post.activity %}
                    {{ post.activity.activityType }} reached {{ post.activity.reached }} of {{ post.activity.inboxes }} {% if post.activity.inboxes == 1 %}inbox{% else %}inboxes{% endif %}{% if post.activity.queued %}, {{ post.activity.queued }} queued{% endif %}{% if post.activity.failed %}, {{ status('failed', post.activity.failed + ' failed') }}{% endif %}.
                  {% else %}
                    not announced to the fediverse.
                  {% endif %}
                  {% if post.webmentions %}
                    Webmentions to {{ post.webmentions.pages }} linked {% if post.webmentions.pages == 1 %}page{% else %}pages{% endif %}: {{ post.webmentions.told }} told{% if post.webmentions["none"] %}, {{ post.webmentions["none"] }} take none{% endif %}, {{ post.webmentions.failed }} failed.
                  {% endif %}
                  </li>
                {% endfor %}
              </ul>
              </details>
            {% endif %}
            {% if resendResult.nothing.length %}
              <p>Nothing to resend: {% for slug in resendResult.nothing %}<code class="break-all">{{ slug }}</code>{% if not loop.last %}, {% endif %}{% endfor %}. No announced post has that slug.</p>
            {% endif %}
          {% endif %}
        {% endcall %}
      {% endif %}
      {% if not resend or not resend.active %}
        <form method="post" action="{{ resendAllUrl }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          {% call cardActions() %}
            {{ button('Resend every announced post', type='submit', color='primary') }}
          {% endcall %}
        </form>
      {% endif %}
    {% endcall %}
  </section>
  <script defer src="{{ adminAsset('job-status.js') }}"></script>
{% endblock %}
