{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import badge, status %}
{% from "components/button.njk" import button %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/job-status.njk" import jobStatus %}
{% from "components/table.njk" import table %}

{% block title %}Federation{% endblock %}

{% set AVATAR_SIZES = { large: 'w-24', small: 'w-8' } %}
{% macro avatar(url, size) %}
  {% if url %}
    <div class="avatar shrink-0">
      <div class="rounded-full{{ AVATAR_SIZES | modifier(size) }}">
        <img class="object-cover" src="{{ url }}" alt="" width="{{ 96 if size == 'large' else 32 }}" height="{{ 96 if size == 'large' else 32 }}" loading="lazy" />
      </div>
    </div>
  {% else %}
    <div class="avatar avatar-placeholder shrink-0" aria-hidden="true">
      <div class="rounded-full bg-base-300{{ AVATAR_SIZES | modifier(size) }}"></div>
    </div>
  {% endif %}
{% endmacro %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Federation</h1>

  <div class="mb-10 grid grid-cols-1 gap-6">
    {% for actor in actors %}
      {% call card(title=actor.handle) %}
        <div class="flex items-center gap-4">
          {{ avatar(actor.avatarUrl, 'large') }}
          <p class="text-lg">{{ actor.name }}</p>
        </div>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          <dt>Summary</dt>
          <dd>{{ actor.summary or 'None set.' }}</dd>
          <dt>Actor</dt>
          <dd><a class="link break-all" href="{{ actor.actorId }}">{{ actor.actorId }}</a></dd>
          <dt>Profile</dt>
          <dd><a class="link break-all" href="{{ actor.url }}">{{ actor.url }}</a></dd>
          <dt>Followers</dt>
          <dd>{{ actor.followerCount }}</dd>
        </dl>

        {% if actor.followers.length %}
          {% call table('Followers of ' + actor.handle, inCard=true) %}
            <thead>
              <tr>
                <th scope="col">Follower</th>
                <th scope="col">Handle</th>
                <th scope="col">Followed</th>
              </tr>
            </thead>
            <tbody>
              {% for follower in actor.followers %}
                <tr>
                  <td>
                    <div class="flex items-center gap-2">
                      {{ avatar(follower.iconUrl, 'small') }}
                      <a class="link link-hover" href="{{ follower.url }}">{{ follower.name }}</a>
                    </div>
                  </td>
                  <td>{{ follower.handle }}</td>
                  <td class="whitespace-nowrap">{{ follower.followedAt | date('html') }}</td>
                </tr>
              {% endfor %}
            </tbody>
          {% endcall %}
        {% else %}
          <p>Nobody follows {{ actor.name }} yet.</p>
        {% endif %}
      {% endcall %}
    {% else %}
      {% call card(title='Actors') %}
        <p>The site has no users, so it has no actors.</p>
      {% endcall %}
    {% endfor %}
  </div>

  <section id="failures" class="mb-10" aria-labelledby="failures-heading" data-job-region>
    <h2 id="failures-heading" class="mb-3 text-lg font-semibold">Failed deliveries</h2>
    {% if failures.length %}
      {% call table('Failed deliveries') %}
        <thead>
          <tr>
            <th scope="col">Post</th>
            <th scope="col">Inbox</th>
            <th scope="col">Error</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for failure in failures %}
            <tr>
              <td>
                {% if failure.post %}
                  <a class="link link-hover font-medium" href="{{ failure.post.editUrl }}">{{ failure.post.title }}</a>
                {% elif failure.slug %}
                  <code class="break-all">{{ failure.slug }}</code>
                {% else %}
                  The profile
                {% endif %}
                <p class="text-sm">{{ failure.activityType }} <span class="whitespace-nowrap">{{ failure.attemptedAt | date('html') }}</span></p>
              </td>
              <td class="break-all">{{ failure.inboxId }}</td>
              <td class="break-all text-sm">{{ failure.error or 'No reason given.' }}</td>
              <td>
                {% if failure.slug and not (retry and retry.active) %}
                  <form method="post" action="{{ retryUrl }}">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                    <input type="hidden" name="{{ fields.slug }}" value="{{ failure.slug }}" />
                    <input type="hidden" name="{{ fields.inbox }}" value="{{ failure.inboxId }}" />
                    {{ button('Retry', type='submit', style='outline', size='xs') }}
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {% endcall %}
      <p class="mt-4 max-w-prose text-sm">
        Deliveries from the last seven days that failed and have not reached that
        inbox since. Retry sends the post again, as it now reads, to that inbox
        alone. A failure leaves this list once the post goes to that inbox
        again, or after seven days. If that fails too, the new failure is listed.
      </p>
    {% else %}
      <p>No delivery has failed in the last seven days.</p>
    {% endif %}
    {% if retry %}
      <div class="mt-4">
        {% call jobStatus(retry, federationUrl + '#failures', verb='Retried', unit='posts') %}
          {% if retryResult %}
            {% if retryResult.posts.length %}
              <ul class="list-disc pl-6">
                {% for post in retryResult.posts %}
                  <li>
                    <code class="break-all">{{ post.slug }}</code>:
                    {% if post.activity %}
                      {{ post.activity.activityType }} reached {{ post.activity.reached }} of {{ post.activity.inboxes }} {% if post.activity.inboxes == 1 %}inbox{% else %}inboxes{% endif %}{% if post.activity.queued %}, {{ post.activity.queued }} queued{% endif %}{% if post.activity.failed %}, {{ status('failed', post.activity.failed + ' failed') }}{% endif %}.
                    {% else %}
                      not announced to the fediverse.
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p>The last retry found nothing left to send.</p>
            {% endif %}
          {% endif %}
        {% endcall %}
      </div>
    {% endif %}
  </section>

  <section class="mb-10">
    <h2 class="mb-3 text-lg font-semibold">Relays</h2>
    {% if relays.length %}
      {% call table('Relays') %}
        <thead>
          <tr>
            <th scope="col">Relay</th>
            <th scope="col">State</th>
            <th scope="col">Since</th>
            <th scope="col">Last delivery</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for relay in relays %}
            <tr>
              <td>
                {% if relay.actorId %}
                  <a class="link link-hover" href="{{ relay.actorId }}">{{ relay.inboxId }}</a>
                {% else %}
                  {{ relay.inboxId }}
                {% endif %}
                {% if relay.reason %}
                  <p class="text-sm">{{ relay.reason }}</p>
                {% endif %}
              </td>
              <td>{{ status(relay.state, relay.stateLabel) }}</td>
              <td class="whitespace-nowrap">{{ relay.updatedAt | date('html') }}</td>
              <td>
                {% if relay.lastDelivery %}
                  {{ relay.lastDelivery.activityType }} {{ relay.lastDelivery.status }}
                  <span class="whitespace-nowrap text-sm">{{ relay.lastDelivery.attemptedAt | date('html') }}</span>
                  {% if relay.lastDelivery.error %}
                    <p class="text-sm">{{ relay.lastDelivery.error }}</p>
                  {% endif %}
                {% else %}
                  Nothing yet.
                {% endif %}
              </td>
              <td>
                {% if relay.retriable %}
                  <form method="post" action="{{ relayRetryUrl }}">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                    <input type="hidden" name="{{ fields.relay }}" value="{{ relay.inboxId }}" />
                    {{ button('Retry', type='submit', style='ghost', size='xs') }}
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {% endcall %}
      <p class="mt-4 max-w-prose text-sm">
        A relay boosts every public post it is sent on to instances nobody here
        follows. The list lives on the Settings screen; Retry sends the follow
        again to one that is still waiting.
      </p>
    {% else %}
      <p>The site subscribes to no relay. Add one on the Settings screen.</p>
    {% endif %}
  </section>

  <section class="mb-10">
    <h2 class="mb-3 text-lg font-semibold">Recent activity</h2>
    {% if inbox.length %}
      <ul class="space-y-1">
        {% for entry in inbox %}
          <li>
            <a class="link link-hover font-medium" href="{{ entry.actorId }}">{{ entry.actorLabel }}</a>
            {% if entry.remoteUrl %}
              <a class="link" href="{{ entry.remoteUrl }}">{{ entry.action }}</a>
            {% else %}
              {{ entry.action }}
            {% endif %}
            {% if entry.post %}
              {% if entry.post.inThread %}in the thread on {% endif %}<a class="link" href="{{ entry.post.editUrl }}">{{ entry.post.title }}</a>
            {% else %}
              <em>something of ours</em>
            {% endif %}
            <span class="whitespace-nowrap text-sm">{{ entry.receivedAt | date('html') }}</span>
            {% if entry.via.kind == 'fetched' %}
              {{ badge('fetched', color='info', style='soft') }}
              {% if entry.via.from %}<a class="link text-sm" href="{{ entry.via.from }}">from the replies to the note it answers</a>{% endif %}
            {% elif entry.via.kind == 'delivered' %}
              {{ badge('delivered') }}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>Nothing has arrived yet: no likes, boosts or replies.</p>
    {% endif %}
  </section>

  <section id="resend" class="mb-10 max-w-2xl" aria-labelledby="resend-heading" data-job-region>
    {% call card() %}
      <h2 id="resend-heading" class="card-title">Resend</h2>
      <p class="max-w-prose">
        A resend builds each post again from its file and sends it to every one of its
        author's followers and every accepted relay: an update for a published post, a
        withdrawal for one in the trash. It runs in the background. The Resend button on
        a post's row below also tells every page the post links to.
      </p>
      {% if resend %}
        {% call jobStatus(resend, federationUrl + '#resend', verb='Sent', unit='posts') %}
          {% if resendResult %}
            {% set totals = resendResult.totals %}
            <p>
              Resent {{ resendResult.sent.length }} {% if resendResult.sent.length == 1 %}post{% else %}posts{% endif %}{% if totals.inboxes %} to {{ totals.inboxes }} {% if totals.inboxes == 1 %}inbox{% else %}inboxes{% endif %}: {{ totals.reached }} reached{% if totals.queued %}, {{ totals.queued }} queued{% endif %}{% if totals.failed %}, {{ status('failed', totals.failed + ' failed') }}{% endif %}{% endif %}.
              {% if totals.queued %}Queued deliveries go out in the background; the Delivery table below shows how they landed.{% endif %}
            </p>
            {% if resendResult.sent.length %}
              <details>
              <summary class="cursor-pointer">Each post</summary>
              <ul class="mt-2 list-disc pl-6">
                {% for post in resendResult.sent %}
                  <li>
                  <code class="break-all">{{ post.slug }}</code>:
                  {% if post.activity and post.activity.heldByDevMode %}
                    dev mode held the {{ post.activity.activityType }}, nothing was sent.
                  {% elif post.activity and post.activity.inboxes == 0 %}
                    the {{ post.activity.activityType }} had no follower or relay to go to.
                  {% elif post.activity %}
                    {{ post.activity.activityType }} reached {{ post.activity.reached }} of {{ post.activity.inboxes }} {% if post.activity.inboxes == 1 %}inbox{% else %}inboxes{% endif %}{% if post.activity.queued %}, {{ post.activity.queued }} queued{% endif %}{% if post.activity.failed %}, {{ status('failed', post.activity.failed + ' failed') }}{% endif %}.
                  {% else %}
                    not announced to the fediverse.
                  {% endif %}
                  {% if post.webmentions %}
                    Webmentions to {{ post.webmentions.pages }} linked {% if post.webmentions.pages == 1 %}page{% else %}pages{% endif %}: {{ post.webmentions.told }} told{% if post.webmentions["none"] %}, {{ post.webmentions["none"] }} take none{% endif %}, {{ post.webmentions.failed }} failed.
                  {% endif %}
                  </li>
                {% endfor %}
              </ul>
              </details>
            {% endif %}
            {% if resendResult.nothing.length %}
              <p>Nothing to resend: {% for slug in resendResult.nothing %}<code class="break-all">{{ slug }}</code>{% if not loop.last %}, {% endif %}{% endfor %}. No announced post has that slug.</p>
            {% endif %}
          {% endif %}
        {% endcall %}
      {% endif %}
      {% if not resend or not resend.active %}
        <form method="post" action="{{ resendAllUrl }}">
          <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
          {% call cardActions() %}
            {{ button('Resend every announced post', type='submit', color='primary') }}
          {% endcall %}
        </form>
      {% endif %}
    {% endcall %}
  </section>

  <section id="delivery">
    <h2 class="mb-3 text-lg font-semibold">Delivery</h2>
    {% if posts.length %}
      {% call table('Delivery') %}
        <thead>
          <tr>
            <th scope="col">Post</th>
            <th scope="col">Announced by</th>
            <th scope="col">Last activity</th>
            <th scope="col">Sent</th>
            <th scope="col">Queued</th>
            <th scope="col">Failed</th>
            <th scope="col">Webmentions</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for row in posts %}
            <tr>
              <td>
                <a class="link link-hover font-medium" href="{{ row.post.editUrl }}">{{ row.post.title }}</a>
                {% if row.trashed %}<p class="text-sm">In the trash.</p>{% endif %}
              </td>
              <td>{% if row.author %}@{{ row.author }}{% else %}—{% endif %}</td>
              {% if row.lastActivity %}
                <td>{{ row.lastActivity.activityType }} <span class="whitespace-nowrap text-sm">{{ row.lastActivity.attemptedAt | date('html') }}</span></td>
                <td>{{ row.lastActivity.counts.sent }}{% if row.lastActivity.counts.unknown %}, {{ row.lastActivity.counts.unknown }} outcome unknown{% endif %}</td>
                <td>{{ row.lastActivity.counts.queued }}{% if row.lastActivity.counts.retrying %}, {{ row.lastActivity.counts.retrying }} retrying{% endif %}</td>
                <td class="whitespace-nowrap">{% if row.lastActivity.counts.failed %}{{ status('failed', row.lastActivity.counts.failed + ' failed') }}{% else %}0{% endif %}</td>
              {% else %}
                <td>Nothing recorded.</td>
                <td>—</td>
                <td>—</td>
                <td>—</td>
              {% endif %}
              <td>
                {% if row.webmentions.sent or row.webmentions["none"] or row.webmentions.failed %}
                  {{ row.webmentions.sent }} told{% if row.webmentions["none"] %}, {{ row.webmentions["none"] }} take none{% endif %}{% if row.webmentions.failed %}, {{ status('failed', row.webmentions.failed + ' failed') }}{% endif %}
                {% else %}
                  —
                {% endif %}
                {% if row.syndication.length %}
                  <ul>
                    {% for target in row.syndication %}
                      <li>{{ target.name }}: {% if target.status == "failed" %}{{ status('failed', 'failed') }}{% if target.error %} ({{ target.error }}){% endif %}{% elif target.status == "none" %}takes none{% elif target.status %}sent{% else %}not sent yet{% endif %}{% if target.copy %}, <a class="link" href="{{ target.copy }}">copy</a>{% endif %}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </td>
              <td>
                <form method="post" action="{{ resendUrl }}">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                  <input type="hidden" name="{{ fields.slug }}" value="{{ row.slug }}" />
                  {{ button('Resend', type='submit', style='ghost', size='xs') }}
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {% endcall %}
      <p class="mt-4 max-w-prose text-sm">
        Resend queues a resend of that one post, described above. The outcomes are a
        cache, so a database deleted since leaves the posts listed with nothing
        recorded against them.
      </p>
    {% else %}
      <p>No post has been announced to the fediverse yet.</p>
    {% endif %}
  </section>
  <script defer src="{{ adminAsset('job-status.js') }}"></script>
{% endblock %}
