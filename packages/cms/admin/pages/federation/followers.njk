{# /admin/federation: who this site's people are to the fediverse, who follows
   each of them, what arrived in the inbox, and how what went out landed. #}
{% extends "layouts/shell.njk" %}

{% block title %}Federation{% endblock %}

{% block content %}
  <h1>Federation</h1>

  {% if actors.length %}
    {% for actor in actors %}
      <section class="admin-panel admin-actor">
        <h2>{{ actor.handle }}</h2>
        <div class="admin-actor-identity">
          {% if actor.avatarUrl %}
            <img class="admin-avatar admin-avatar-large" src="{{ actor.avatarUrl }}" alt="" width="96" height="96" />
          {% else %}
            <span class="admin-avatar admin-avatar-large admin-avatar-blank" aria-hidden="true"></span>
          {% endif %}
          <p class="admin-actor-handle">{{ actor.name }}</p>
        </div>
        <dl class="admin-actor-fields">
          <div>
            <dt>Summary</dt>
            <dd>{% if actor.summary %}{{ actor.summary }}{% else %}<span class="admin-empty">None set.</span>{% endif %}</dd>
          </div>
          <div>
            <dt>Actor</dt>
            <dd><a href="{{ actor.actorId }}">{{ actor.actorId }}</a></dd>
          </div>
          <div>
            <dt>Profile</dt>
            <dd><a href="{{ actor.url }}">{{ actor.url }}</a></dd>
          </div>
          <div>
            <dt>Followers</dt>
            <dd>{{ actor.followerCount }}</dd>
          </div>
        </dl>

        {% if actor.followers.length %}
          <table class="admin-list">
            <thead>
              <tr>
                <th scope="col">Follower</th>
                <th scope="col">Handle</th>
                <th scope="col">Followed</th>
              </tr>
            </thead>
            <tbody>
              {% for follower in actor.followers %}
                <tr>
                  <td class="admin-follower">
                    {% if follower.iconUrl %}
                      <img class="admin-avatar" src="{{ follower.iconUrl }}" alt="" width="32" height="32" loading="lazy" />
                    {% else %}
                      <span class="admin-avatar admin-avatar-blank" aria-hidden="true"></span>
                    {% endif %}
                    <a href="{{ follower.url }}">{{ follower.name }}</a>
                  </td>
                  <td>{{ follower.handle }}</td>
                  <td>{{ follower.followedAt | date('html') }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="admin-empty">Nobody follows {{ actor.name }} yet.</p>
        {% endif %}
      </section>
    {% endfor %}
  {% else %}
    <section class="admin-panel admin-actor">
      <h2>Actors</h2>
      <p class="admin-empty">The site has no users, so it has no actors.</p>
    </section>
  {% endif %}

  <section class="admin-panel">
    <h2>Relays</h2>
    {% if relays.length %}
      <table class="admin-list">
        <thead>
          <tr>
            <th scope="col">Relay</th>
            <th scope="col">State</th>
            <th scope="col">Since</th>
            <th scope="col">Last delivery</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for relay in relays %}
            <tr>
              <td>
                {% if relay.actorId %}
                  <a href="{{ relay.actorId }}">{{ relay.inboxId }}</a>
                {% else %}
                  {{ relay.inboxId }}
                {% endif %}
                {% if relay.reason %}
                  <p class="admin-hint">{{ relay.reason }}</p>
                {% endif %}
              </td>
              <td>
                {% if relay.state == 'rejected' %}
                  <span class="admin-status admin-status-failed">{{ relay.stateLabel }}</span>
                {% else %}
                  {{ relay.stateLabel }}
                {% endif %}
              </td>
              <td>{{ relay.updatedAt | date('html') }}</td>
              <td>
                {% if relay.lastDelivery %}
                  {{ relay.lastDelivery.activityType }} {{ relay.lastDelivery.status }}
                  <span class="admin-inbox-when">{{ relay.lastDelivery.attemptedAt | date('html') }}</span>
                  {% if relay.lastDelivery.error %}
                    <p class="admin-hint">{{ relay.lastDelivery.error }}</p>
                  {% endif %}
                {% else %}
                  <span class="admin-empty">Nothing yet.</span>
                {% endif %}
              </td>
              <td class="admin-actions">
                {% if relay.retriable %}
                  <form method="post" action="{{ relayRetryUrl }}">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                    <input type="hidden" name="{{ fields.relay }}" value="{{ relay.inboxId }}" />
                    <button type="submit">Retry</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="admin-hint">
        A relay boosts every public post it is sent on to instances nobody here
        follows. The list lives on the Settings screen; Retry sends the follow
        again to one that is still waiting.
      </p>
    {% else %}
      <p class="admin-empty">The site subscribes to no relay. Add one on the Settings screen.</p>
    {% endif %}
  </section>

  <section class="admin-panel">
    <h2>Recent activity</h2>
    {% if inbox.length %}
      <ul class="admin-inbox">
        {% for entry in inbox %}
          <li>
            <span class="admin-inbox-actor"><a href="{{ entry.actorId }}">{{ entry.actorLabel }}</a></span>
            {% if entry.remoteUrl %}
              <a href="{{ entry.remoteUrl }}">{{ entry.action }}</a>
            {% else %}
              {{ entry.action }}
            {% endif %}
            {% if entry.post %}
              <a href="{{ entry.post.editUrl }}">{{ entry.post.title }}</a>
            {% else %}
              <span class="admin-empty">something of ours</span>
            {% endif %}
            <span class="admin-inbox-when">{{ entry.receivedAt | date('html') }}</span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="admin-empty">Nothing has arrived yet: no likes, boosts or replies.</p>
    {% endif %}
  </section>

  <section class="admin-panel">
    <h2>Delivery</h2>
    {% if posts.length %}
      <table class="admin-list">
        <thead>
          <tr>
            <th scope="col">Post</th>
            <th scope="col">Announced by</th>
            <th scope="col">Last activity</th>
            <th scope="col">Sent</th>
            <th scope="col">Queued</th>
            <th scope="col">Failed</th>
            <th scope="col">Webmentions</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for row in posts %}
            <tr>
              <td>
                <a href="{{ row.post.editUrl }}">{{ row.post.title }}</a>
                {% if row.trashed %}<p class="admin-hint">In the trash.</p>{% endif %}
              </td>
              <td>{% if row.author %}@{{ row.author }}{% else %}<span class="admin-empty">—</span>{% endif %}</td>
              {% if row.lastActivity %}
                <td>{{ row.lastActivity.activityType }} <span class="admin-inbox-when">{{ row.lastActivity.attemptedAt | date('html') }}</span></td>
                <td>{{ row.lastActivity.counts.sent }}</td>
                <td>{{ row.lastActivity.counts.queued }}</td>
                <td>{% if row.lastActivity.counts.failed %}<span class="admin-status admin-status-failed">{{ row.lastActivity.counts.failed }}</span>{% else %}0{% endif %}</td>
              {% else %}
                <td><span class="admin-empty">Nothing recorded.</span></td>
                <td>—</td>
                <td>—</td>
                <td>—</td>
              {% endif %}
              <td>
                {% if row.webmentions.sent or row.webmentions["none"] or row.webmentions.failed %}
                  {{ row.webmentions.sent }} told{% if row.webmentions["none"] %}, {{ row.webmentions["none"] }} take none{% endif %}{% if row.webmentions.failed %}, <span class="admin-status admin-status-failed">{{ row.webmentions.failed }} failed</span>{% endif %}
                {% else %}
                  <span class="admin-empty">—</span>
                {% endif %}
              </td>
              <td class="admin-actions">
                <form method="post" action="{{ resendUrl }}">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                  <input type="hidden" name="{{ fields.slug }}" value="{{ row.slug }}" />
                  <button type="submit">Resend</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="admin-hint">
        Resending builds the post again from its file and sends it to every one
        of its author's followers and every accepted relay the site has now, and tells every
        page the post links to at the same time: an update for a
        published post, a withdrawal for one in the trash. The outcomes are a
        cache, so a database deleted since leaves the posts listed with nothing
        recorded against them.
      </p>
    {% else %}
      <p class="admin-empty">No post has been announced to the fediverse yet.</p>
    {% endif %}
  </section>
{% endblock %}
