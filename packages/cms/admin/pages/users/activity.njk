{# /admin/users/activity: what apps sent to the IndieAuth and Micropub
   endpoints, newest first (TASK-221). A failure is marked in words as well
   as colour, and each row links to the request in full. #}
{% extends "layouts/shell.njk" %}

{% block title %}App activity{% endblock %}

{% block content %}
  <h1>App activity</h1>

  <p class="admin-hint">
    The last requests apps made to sign in with your site and to post to it:
    the authorization and token endpoints, Micropub and its media endpoint.
    When an app will not connect or post, its request is here with the reason
    it was refused. No token, code, password or cookie is kept.
  </p>

  <nav class="admin-filters" aria-label="Which requests">
    <ul>
      {% for tab in tabs %}
        <li>
          <a href="{{ tab.url }}"{% if tab.current %} aria-current="page"{% endif %}>
            {{ tab.label }} ({{ tab.count }})
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  {% if rows | length %}
    <table class="admin-list">
      <caption class="admin-visually-hidden">Recent app requests, newest first</caption>
      <thead>
        <tr>
          <th scope="col">When</th>
          <th scope="col">Endpoint</th>
          <th scope="col">Action</th>
          <th scope="col">App</th>
          <th scope="col">User</th>
          <th scope="col">Result</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td><a href="{{ row.url }}"><time datetime="{{ row.when.iso }}">{{ row.when.text }}</time></a></td>
            <td>{{ row.endpoint }}</td>
            <td>{{ row.action }}</td>
            <td>{{ row.app or "Unknown" }}</td>
            <td>{{ row.user or "Unknown" }}</td>
            <td>
              {% if row.failed %}
                <span class="admin-status admin-status-failed">Refused</span>
                {{ row.status }}{% if row.error %} {{ row.error }}{% endif %}
              {% else %}
                {{ row.status }}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="admin-empty">Nothing here.</p>
  {% endif %}
{% endblock %}
