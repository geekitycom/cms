{# /admin/users/activity: what apps sent to the IndieAuth and Micropub
   endpoints, newest first (TASK-221). A failure is marked in words as well
   as colour, and each row links to the request in full. #}
{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import status %}
{% from "components/table.njk" import table %}
{% from "components/tabs.njk" import tabs as tabsNav %}

{% block title %}App activity{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">App activity</h1>

  <p class="mb-4 max-w-prose text-sm">
    The last requests apps made to sign in with your site and to post to it:
    the authorization and token endpoints, Micropub and its media endpoint.
    When an app will not connect or post, its request is here with the reason
    it was refused. No token, code, password or cookie is kept.
  </p>

  <div class="mb-4 max-w-full overflow-x-auto contain-inline-size">
    {{ tabsNav(tabs, 'Which requests') }}
  </div>

  {% if rows | length %}
    {% call table('Recent app requests, newest first') %}
      <thead>
        <tr>
          <th scope="col">When</th>
          <th scope="col">Endpoint</th>
          <th scope="col">Action</th>
          <th scope="col">App</th>
          <th scope="col">User</th>
          <th scope="col">Result</th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td class="whitespace-nowrap"><a class="link link-hover" href="{{ row.url }}"><time datetime="{{ row.when.iso }}">{{ row.when.text }}</time></a></td>
            <td>{{ row.endpoint }}</td>
            <td>{{ row.action }}</td>
            <td>{{ row.app or "Unknown" }}</td>
            <td>{{ row.user or "Unknown" }}</td>
            <td>
              {% if row.failed %}
                {{ status('failed', 'Refused') }}
                {{ row.status }}{% if row.error %} {{ row.error }}{% endif %}
              {% else %}
                {{ row.status }}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {% endcall %}
  {% else %}
    <p>Nothing here.</p>
  {% endif %}
{% endblock %}
