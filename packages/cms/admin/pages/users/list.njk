{# /admin/users: who can sign in.

   A listing and nothing else (TASK-97). Every field a user has is edited on
   that user's own screen, which the Edit link in each row goes to, so no box
   in this table can be mistaken for another one. Adding somebody is its own
   screen next door, `new.njk`, because Users > Add new is its own menu entry. #}
{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import badge %}
{% from "components/button.njk" import button, buttonLink %}
{% from "components/table.njk" import table %}

{% block title %}Users{% endblock %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <h1 class="text-2xl font-bold">Users</h1>
    {{ buttonLink('Add new', addUserUrl, color='primary') }}
  </div>

  {% call table('Users') %}
    <thead>
      <tr>
        <th scope="col">Username</th>
        <th scope="col">Email</th>
        <th scope="col">Created</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in users %}
        <tr>
          <td><a class="link link-hover font-medium" href="{{ entry.editUrl }}">{{ entry.username }}</a>{% if entry.you %} {{ badge('You') }}{% endif %}</td>
          <td>{{ entry.email or 'None' }}</td>
          <td class="whitespace-nowrap">{{ entry.createdAt | date('html') }}</td>
          {# Edit, then what can be done, then View: the order and the shape
             `pages/documents/list.njk` uses. A row here is a row there. #}
          <td>
            <div class="flex items-center gap-1 whitespace-nowrap">
              {{ buttonLink('Edit', entry.editUrl, style='ghost', size='xs') }}
              {% if entry.deletable %}
                <form method="post" action="{{ deleteUserUrl }}">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                  <input type="hidden" name="{{ fields.userId }}" value="{{ entry.id }}" />
                  {{ button('Delete', type='submit', style='ghost', size='xs') }}
                </form>
              {% endif %}
              {{ buttonLink('View', entry.archiveUrl, style='ghost', size='xs') }}
            </div>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  {% endcall %}
{% endblock %}
