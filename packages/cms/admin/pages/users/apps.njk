{# /admin/users/apps: the apps that can act as whoever is signed in (TASK-162).

   Only your own connections, each with a Revoke button that names the app,
   so a screen reader moving between buttons hears which one it is on. #}
{% extends "layouts/shell.njk" %}
{% import "components/fields.njk" as field %}
{% from "components/alert.njk" import alert %}
{% from "components/badge.njk" import badge, status %}
{% from "components/button.njk" import button %}
{% from "components/table.njk" import table %}

{% block title %}Connected apps{% endblock %}

{# Tailwind finds classes by reading this file, so each one is written out. #}
{% set TOKEN_RESOURCE_SHOWS = {
  micropub: 'group-has-[[name=resource][value=micropub]:checked]/token:grid',
  mcp: 'group-has-[[name=resource][value=mcp]:checked]/token:grid'
} %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">Connected apps</h1>

  {% if connections | length %}
    <p class="mb-4 max-w-prose text-sm">
      These apps signed in as you and can act as you, within the permissions
      listed. An app that keeps using its connection stays connected; one left
      unused is disconnected on the date shown. A token you created works
      until the date shown. Recent activity lists each one's latest sign-ins,
      posts and MCP tool calls; App activity has them all. Revoking disconnects
      it now: its next request is refused, and it has to ask you again.
    </p>

    {% call table('Connected apps') %}
      <thead>
        <tr>
          <th scope="col">App</th>
          <th scope="col">Can</th>
          <th scope="col">Connected</th>
          <th scope="col">Last used</th>
          <th scope="col">Expires</th>
          <th scope="col">Recent activity</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for connection in connections %}
          <tr>
            <td>
              {% if connection.url %}
                <a class="link link-hover font-medium" href="{{ connection.url }}">{{ connection.name }}</a>
              {% else %}
                <span class="font-medium">{{ connection.name }}</span> {{ badge('Token you created') }}
                {% if connection.resource %}{{ badge('For ' ~ connection.resource, color='primary', style='soft') }}{% endif %}
              {% endif %}
            </td>
            <td>
              <ul>
                {% for scope in connection.scopes %}
                  <li>{{ scope }}</li>
                {% else %}
                  <li>Confirm who you are</li>
                {% endfor %}
              </ul>
            </td>
            <td class="whitespace-nowrap"><time datetime="{{ connection.issued.iso }}">{{ connection.issued.text }}</time></td>
            <td class="whitespace-nowrap">
              {% if connection.lastUsed %}
                <time datetime="{{ connection.lastUsed.iso }}">{{ connection.lastUsed.text }}</time>
              {% else %}
                Not yet
              {% endif %}
            </td>
            <td class="whitespace-nowrap"><time datetime="{{ connection.expires.iso }}">{{ connection.expires.text }}</time></td>
            <td>
              {% if connection.recent | length %}
                <ul>
                  {% for entry in connection.recent %}
                    <li class="whitespace-nowrap">
                      <a class="link link-hover" href="{{ entry.url }}">{{ entry.label }}</a>
                      {% if entry.failed %}{{ status('failed', 'Refused') }}{% endif %}
                      <time class="text-xs" datetime="{{ entry.when.iso }}">{{ entry.when.text }}</time>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                None lately
              {% endif %}
            </td>
            <td>
              <form method="post" action="{{ revokeUrl }}">
                <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                <input type="hidden" name="{{ connectionField }}" value="{{ connection.id }}" />
                {{ button('Revoke ' + connection.name, type='submit', style='ghost', size='xs') }}
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {% endcall %}
  {% else %}
    <p>No apps are connected to your account.</p>
    <p class="mt-2 max-w-prose text-sm">
      An app connects here when you sign in to it with your site's address and
      approve what it asks for: a Micropub app such as Quill that posts to
      your site, or an MCP client such as an AI assistant. Each one you approve
      is listed here, with a button to disconnect it.
    </p>
  {% endif %}

  <section class="mt-10 max-w-2xl">
    <h2 id="create-token" class="mb-3 text-lg font-semibold">Create a token</h2>

    {% if createToken.created %}
      <div class="mb-4">
        {% call alert(color='success', style='soft', polite=true) %}
          <div class="w-full">
            {{ field.text('created-token', 'created-token', 'Token for ' ~ createToken.created.name, createToken.created.token,
                 readonly=true, spellcheck='false',
                 hint='Copy it now. It will not be shown again: the site keeps only a fingerprint of it.') }}
          </div>
        {% endcall %}
      </div>
    {% endif %}

    {% if createToken.problems.name or createToken.problems.resource or createToken.problems.scopes or createToken.problems.expires %}
      {% set chosenResource = createToken.resources | selectattr('chosen') | first %}
      {% call field.summary('Nothing was saved. Fix the fields marked below and try again.') %}
        {{ field.problem('create-token-name', createToken.problems.name) }}
        {{ field.problem('create-token-resource', createToken.problems.resource) }}
        {{ field.problem('create-token-scope-' ~ chosenResource.name ~ '-' ~ chosenResource.scopes[0].name, createToken.problems.scopes) }}
        {{ field.problem('create-token-expires', createToken.problems.expires) }}
      {% endcall %}
    {% endif %}

    <p class="mb-2 max-w-prose text-sm">
      Some tools and scripts cannot sign in, but accept a token you paste in.
      A token acts as you on this site's Micropub endpoint or on its MCP
      server, whichever you choose, with only the permissions you tick, until
      it expires or you revoke it above.
    </p>

    <form class="group/token" method="post" action="{{ createToken.url }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      {{ field.text('create-token-name', 'name', 'Name', createToken.name,
           error=createToken.problems.name, required=true,
           hint='What will use it, such as Publishing script.') }}
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Works with</legend>
        <div class="join flex-wrap">
          {% for resource in createToken.resources %}
            <input{% if loop.first %} id="create-token-resource"{% if createToken.problems.resource %} aria-invalid="true" aria-describedby="create-token-resource-error"{% endif %}{% endif %} class="join-item btn btn-sm" type="radio" name="resource" value="{{ resource.name }}" aria-label="{{ resource.label }}"{% if resource.chosen %} checked{% endif %} />
          {% endfor %}
        </div>
        {% if createToken.problems.resource %}
          <p class="text-sm text-error" id="create-token-resource-error">{{ createToken.problems.resource }}</p>
        {% endif %}
      </fieldset>
      {% for resource in createToken.resources %}
        <fieldset class="fieldset hidden{{ TOKEN_RESOURCE_SHOWS | modifier(resource.name) }}">
          <legend class="fieldset-legend">With {{ resource.label }}, it may</legend>
          <p class="label block whitespace-normal">{{ resource.hint }}</p>
          {% for scope in resource.scopes %}
            {{ field.checkbox('create-token-scope-' ~ resource.name ~ '-' ~ scope.name, resource.field, scope.label, checked=scope.checked, value=scope.name,
                 error=(createToken.problems.scopes if loop.first and resource.chosen else '')) }}
          {% endfor %}
        </fieldset>
      {% endfor %}
      {% call field.select('create-token-expires', 'expires', 'Expires after', error=createToken.problems.expires) %}
        {% for expiry in createToken.expiries %}
          <option value="{{ expiry.days }}"{% if expiry.selected %} selected{% endif %}>{% if expiry.days == 365 %}1 year{% else %}{{ expiry.days }} days{% endif %}</option>
        {% endfor %}
      {% endcall %}
      <div class="mt-4">{{ button('Create token', type='submit', color='primary') }}</div>
    </form>
  </section>

  <section class="mt-10">
    <h2 id="without-pkce" class="mb-3 text-lg font-semibold">Apps allowed without PKCE</h2>

    {% if withoutPkce.problem %}
      <div class="max-w-2xl">
        {% call field.summary('Nothing was saved. Fix the field marked below and try again.') %}
          {{ field.problem('without-pkce-client', withoutPkce.problem) }}
        {% endcall %}
      </div>
    {% endif %}

    <p class="mb-4 max-w-prose text-sm">
      PKCE protects a sign-in when somebody intercepts the one-time code an app
      is handed: without the secret the app kept, the code is useless. Every app
      must use it, unless you list it here. List only an app you trust that
      cannot sign in otherwise, such as iA Writer. A listed app is let in without
      PKCE only when it sends you back to an https address on its own host, and
      the consent screen tells you when it is.
    </p>

    {% if withoutPkce.clients | length %}
      {% call table('Apps allowed without PKCE') %}
        <thead>
          <tr>
            <th scope="col">client_id</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for client in withoutPkce.clients %}
            <tr>
              <td><code>{{ client }}</code></td>
              <td>
                <form method="post" action="{{ withoutPkce.removeUrl }}">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                  <input type="hidden" name="{{ withoutPkce.field }}" value="{{ client }}" />
                  {{ button('Remove ' + client, type='submit', style='ghost', size='xs') }}
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {% endcall %}
    {% else %}
      <p>No apps are listed. Every app must use PKCE to sign in.</p>
    {% endif %}

    <form class="mt-4 max-w-2xl" method="post" action="{{ withoutPkce.addUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      {{ field.text('without-pkce-client', withoutPkce.field, labelHtml='App&rsquo;s client_id', value=withoutPkce.value,
           error=withoutPkce.problem, inputmode='url', spellcheck='false', required=true,
           hintHtml='The URL the app names itself by when it signs in, as App activity shows it, such as <code>https://ia.net/writer</code>.') }}
      <div class="mt-4">{{ button('Allow without PKCE', type='submit', color='primary') }}</div>
    </form>
  </section>
{% endblock %}
