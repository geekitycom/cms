{% extends "layouts/base.njk" %}

{% block title %}Something went wrong{% endblock %}

{% block content %}
  {# The page an admin request that threw answers with. It extends the bare
     layout rather than the shell because the shell reads the session, the
     menu and the site, and any of those may be what failed. #}
  <h1>Something went wrong</h1>
  <p>This screen could not be shown because of a problem on the server. The error has been logged. Try again in a moment, or go back to the <a href="{{ adminUrl }}">dashboard</a>.</p>
{% endblock %}
