{# /admin/syndication: the services a post can be sent to, which is
   content/_data/syndicationTargets.json itself.

   One panel per entry the file holds, in file order, the broken ones too:
   an entry that declares nothing says why, so it can be fixed or removed here.
   Each panel saves or removes its own entry, and the Add form at the bottom
   appends one. A file that is not a JSON list is shown with its problem and
   no forms, because saving over it would lose what it holds. #}
{% extends "layouts/shell.njk" %}
{% import "components/fields.njk" as field %}

{% block title %}{{ heading }}{% endblock %}

{# The five boxes of one target, ids prefixed with the panel's key. #}
{% macro boxes(panel, fields) %}
  {{ field.text(panel.key + '-id', fields.id, 'Id', panel.form.id, error=panel.problems.id,
       spellcheck='false', required=true,
       hint='What a post&rsquo;s <code>syndicate-to</code> lists and what Micropub offers as the uid. Letters, digits, <code>.</code>, <code>-</code> and <code>_</code>.') }}
  {{ field.text(panel.key + '-name', fields.name, 'Name', panel.form.name, error=panel.problems.name,
       required=true, hint='What the editor&rsquo;s checkbox and the post&rsquo;s link say.') }}
  {{ field.text(panel.key + '-url', fields.url, 'URL', panel.form.url, error=panel.problems.url,
       inputmode='url', spellcheck='false', required=true,
       hint='The page the post links to and sends its webmention to. Put <code>{lang}</code> where the post&rsquo;s language goes, as in <code>https://news.indieweb.org/{lang}</code>.') }}
  {{ field.text(panel.key + '-tag', fields.tag, 'Tag', panel.form.tag, error=panel.problems.tag,
       spellcheck='false',
       hint='Optional. A post carrying this tag is sent here without listing the target.') }}
  {{ field.text(panel.key + '-languages', fields.languages, 'Languages', panel.form.languages,
       error=panel.problems.languages, spellcheck='false',
       hint='Optional. The language tags this target takes posts in, separated by commas, such as <code>en, de</code>. Empty takes every language.') }}
{% endmacro %}

{% block content %}
  <h1>{{ heading }}</h1>

  {% if hasProblems %}
    {% call field.summary('Nothing was saved. Fix the fields marked below and try again.') %}
      {% for panel in panels.concat([adding]) %}
        {% if panel.key == refusedKey %}
          {{ field.problem(panel.key + '-id', panel.problems.id) }}
          {{ field.problem(panel.key + '-name', panel.problems.name) }}
          {{ field.problem(panel.key + '-url', panel.problems.url) }}
          {{ field.problem(panel.key + '-tag', panel.problems.tag) }}
          {{ field.problem(panel.key + '-languages', panel.problems.languages) }}
        {% endif %}
      {% endfor %}
    {% endcall %}
  {% endif %}

  <p class="admin-hint">
    Services such as IndieNews and Bridgy Publish copy a post when it links to them and sends
    them a webmention. Each target listed here gets a checkbox in the post editor and is offered
    to Micropub clients. They are kept in <code>content/{{ file }}</code>, which this screen reads
    and writes, so the file can still be edited by hand.
  </p>

  {% if fileProblem %}
    <div class="admin-error" role="alert">
      <p>{{ fileProblem }} No target is offered until it is fixed. Fix or remove the file by hand;
        this screen will not save over it, because that would lose what it holds.</p>
    </div>
  {% else %}
    <h2>Targets</h2>

    {% if panels.length %}
      <ul class="admin-menu-boxes">
        {% for panel in panels %}
          <li class="admin-menu-box">
            <h3>{{ panel.form.name or ('Entry ' + (panel.index + 1)) }}</h3>
            {% if panel.fileProblems.length %}
              {% for problem in panel.fileProblems %}
                <p class="admin-field-error">This entry is ignored. {{ problem }}</p>
              {% endfor %}
            {% else %}
              <p class="admin-menu-name"><code>{{ panel.form.id }}</code></p>
            {% endif %}

            <form method="post" action="{{ saveUrl }}">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
              <input type="hidden" name="{{ fields.entry }}" value="{{ panel.index }}" />
              <input type="hidden" name="{{ fields.was }}" value="{{ panel.was }}" />
              {{ boxes(panel, fields) }}
              <p class="admin-menu-buttons">
                <button type="submit">Save target</button>
              </p>
            </form>

            <form class="admin-menu-delete" method="post" action="{{ deleteUrl }}">
              <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
              <input type="hidden" name="{{ fields.entry }}" value="{{ panel.index }}" />
              <input type="hidden" name="{{ fields.was }}" value="{{ panel.was }}" />
              <button type="submit">Remove this target</button>
            </form>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="admin-hint">This site declares no targets, so the editor offers none.</p>
    {% endif %}

    <h2>Add a target</h2>

    <form class="admin-menu-add" method="post" action="{{ addUrl }}">
      <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
      {{ boxes(adding, fields) }}
      <p class="admin-menu-buttons">
        <button type="submit">Add target</button>
      </p>
    </form>
  {% endif %}
{% endblock %}
