{% extends "layouts/shell.njk" %}

{% block title %}New post{% endblock %}

{% block content %}
  <h1 class="mb-6 text-2xl font-bold">What are you posting?</h1>

  <ul class="grid max-w-5xl gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for kind in kinds %}
      <li>
        <a class="card card-sm h-full bg-base-100 shadow-sm transition hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content{% if kind.page %} card-dash{% endif %}" href="{{ kind.url }}">
          <div class="card-body flex-row items-start gap-3">
            <span class="rounded-field bg-primary/10 p-2 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="size-6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ kind.icon }}"/></svg>
            </span>
            <div>
              <h2 class="card-title text-base">{{ kind.label }}</h2>
              <p class="text-sm opacity-70">{{ kind.blurb }}</p>
            </div>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>

  <p class="mt-6 max-w-prose text-sm opacity-70">
    Micropub apps keep posting whatever properties they like. A post with properties from more than
    one kind opens on the kind it reads as, with the rest under Also on this post.
  </p>
{% endblock %}
