{# The editor behind /admin/posts/{slug} and /admin/pages/{slug}, and behind
   .../new. One template for both kinds: `kind` decides whether there is a date
   and the taxonomy fields, and the handler decides which buttons the form
   carries. #}
{% extends "layouts/shell.njk" %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
  <h1>{{ heading }}</h1>

  {% if error %}
    <p class="admin-error">{{ error }}</p>
  {% endif %}

  {% if trashed %}
    <p class="admin-note">This {{ kind.singular }} is in the trash. The public site is not serving it.</p>
  {% endif %}

  {% if scheduledFor %}
    <p class="admin-note">Scheduled for {{ scheduledFor }}. The public site starts serving it then, and the followers are told then.</p>
  {% endif %}

  <form class="admin-editor" method="post" action="{{ saveUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
    {# The hash of the file this form was filled in from. A save whose hash no
       longer matches what is on disk is refused rather than overwriting
       somebody else's edit (doc-1). #}
    <input type="hidden" name="hash" value="{{ form.hash }}" />
    {# Which layout the preview renders through. The save handler ignores it. #}
    <input type="hidden" name="type" value="{{ kind.type }}" />

    <div class="admin-editor-main">
      <label for="editor-title">Title</label>
      <input id="editor-title" name="title" type="text" value="{{ form.title }}" required autofocus />

      <label for="editor-body">Body</label>
      <textarea id="editor-body" name="body" rows="24">{{ form.body }}</textarea>

      {# Everything the editor's own script needs, on the element it hangs off.
         With JavaScript off this is one button that posts the form to the
         preview in a new tab, which is a preview. With it on, editor.js takes
         the button over, puts CodeMirror on the textarea above and adds the
         tabs and the upload control beside it. #}
      <div
        class="admin-editor-tools"
        id="editor-enhance"
        data-preview-url="{{ previewUrl }}"
        data-upload-url="{{ uploadUrl }}"
        data-kind="{{ kind.type }}"
      >
        <button
          type="submit"
          id="editor-preview-fallback"
          class="admin-button-quiet"
          formaction="{{ previewUrl }}"
          formtarget="_blank"
          formnovalidate
        >Preview</button>
      </div>
    </div>

    <div class="admin-editor-side">
      <label for="editor-slug">Slug</label>
      <input id="editor-slug" name="slug" type="text" value="{{ form.slug }}" />

      <label for="editor-permalink">Permalink</label>
      <input id="editor-permalink" name="permalink" type="text" value="{{ form.permalink }}" />
      <p class="admin-hint">Leave it empty to let the {{ kind.singular }} take the URL its slug implies.</p>

      {% if kind.dated %}
        <label for="editor-date">Date</label>
        <input id="editor-date" name="date" type="text" value="{{ form.date }}" />
        {# The file holds a UTC instant; this field is that instant as the
           site's own clock reads it, so the zone has to be on the screen. #}
        <p class="admin-hint">Wall-clock time in {{ dateZone }}. Stored as UTC.</p>
      {% endif %}

      {% if kind.tagged %}
        <label for="editor-tags">Tags</label>
        <input id="editor-tags" name="tags" type="text" value="{{ form.tags }}" />
        <p class="admin-hint">Separated by commas.</p>
      {% endif %}

      {% if kind.categorised %}
        <label for="editor-categories">Categories</label>
        <input id="editor-categories" name="categories" type="text" value="{{ form.categories }}" />
        <p class="admin-hint">Separated by commas.</p>
      {% endif %}

      <label for="editor-description">Description</label>
      <input id="editor-description" name="description" type="text" value="{{ form.description }}" />

      {# Who the front matter says wrote this (TASK-67). A select of the site's
         users rather than a free box, because after decision-14 the value is a
         person rather than a string: it decides whose archive the post is on
         and, once the actors land, whose followers hear about it. A file that
         still names somebody who has no account keeps an option of its own, so
         opening the editor cannot silently reattribute it. #}
      <label for="editor-author">Author</label>
      <select id="editor-author" name="author">
        {% for choice in authors %}
          <option value="{{ choice.value }}"{% if choice.chosen %} selected{% endif %}>{{ choice.label }}</option>
        {% endfor %}
      </select>

      <p class="admin-check">
        <input id="editor-draft" name="draft" type="checkbox" value="1"{% if form.draft %} checked{% endif %} />
        <label for="editor-draft">Draft</label>
      </p>

      {# What this document says about comments, if anything. Three answers
         rather than two: the site's own rules, always open, always closed. #}
      <label for="editor-comments">Comments</label>
      <select id="editor-comments" name="comments">
        <option value="{{ commentSettings.site }}"{% if form.comments == commentSettings.site %} selected{% endif %}>Follow the site settings</option>
        <option value="{{ commentSettings.open }}"{% if form.comments == commentSettings.open %} selected{% endif %}>Open</option>
        <option value="{{ commentSettings.closed }}"{% if form.comments == commentSettings.closed %} selected{% endif %}>Closed</option>
      </select>
      <p class="admin-hint">
        Writes <code>comments: true</code> or <code>comments: false</code> into the front matter,
        which beats the site's switch and its closing window in both directions. Fediverse replies
        are shown either way.
      </p>

      {% if kind.excludable %}
        {# doc-2's eleventyExcludeFromCollections: still published and still at
           its URL, but out of every collection a template lists from. #}
        <p class="admin-check">
          <input id="editor-exclude" name="exclude" type="checkbox" value="1"{% if form.exclude %} checked{% endif %} />
          <label for="editor-exclude">Hide from collections</label>
        </p>
        <p class="admin-hint">Keeps the {{ kind.singular }} out of listings that gather content, without unpublishing it.</p>
      {% endif %}

      {% if kind.navigable %}
        {# The page puts itself in the site menu, after the items the settings
           screen names. #}
        <p class="admin-check">
          <input id="editor-navigation" name="navigation" type="checkbox" value="1"{% if form.navigation %} checked{% endif %} />
          <label for="editor-navigation">Show in navigation</label>
        </p>

        <label for="editor-navigation-order">Menu order</label>
        <input id="editor-navigation-order" name="navigation_order" type="text" inputmode="numeric" value="{{ form.navigationOrder }}" />
        <p class="admin-hint">Puts this {{ kind.singular }} in the site header, after the items on the settings screen. A lower order comes first; leave it empty and it sorts by title after the ordered ones.</p>
      {% endif %}

      {% if kind.contactable %}
        {# The page offers a contact form under its content (TASK-56). Where a
           message goes is the contact address on the Settings screen; it is
           never on this page or in its HTML. #}
        <p class="admin-check">
          <input id="editor-contact" name="contact" type="checkbox" value="1"{% if form.contact %} checked{% endif %} />
          <label for="editor-contact">Contact form</label>
        </p>
        <p class="admin-hint">
          Writes <code>contact: true</code> into the front matter and puts a name, email, subject
          and message form under this {{ kind.singular }}. Messages arrive on the Messages screen
          and are emailed to the contact address on Settings.
        </p>
      {% endif %}

      <p class="admin-editor-buttons">
        {% for button in actions %}
          <button type="submit" name="action" value="{{ button.value }}">{{ button.label }}</button>
        {% endfor %}
        {% if viewUrl %}
          <a class="admin-button admin-button-quiet" href="{{ viewUrl }}">View</a>
        {% endif %}
      </p>
    </div>
  </form>

  {# CodeMirror, the preview tab and the upload control. A module script is
     deferred by definition, so it runs after the form is in the document.
     Nothing above depends on it: with the bundle missing or JavaScript off the
     textarea and the Preview button are the whole editor.

     The nonce is not what lets it run — `script-src 'self'` already does, and
     the admin has no inline script at all. It is here so the bundle can read
     it back off this element and hand it to CodeMirror, whose themes are
     injected as <style> elements at runtime and would otherwise be refused by
     `style-src`. Reading it through the element's `.nonce` property rather
     than a data attribute keeps it out of reach of a CSS selector. #}
  <script
    type="module"
    id="editor-script"
    src="{{ assetPrefix }}editor.js"
    nonce="{{ cspNonce }}"
  ></script>

  {# The slug and permalink auto-fill, in a file of its own so the policy never
     has to allow an inline script. #}
  <script defer src="{{ assetPrefix }}slug.js"></script>
{% endblock %}
