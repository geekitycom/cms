{# The editor behind /admin/posts/{slug} and /admin/pages/{slug}, and behind
   .../new. One template for both types: `kind` decides whether there is a
   date and the taxonomy fields, and the handler decides which buttons the
   form carries. #}
{% extends "layouts/shell.njk" %}

{% block title %}{{ heading }}{% endblock %}

{% import "components/fields.njk" as field %}
{% from "components/alert.njk" import alert %}
{% from "components/badge.njk" import badge %}
{% from "components/button.njk" import button, buttonLink %}
{% from "components/card.njk" import card, cardActions %}
{% from "components/collapse.njk" import collapse %}
{% from "components/dropdown.njk" import dropdown %}
{% from "components/upload.njk" import uploadControl %}

{% set ACTION_COLORS = { 'publish': 'primary', 'update': 'primary', 'trash': 'error' } %}
{% set ACTION_STYLES = { 'trash': 'ghost' } %}
{% set SECTION_TITLES = { photos: 'Photos', link: 'Link', rsvp: 'RSVP', event: 'Event', episode: 'Recording', review: 'Review', checkin: 'Check-in' } %}

{% set ICON_SIZES = { md: 'size-6', sm: 'size-4' } %}

{% macro photoTile(name, url, thumbnail, alt) -%}
<label class="relative cursor-pointer">
  <input class="peer sr-only" type="checkbox" name="{{ name }}" value="{{ url }}" />
  <img class="aspect-square w-full rounded-box object-cover ring-primary ring-offset-2 ring-offset-base-100 peer-checked:ring-2 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-base-content" src="{{ thumbnail }}" alt="{{ alt }}" loading="lazy" />
  <span class="badge badge-primary badge-xs absolute end-1 top-1 hidden peer-checked:inline-flex" aria-hidden="true">✓</span>
</label>
{%- endmacro %}

{% macro icon(path, size='md') -%}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="shrink-0{{ ICON_SIZES | modifier(size) }}" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ path }}"/></svg>
{%- endmacro %}

{% set ITEM_KIND_SHOWS = {
  book: 'group-has-[[name=item-kind][value=book]:checked]/editor:block',
  movie: 'group-has-[[name=item-kind][value=movie]:checked]/editor:block',
  tv: 'group-has-[[name=item-kind][value=tv]:checked]/editor:block',
  album: 'group-has-[[name=item-kind][value=album]:checked]/editor:block',
  place: 'group-has-[[name=item-kind][value=place]:checked]/editor:block',
  other: 'group-has-[[data-as-other]:checked]/editor:block'
} %}

{% set LOOKUP_TONES = { found: 'text-base-content', failed: 'text-error' } %}

{% macro forItemKinds(kinds, id='') -%}
<div class="hidden{% for kind in kinds %}{{ ITEM_KIND_SHOWS | modifier(kind) }}{% endfor %}"{% if id %} id="{{ id }}"{% endif %}>
{%- endmacro %}

{% macro itemWord(key, after='', before='') -%}
{% for kind in reviewKinds %}{% if kind[key] %}<span class="hidden{{ ITEM_KIND_SHOWS | modifier(kind.value) }}">{{ before }}{{ kind[key] }}{{ after }}</span>{% endif %}{% endfor %}
{%- endmacro %}

{% macro invalidIf(id) -%}
{% if errorField == id %} aria-invalid="true" aria-describedby="{{ id }}-error"{% endif %}
{%- endmacro %}

{% macro groupError(id) %}
{% if errorField == id %}
  <p class="text-sm text-error" id="{{ id }}-error">{{ error }}</p>
{% endif %}
{% endmacro %}

{% macro citedCard(property) %}
{% set cited = citedPreviews[property] %}
{% if cited %}
{% call card(size='sm', style='border') %}
  {# First: Tailwind's `peer-*` variants reach later siblings only. #}
  <input class="peer sr-only" type="checkbox" id="editor-preview-{{ property }}" name="preview" value="hide"{% if form.previewHidden %} checked{% endif %}>
  <label class="btn btn-circle btn-xs absolute end-2 top-2 peer-checked:btn-neutral peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-base-content" for="editor-preview-{{ property }}"><span aria-hidden="true">×</span><span class="sr-only">Remove the preview of {{ cited.name }}</span></label>
  <img class="h-auto max-h-32 w-full rounded-box object-cover peer-checked:opacity-40" src="{{ cited.picture.src }}" alt="" width="{{ cited.picture.width }}" height="{{ cited.picture.height }}" loading="lazy">
  <p class="break-words pe-8 peer-checked:opacity-40">{{ cited.name }}</p>
  <p class="label hidden whitespace-normal peer-checked:block">Removed. The post shows the plain citation until you select the X again.</p>
  {% if cited.described %}
  {{ field.text('editor-cited-alt', 'cited-alt', 'Alt text of the reposted image', value=(form.citedAlt or form.title), error=(error if errorField == 'editor-cited-alt' else ''), hint='What the image shows, for readers who cannot see it. It starts as the post’s title.', hintId='editor-cited-alt-hint') }}
  {% endif %}
{% endcall %}
{% endif %}
{% endmacro %}

{% macro pluginActions(fieldId, buttons) %}
{% if buttons %}
<div class="flex flex-col gap-2" data-editor-actions="{{ fieldId }}">
  {% for action in buttons %}
  <div class="flex flex-col items-start gap-1" data-editor-action="{{ action.url }}">
    {{ button(action.label, style='soft', hidden=true) }}
    <p class="text-sm" role="status"></p>
    <div class="flex w-full flex-col gap-2 rounded-box border border-base-300 p-3" role="group" aria-label="{{ action.label }}" hidden>
      <p class="whitespace-pre-wrap break-words"></p>
      <ul class="flex flex-col gap-1" data-editor-choices hidden></ul>
      <template data-editor-choice>
        <li>
          <label class="flex items-start gap-2">
            {% if fieldId == 'editor-tags' %}
            <input type="checkbox" class="checkbox checkbox-sm mt-0.5" form="editor-suggestions">
            {% else %}
            <input type="radio" class="radio radio-sm mt-0.5" name="{{ action.url }}" form="editor-suggestions">
            {% endif %}
            <span class="flex flex-col">
              <span class="flex flex-wrap items-center gap-2">
                <span class="break-all" data-choice-value></span>
                {{ badge('', color='primary', style='soft') }}
              </span>
              <span class="text-sm text-base-content/70" data-choice-note></span>
            </span>
          </label>
        </li>
      </template>
      <template data-editor-choice-group>
        <li class="pt-1 text-sm font-semibold first:pt-0" data-choice-group></li>
      </template>
      <div class="flex gap-2">
        {{ button('Accept', color='primary') }}
        {{ button('Dismiss', style='ghost') }}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro placeFields(checkin) %}
<div>
  {{ button('Use my location', id='editor-location-here', style='soft', hidden=true) }}
</div>
<p id="editor-location-status" class="label block whitespace-normal text-xs" role="status"></p>
{{ field.text('editor-location-name', locationFields.name, 'Place', value=form.location.name, placeholder='A café, a park, a venue') }}
<div class="grid gap-x-4 sm:grid-cols-3">
  {{ field.text('editor-location-locality', locationFields.locality, 'Locality', value=form.location.locality) }}
  {{ field.text('editor-location-region', locationFields.region, 'Region', value=form.location.region) }}
  {{ field.text('editor-location-country', locationFields.country, 'Country', value=form.location.country) }}
</div>
{{ field.text('editor-location-geo', locationFields.geo, 'Coordinates', value=form.location.geo, placeholder='48.85837, 2.29448', autocomplete='off', spellcheck='false', error=(error if errorField == 'editor-location-geo' else ''), hintHtml='Latitude, longitude, as decimal degrees. A <code>geo:</code> URI works too.', hintId='editor-location-geo-hint') }}
{{ field.text('editor-location-accuracy', locationFields.accuracy, 'Accuracy', value=form.location.accuracy, inputmode='numeric', autocomplete='off', error=(error if errorField == 'editor-location-accuracy' else ''), hint='Metres. Leave it empty if you do not know.', hintId='editor-location-accuracy-hint') }}
{% if checkin %}
  <input type="hidden" name="{{ locationFields.checkin }}" value="1" />
{% elif form.location.checkin %}
  {{ field.checkbox('editor-location-checkin', locationFields.checkin, 'A check-in', checked=true, hint='A Micropub app sent it as a check-in, and reads it back as one. Clear it to keep the place as an ordinary location.', hintId='editor-location-checkin-hint') }}
{% endif %}
<p class="label block whitespace-normal text-xs">
  Kept in <code>data/locations.json</code>, not in the post’s file. What readers see of it
  is chosen on Settings &gt; Privacy. Empty every box to remove it.
</p>
{% endmacro %}

{% macro section(name, own) %}
{% if name == 'photos' %}
  <div class="flex min-w-0 flex-col gap-3{% if postKind == 'review' and not sections.filled.photos %} hidden{{ ITEM_KIND_SHOWS | modifier('place') }}{% endif %}">
    {% if own %}<p class="fieldset-legend">{% if postKind == 'review' %}Your photos{% else %}Photos{% endif %}</p>{% endif %}
    {% for row in photos.rows %}
      {% set n = loop.index0 %}
      <div class="flex gap-3 rounded-box border border-base-300 p-3">
        {% if row.thumbnail %}
          <img class="size-20 shrink-0 rounded-box object-cover" src="{{ row.thumbnail }}" alt="" loading="lazy" />
        {% endif %}
        <div class="flex min-w-0 flex-1 flex-col">
          {{ field.text('editor-photo-alt-' + n, photoFields.alt + n, 'Alt text for photo ' + loop.index, value=row.alt, placeholder=(row.libraryAlt or 'Describe what the photo shows'), hint=('Leave it empty to use the media library’s, shown greyed.' if row.libraryAlt else '')) }}
          {{ field.text('editor-photo-url-' + n, photoFields.url + n, 'Address', value=row.url, list='editor-photo-uploads', autocomplete='off', error=(error if errorField == ('editor-photo-url-' + n) else ''), hint='Empty it to take the photo out.') }}
        </div>
      </div>
    {% endfor %}
    <fieldset class="fieldset rounded-box">
      <legend class="fieldset-legend">Add from the media library</legend>
      <div class="grid grid-cols-3 gap-2 sm:grid-cols-6" id="editor-photo-picks">
        {% for pick in photos.picks %}
          {{ photoTile(photoFields.url + pick.index, pick.url, pick.thumbnail, pick.alt or pick.url) }}
        {% endfor %}
      </div>
      <template data-upload-tile="editor-photo-picks">{{ photoTile('', '', '', '') }}</template>
      {% if not photos.picks | length %}
        <p class="text-sm" data-upload-empty>The media library has no images yet.</p>
      {% endif %}
      {{ uploadControl('photos', 'editor-photo-picks', uploadsUrl, images=true, name=photoFields.url) }}
      <p class="label block whitespace-normal">A ticked photo is added when you save, with the media library’s alt text. Add them now to write alt text of your own first.</p>
      <div{% if not photos.picks | length %} hidden data-upload-reveal{% endif %}>{{ button('Add the ticked photos', type='submit', name='switch-kind', value=postKind, style='soft', formnovalidate=true) }}</div>
    </fieldset>
    <div class="grid gap-x-4 sm:grid-cols-2">
      {{ field.text('editor-photo-url-' + photos.blank, photoFields.url + photos.blank, 'Or a web address', value='', list='editor-photo-uploads', autocomplete='off', error=(error if errorField == ('editor-photo-url-' + photos.blank) else '')) }}
      {{ field.text('editor-photo-alt-' + photos.blank, photoFields.alt + photos.blank, 'Its alt text', value='') }}
    </div>
  </div>

{% elif name == 'link' %}
  <fieldset class="fieldset">
    <legend class="fieldset-legend">This post</legend>
    <div class="join flex-wrap">
      {% for verb in link.verbs %}
        <input class="join-item btn btn-sm" type="radio" name="link-verb" value="{{ verb.property }}" aria-label="{{ verb.label }}"{% if verb.property == link.chosen %} checked{% endif %} />
      {% endfor %}
    </div>
  </fieldset>
  {{ field.text('editor-' + link.chosen, 'link-url', 'Address', value=link.url, type='url', error=(error if errorField == ('editor-' + link.chosen) else ''), hint='The page is fetched for its title and picture, and sent a webmention when you publish. Leave it empty for a post that cites nothing.') }}
  {{ citedCard(link.chosen) }}
  {% for other in link.others %}
    {{ field.text('editor-' + other.property, other.property, other.also, value=other.url, type='url', error=(error if errorField == ('editor-' + other.property) else ''), hint='Empty it to take it out.') }}
    {{ citedCard(other.property) }}
  {% endfor %}

{% elif name == 'rsvp' %}
  {{ field.text('editor-in-reply-to', 'in-reply-to', 'Event address', value=form.inReplyTo, type='url', error=(error if errorField == 'editor-in-reply-to' else ''), hint='The event’s page. It is sent a webmention when you publish.') }}
  {{ citedCard('in-reply-to') }}
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Going?</legend>
    <div class="join flex-wrap">
      {% for choice in rsvpChoices %}
        <input{% if loop.first %} id="editor-rsvp"{{ invalidIf('editor-rsvp') }}{% endif %} class="join-item btn btn-sm" type="radio" name="rsvp" value="{{ choice.value }}" aria-label="{{ choice.label }}"{% if form.rsvp == choice.value %} checked{% endif %} />
      {% endfor %}
      {% if unrecognizedRsvp %}
        <input class="join-item btn btn-sm" type="radio" name="rsvp" value="{{ unrecognizedRsvp }}" aria-label="{{ unrecognizedRsvp }} (not recognized)" checked />
      {% endif %}
      {% if not own %}
        <input class="join-item btn btn-sm" type="radio" name="rsvp" value="" aria-label="Not an RSVP" />
      {% endif %}
    </div>
    {{ groupError('editor-rsvp') }}
  </fieldset>

{% elif name == 'event' %}
  {% set eventTimeHint %}Wall-clock time in {{ dateZone }}. Stored as UTC.{% endset %}
  <div class="grid gap-x-4 sm:grid-cols-2">
    {{ field.text('editor-event-start', eventFields.start, 'Starts', value=form.event.start, placeholder='2026-10-10 09:00', autocomplete='off', error=(error if errorField == 'editor-event-start' else ''), hintHtml=eventTimeHint, hintId='editor-event-time-hint') }}
    {{ field.text('editor-event-end', eventFields.end, 'Ends', value=form.event.end, placeholder='2026-10-10 17:00', autocomplete='off', error=(error if errorField == 'editor-event-end' else ''), hintId='editor-event-time-hint') }}
  </div>
  {{ field.text('editor-event-location', eventFields.location, 'Where', value=form.event.location, error=(error if errorField == 'editor-event-location' else ''), hint='The place, or the address to join an online event at.', hintId='editor-event-location-hint') }}
  {% if not own %}
    <p class="label block whitespace-normal text-xs">Empty every box to make it a post again.</p>
  {% endif %}

{% elif name == 'checkin' %}
  {{ placeFields(true) }}

{% elif name == 'episode' %}
  {% call field.select('editor-enclosure-url', enclosureFields.url, 'Audio or video file', error=(error if errorField == 'editor-enclosure-url' else ''), hint='Feeds carry it as the post’s enclosure and the post page plays it. None removes the recording, its transcript and its other versions.', hintId='editor-enclosure-url-hint') %}
    <option value=""{% if form.enclosure.url == "" %} selected{% endif %}>None</option>
    {% for choice in enclosureChoices.media %}
      <option value="{{ choice.url }}"{% if choice.url == form.enclosure.url %} selected{% endif %}>{{ choice.label }}</option>
    {% endfor %}
  {% endcall %}
  {{ uploadControl('select', 'editor-enclosure-url', uploadsUrl, accept='audio/*,video/*') }}
  <div class="grid gap-x-4 sm:grid-cols-2">
    {{ field.text('editor-enclosure-duration', enclosureFields.duration, 'Duration', value=form.enclosure.duration, inputmode='numeric', autocomplete='off', error=(error if errorField == 'editor-enclosure-duration' else ''), hint='Seconds, or 30:34, or 1:02:03. Leave it empty if you do not know.', hintId='editor-enclosure-duration-hint') }}
    <div>
      {{ field.text('editor-enclosure-transcript', enclosureFields.transcriptUrl, 'Transcript or captions', value=form.enclosure.transcriptUrl, list='editor-transcript-uploads', autocomplete='off', error=(error if errorField == 'editor-enclosure-transcript' else ''), hintId='editor-enclosure-transcript-hint') }}
      {{ uploadControl('field', 'editor-enclosure-transcript', uploadsUrl, accept='.vtt,.srt,.txt') }}
    </div>
  </div>
  <datalist id="editor-transcript-uploads">
    {% for url in enclosureChoices.transcripts %}
      <option value="{{ url }}"></option>
    {% endfor %}
  </datalist>
  {% call field.select('editor-enclosure-transcript-type', enclosureFields.transcriptType, 'Transcript type', error=(error if errorField == 'editor-enclosure-transcript-type' else ''), hint='A .vtt, .srt or .txt file in the media library, or a web address. A linked transcript needs its type.', hintId='editor-enclosure-transcript-hint') %}
    <option value=""{% if form.enclosure.transcriptType == "" %} selected{% endif %}>From the file</option>
    {% for type in transcriptTypes %}
      <option value="{{ type }}"{% if type == form.enclosure.transcriptType %} selected{% endif %}>{{ type }}</option>
    {% endfor %}
  {% endcall %}

  {% call collapse('Other versions', open.versions, fields=true) %}
    <p class="label block whitespace-normal text-xs">
      A video of an audio episode, a smaller file, another language. Each is a file in the media
      library or a web address, which needs its type. Empty an address to remove
      that version.
    </p>
    {% for row in alternateRows %}
      {% set n = loop.index0 %}
      {% call collapse(('Version ' + loop.index) if row.url else 'Add a version', row.url, fields=true) %}
        {{ field.text('editor-alternate-url-' + n, enclosureFields.alternate.url + n, 'Address', value=row.url, list='editor-media-uploads', autocomplete='off', error=(error if errorField == ('editor-alternate-url-' + n) else '')) }}
        {{ uploadControl('field', 'editor-alternate-url-' + n, uploadsUrl, accept='audio/*,video/*') }}
        {{ field.text('editor-alternate-type-' + n, enclosureFields.alternate.type + n, 'Type', value=row.type, placeholder='video/mp4', autocomplete='off', spellcheck='false', error=(error if errorField == ('editor-alternate-type-' + n) else '')) }}
        {{ field.text('editor-alternate-title-' + n, enclosureFields.alternate.title + n, 'Title', value=row.title, maxlength='32', error=(error if errorField == ('editor-alternate-title-' + n) else '')) }}
        {{ field.text('editor-alternate-height-' + n, enclosureFields.alternate.height + n, 'Height', value=row.height, inputmode='numeric', autocomplete='off', error=(error if errorField == ('editor-alternate-height-' + n) else '')) }}
        {{ field.text('editor-alternate-lang-' + n, enclosureFields.alternate.lang + n, 'Language', value=row.lang, autocomplete='off', spellcheck='false', error=(error if errorField == ('editor-alternate-lang-' + n) else '')) }}
      {% endcall %}
    {% endfor %}
    <datalist id="editor-media-uploads">
      {% for choice in enclosureChoices.media %}
        <option value="{{ choice.url }}"></option>
      {% endfor %}
    </datalist>
  {% endcall %}

{% elif name == 'review' %}
  <fieldset class="fieldset">
    <legend class="fieldset-legend">Reviewing a</legend>
    <div class="join flex-wrap">
      {% for kind in reviewKinds %}
        <input{% if loop.first %} id="editor-item-kind"{{ invalidIf('editor-item-kind') }}{% endif %} class="join-item btn btn-sm" type="radio" name="{{ reviewFields.kind }}" value="{{ kind.value }}" aria-label="{{ kind.label }}"{% if kind.value == reviewKindChosen %} checked{% endif %}{% if kind.value == 'other' %} data-as-other{% endif %} />
      {% endfor %}
      {% if unrecognizedReviewKind %}
        <input class="join-item btn btn-sm" type="radio" name="{{ reviewFields.kind }}" value="{{ unrecognizedReviewKind }}" aria-label="{{ unrecognizedReviewKind }} (not recognized)" checked data-as-other />
      {% endif %}
    </div>
    {{ groupError('editor-item-kind') }}
  </fieldset>

  {#- Nominatim's usage policy forbids autocomplete, so Find searches only on
      Enter or Search. -#}
  {{ forItemKinds(itemSearchKinds) }}
    <div id="editor-item-find" class="fieldset" data-item-search="{{ itemSearchUrl }}" hidden>
      <label class="fieldset-legend" for="editor-item-find-query">{{ itemWord('noun', before='Find the ') }}</label>
      <div class="join w-full">
        <label class="input input-sm join-item w-full">
          {{ icon('m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z', 'sm') }}
          <input id="editor-item-find-query" type="search" class="grow" placeholder="Search by title" autocomplete="off" aria-describedby="editor-item-find-status" />
        </label>
        <button type="button" class="btn btn-sm btn-soft join-item" id="editor-item-find-button">Search</button>
      </div>
      <p class="text-sm" id="editor-item-find-status" role="status"></p>
      <ul class="menu w-full rounded-box border border-base-300 bg-base-100 p-1" id="editor-item-find-matches" aria-label="Matches" hidden>
        <li class="menu-title text-xs font-normal" id="editor-item-find-credit" hidden></li>
        <li class="menu-title text-xs font-normal">Not here? Paste a link in the box below and press Look up.</li>
      </ul>
      <template id="editor-item-find-match">
        <li>
          <button type="button" class="flex items-center gap-3 text-left">
            <img class="h-12 w-9 shrink-0 rounded object-cover" alt="" hidden />
            <span class="flex h-12 w-9 shrink-0 items-center justify-center rounded bg-base-200" data-no-picture>{{ icon('m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z', 'sm') }}</span>
            <span class="min-w-0 flex-1"><span class="block font-semibold" data-name></span><span class="block text-xs opacity-70" data-detail></span></span>
            <span class="badge badge-ghost badge-sm shrink-0" data-source></span>
          </button>
        </li>
      </template>
    </div>
  </div>

  {{ forItemKinds(reviewKindsWith.uid, 'editor-item-lookup') }}
    <div class="join w-full items-end">
      <div class="w-full">
        {{ field.text('editor-item-uid', reviewFields.uid, '', labelHtml=itemWord('uid'), value=form.review.uid, autocomplete='off', spellcheck='false', error=(error if errorField == 'editor-item-uid' else ''), hintId='editor-item-uid-hint') }}
      </div>
      <button type="submit" class="btn btn-sm btn-soft join-item mb-1" name="{{ itemLookupButton }}" value="1" formnovalidate data-item-lookup="{{ itemLookupUrl }}">Look up</button>
    </div>
    <p class="text-sm{{ LOOKUP_TONES | modifier('failed' if itemLookup.failed else 'found') }}" id="editor-item-lookup-status" role="status">{{ itemLookup.message if itemLookup else '' }}</p>
    <p class="label block whitespace-normal" id="editor-item-uid-hint">Its address on TMDb, IMDb, MusicBrainz, OpenStreetMap or its own site, or isbn:… or doi:… for a book or a paper. Look up fills the empty boxes from it.</p>
  </div>
  {{ field.text('editor-item-name', reviewFields.name, '', labelHtml=itemWord('name'), value=form.review.name, error=(error if errorField == 'editor-item-name' else '')) }}
  {{ forItemKinds(reviewKindsWith.category) }}
    {{ field.text('editor-item-category', reviewFields.category, 'What is it', value=form.review.category, hint='A restaurant, a plumber, an app. Collection pages group by this, so reuse the same word.', hintId='editor-item-category-hint') }}
  </div>
  <div class="grid gap-x-4 sm:grid-cols-2">
    {{ forItemKinds(reviewKindsWith.by) }}
      {{ field.text('editor-item-by', reviewFields.by, '', labelHtml=itemWord('by'), value=form.review.by) }}
    </div>
    {{ forItemKinds(reviewKindsWith.year) }}
      {{ field.text('editor-item-year', reviewFields.year, 'Year', value=form.review.year, inputmode='numeric', error=(error if errorField == 'editor-item-year' else '')) }}
    </div>
  </div>
  <div class="grid gap-x-4 sm:grid-cols-2">
    {{ forItemKinds(reviewKindsWith.season) }}
      {{ field.text('editor-item-season', reviewFields.season, 'Season', value=form.review.season, inputmode='numeric', error=(error if errorField == 'editor-item-season' else ''), hint='Leave Season and Episode empty to review the whole show.', hintId='editor-item-season-hint') }}
    </div>
    {{ forItemKinds(reviewKindsWith.episode) }}
      {{ field.text('editor-item-episode', reviewFields.episode, 'Episode', value=form.review.episode, inputmode='numeric', error=(error if errorField == 'editor-item-episode' else '')) }}
    </div>
  </div>
  {{ forItemKinds(['place']) }}
    {{ field.text('editor-item-street-address', reviewFields.streetAddress, 'Street address', value=form.review.streetAddress) }}
    <div class="grid gap-x-4 sm:grid-cols-3">
      {{ field.text('editor-item-locality', reviewFields.locality, 'Locality', value=form.review.locality) }}
      {{ field.text('editor-item-region', reviewFields.region, 'Region', value=form.review.region) }}
      {{ field.text('editor-item-country-name', reviewFields.countryName, 'Country', value=form.review.countryName) }}
    </div>
  </div>
  <div class="grid gap-x-4 sm:grid-cols-2">
    {{ forItemKinds(reviewKindsWith.url) }}
      {{ field.text('editor-item-url', reviewFields.url, '', labelHtml=itemWord('url'), value=form.review.url, type='url', error=(error if errorField == 'editor-item-url' else '')) }}
    </div>
    {{ forItemKinds(reviewKindsWith.date) }}
      {{ field.text('editor-item-date', reviewFields.date, '', labelHtml=itemWord('date'), value=form.review.date, type='date', error=(error if errorField == 'editor-item-date' else '')) }}
    </div>
  </div>
  {{ forItemKinds(reviewKindsWith.photo) }}
    <div class="flex gap-3">
      <img class="h-24 w-16 shrink-0 rounded-box object-cover" id="editor-item-photo-preview"{% if reviewPhotoThumbnail %} src="{{ reviewPhotoThumbnail }}"{% else %} hidden{% endif %} alt="" loading="lazy" />
      <div class="flex min-w-0 flex-1 flex-col">
        {{ field.text('editor-item-photo', reviewFields.photo, '', labelHtml=itemWord('picture'), value=form.review.photo, list='editor-photo-uploads', autocomplete='off', error=(error if errorField == 'editor-item-photo' else ''), hint='An image in the media library or a web address. It is the item’s picture, not a photo for the post: it shows beside the item’s details.', hintId='editor-item-photo-hint') }}
        {{ uploadControl('field', 'editor-item-photo', uploadsUrl, images=true, preview='editor-item-photo-preview') }}
        {{ field.text('editor-item-photo-alt', reviewFields.photoAlt, '', labelHtml=itemWord('picture', ' alt text'), value=form.review.photoAlt) }}
      </div>
    </div>
  </div>

  <fieldset class="fieldset rounded-box border border-base-300 bg-base-200/40 p-3">
    <legend class="fieldset-legend">Rating</legend>
    <div class="flex flex-wrap items-center gap-2">
      <div class="rating rating-md">
        <input id="editor-rating-none" class="rating-hidden" type="radio" name="{{ reviewFields.rating }}" value="" aria-label="No rating"{% if form.review.rating == "" %} checked{% endif %} />
        {% for stars in [1, 2, 3, 4, 5] %}
          <input{% if loop.first %} id="editor-rating"{{ invalidIf('editor-rating') }}{% endif %} class="mask mask-star-2 bg-warning" type="radio" name="{{ reviewFields.rating }}" value="{{ stars }}" aria-label="{{ stars }} out of 5"{% if form.review.rating == stars | string %} checked{% endif %} />
        {% endfor %}
      </div>
      <label class="btn btn-ghost btn-xs" for="editor-rating-none">Clear</label>
      {% if form.review.rating and form.review.rating not in ["1", "2", "3", "4", "5"] %}
        <label class="label text-base-content">
          <input class="radio radio-sm" type="radio" name="{{ reviewFields.rating }}" value="{{ form.review.rating }}" checked />
          {{ form.review.rating }} (not recognized)
        </label>
      {% endif %}
    </div>
    {{ groupError('editor-rating') }}
  </fieldset>
  {% if not own %}
    <p class="label block whitespace-normal text-xs">Empty every box and clear the rating to make it a post again.</p>
  {% endif %}
{% endif %}
{% endmacro %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-center gap-3">
    <h1 class="flex min-w-0 items-center gap-2 break-words text-2xl font-bold">
      {% if editorKind %}<span class="text-primary">{{ icon(editorKind.icon) }}</span>{% endif %}
      <span class="min-w-0">{{ heading }}</span>
    </h1>
    {% if editorKind %}
      {% call dropdown('editor-change-type', 'Change type', style='ghost') %}
        <ul class="menu w-full">
          {% for choice in postKinds %}
            <li>
              <button type="submit" form="editor-form" name="switch-kind" value="{{ choice.key }}" formnovalidate{% if choice.key == postKind %} class="menu-active" aria-current="true"{% endif %}>{{ icon(choice.icon, 'sm') }} {{ choice.label }}</button>
            </li>
          {% endfor %}
        </ul>
      {% endcall %}
      {% if child == 'new' %}
        <a class="link link-hover text-sm" href="{{ chooserUrl }}">All kinds</a>
      {% endif %}
    {% endif %}
  </div>

  {% if error and errorField %}
    {% call field.summary('Nothing was saved. Fix the field marked below and try again.') %}
      {{ field.problem(errorField, error) }}
    {% endcall %}
  {% elif error %}
    {{ field.summary(error) }}
  {% endif %}

  {% if trashed or scheduledFor %}
    <div class="my-6 flex flex-col gap-2">
      {% if trashed %}
        {% call alert(color='warning', polite=true) %}
          <span>This {{ kind.singular }} is in the trash. The public site is not serving it.</span>
        {% endcall %}
      {% endif %}
      {% if scheduledFor %}
        {% call alert(color='info', polite=true) %}
          <span>Scheduled for {{ scheduledFor }}. The public site starts serving it then, and the followers are told then.</span>
        {% endcall %}
      {% endif %}
    </div>
  {% endif %}

  {% if resume %}
    {# The user's autosaved copy, offered back. Outside the editor form, since
       Discard is a form of its own. editor.js holds the autosave until one of
       the two is chosen, so typing here cannot overwrite the copy. #}
    <div class="my-6" id="autosave-resume" data-saved-at="{{ resume.savedAt }}">
      {% call alert(color='warning', direction='responsive', labelledby='autosave-resume-message') %}
        <p id="autosave-resume-message">
          Unsaved changes from <time datetime="{{ resume.savedAt }}">{{ resume.at }}</time>.
          {% if resume.changedSince %}This {{ resume.noun }} has changed since. Restore shows both versions side by side.{% endif %}
        </p>
        <div class="flex flex-wrap gap-2">
          {{ buttonLink('Restore', resume.restoreUrl, color='primary', size='sm') }}
          <form method="post" action="{{ resume.discardUrl }}" id="autosave-resume-discard">
            <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
            <input type="hidden" name="autosave" value="{{ resume.key }}" />
            <input type="hidden" name="return" value="{{ resume.returnUrl }}" />
            {{ button('Discard', type='submit', style='soft', size='sm') }}
          </form>
        </div>
      {% endcall %}
    </div>
  {% endif %}

  <form class="group/editor grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]" id="editor-form" method="post" action="{{ saveUrl }}">
    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
    {# The hash of the file this form was filled in from. A save whose hash no
       longer matches what is on disk is refused rather than overwriting
       somebody else's edit (doc-1). #}
    <input type="hidden" name="hash" value="{{ form.hash }}" />
    {# Which autosaved copy this form is: the content path, or for a document
       not saved yet the id it was opened with (decision-62). #}
    <input type="hidden" name="autosave" value="{{ autosaveKey }}" />
    {# Which layout the preview renders through. The save handler ignores it. #}
    <input type="hidden" name="type" value="{{ kind.type }}" />
    {% if editorKind %}
      <input type="hidden" name="kind" value="{{ postKind }}" />
    {% endif %}

    <div class="flex min-w-0 flex-col gap-4">
      {% call card() %}
        {% if not editorKind or editorKind.title != 'none' or form.title %}
          {% set titleHint %}{% if postKind == 'note' %}Add a title and the note becomes an article.{% endif %}{% endset %}
          {#- A post may go without one, and is then a note; a page is always named. -#}
          {{ field.text('editor-title', 'title', ('Title (optional)' if editorKind and editorKind.title != 'named' else 'Title'), value=form.title, required=(kind.type == "page"), autofocus=true, error=(error if errorField == 'editor-title' else ''), hintHtml=titleHint) }}
          {{ pluginActions('editor-title', editorActions['editor-title']) }}
        {% endif %}

        {% if editorKind %}
          {% for name in sections.own %}
            {{ section(name, true) }}
          {% endfor %}
        {% endif %}

        {{ field.textarea('editor-body', 'body', (editorKind.body if editorKind else 'Body'), value=form.body, rows=(8 if editorKind and editorKind.sections | length else 20)) }}

        {# Everything the editor's own script needs, on the element it hangs
           off. With JavaScript off this is one button that posts the form to
           the preview in a new tab, which is a preview. With it on, editor.js
           takes the button over, puts CodeMirror on the textarea above and
           adds the Write and Preview tabs, the upload control and its status
           line here. #}
        <div
          class="flex flex-wrap items-center gap-2"
          id="editor-enhance"
          data-preview-url="{{ previewUrl }}"
          data-upload-url="{{ uploadsUrl }}"
          data-kind="{{ kind.type }}"
          data-autosave-url="{{ autosaveUrl }}"
          data-autosave-user="{{ autosaveUser }}"
          data-autosave-discard-url="{{ autosaveDiscardUrl }}"
          {% if autosaveCopySavedAt %}data-autosave-copy-saved-at="{{ autosaveCopySavedAt }}"{% endif %}
          {% if autosaveFileTime %}data-autosave-file-time="{{ autosaveFileTime }}"{% endif %}
          {% if clearedAutosaves and clearedAutosaves.length %}data-autosave-cleared="{{ clearedAutosaves | dump }}"{% endif %}
        >
          {{ button('Preview', type='submit', id='editor-preview-fallback', style='soft', formaction=previewUrl, formtarget='_blank', formnovalidate=true) }}
        </div>
      {% endcall %}

      {% if editorKind and sections.also | length %}
        <h2 class="px-1 text-sm font-semibold">Also on this post</h2>
        {% for name in sections.also %}
          {% call collapse(SECTION_TITLES[name], true, fields=true) %}
            {{ section(name, false) }}
          {% endcall %}
        {% endfor %}
      {% endif %}

      {% if kind.type == "post" %}
        <datalist id="editor-photo-uploads">
          {% for url in photos.choices %}
            <option value="{{ url }}"></option>
          {% endfor %}
        </datalist>
        {% if form.previewHidden and not (citedPreviews | length) %}
          <input type="hidden" name="preview" value="hide">
        {% endif %}
        {% if form.citedAlt and not describesCitedImage %}
          <input type="hidden" name="cited-alt" value="{{ form.citedAlt }}">
        {% endif %}
      {% endif %}
    </div>

    <div class="flex min-w-0 flex-col gap-4">
      {% call card(size='sm') %}
        {% call cardActions() %}
          {% for action in actions %}
            {{ button(action.label, type='submit', name='action', value=action.value, color=ACTION_COLORS[action.value], style=ACTION_STYLES[action.value]) }}
          {% endfor %}
          {% if viewUrl %}
            {{ buttonLink('View', viewUrl, style='ghost') }}
          {% endif %}
        {% endcall %}

        {{ field.checkbox('editor-draft', 'draft', 'Draft', checked=form.draft) }}

        {% if kind.dated %}
          {# The file holds a UTC instant; this field is that instant as the
             site's own clock reads it, so the zone has to be on the screen. #}
          {% set dateHint %}Wall-clock time in {{ dateZone }}. Stored as UTC.{% endset %}
          {{ field.text('editor-date', 'date', 'When', value=form.date, error=(error if errorField == 'editor-date' else ''), hintHtml=dateHint) }}
        {% endif %}

        {% set visibilityHint %}
          {% if form.visibility.unrecognized is defined %}
            The front matter says <code>visibility: {{ form.visibility.unrecognized }}</code>, which this
            site does not recognize. The {{ kind.singular }} is hidden until you choose Public or Unlisted:
            its page answers 404 and it is not listed or sent to your followers.
          {% endif %}
          Unlisted writes <code>visibility: unlisted</code> into the front matter. The {{ kind.singular }}
          keeps its page and still goes to your followers, but is left off the home page, archives,
          feeds, the sitemap, search and llms.txt, and asks search engines not to index it.
        {% endset %}
        {% call field.select('editor-visibility', 'visibility', 'Visibility', hintHtml=visibilityHint, hintId='editor-visibility-hint') %}
          {% if form.visibility.unrecognized is defined %}
            <option value="{{ form.visibility.unrecognized }}" selected>{{ form.visibility.unrecognized }} (not recognized)</option>
          {% endif %}
          <option value="public"{% if form.visibility == "public" %} selected{% endif %}>Public</option>
          <option value="unlisted"{% if form.visibility == "unlisted" %} selected{% endif %}>Unlisted</option>
        {% endcall %}

        {# Who the front matter says wrote this (TASK-67). A select of the site's
           users rather than a free box, because after decision-14 the value is a
           person rather than a string: it decides whose archive the post is on
           and, once the actors land, whose followers hear about it. A file that
           still names somebody who has no account keeps an option of its own, so
           opening the editor cannot silently reattribute it. #}
        {% call field.select('editor-author', 'author', 'Author') %}
          {% for choice in authors %}
            <option value="{{ choice.value }}"{% if choice.chosen %} selected{% endif %}>{{ choice.label }}</option>
          {% endfor %}
        {% endcall %}
      {% endcall %}

      {% if kind.tagged or kind.categorised %}
        {% call collapse('Tags and categories', open.taxonomy, fields=true) %}
          {% if kind.tagged %}
            {{ field.text('editor-tags', 'tags', 'Tags', value=form.tags, hint='Separated by commas.') }}
            {{ pluginActions('editor-tags', editorActions['editor-tags']) }}
          {% endif %}
          {% if kind.categorised %}
            {{ field.text('editor-categories', 'categories', 'Categories', value=form.categories, hint='Separated by commas.') }}
          {% endif %}
        {% endcall %}
      {% endif %}

      {% if kind.type == "post" and sidebarLocation %}
        {% call collapse('Location', open.location, fields=true) %}
          {{ placeFields(false) }}
        {% endcall %}
      {% endif %}

      {% call collapse('Address', open.address, fields=true) %}
        {{ field.text('editor-slug', 'slug', 'Slug', value=form.slug, error=(error if errorField == 'editor-slug' else '')) }}
        {% set permalinkHint %}Leave it empty to let the {{ kind.singular }} take the URL its slug implies.{% endset %}
        {{ field.text('editor-permalink', 'permalink', 'Permalink', value=form.permalink, hintHtml=permalinkHint) }}
      {% endcall %}

      {% call collapse('Summary and language', open.summary, fields=true) %}
        {{ field.text('editor-description', 'description', 'Description', value=form.description, error=(error if errorField == 'editor-description' else '')) }}
        {{ pluginActions('editor-description', editorActions['editor-description']) }}

        {#- The `lang` front matter (TASK-154): a post or page written in another
            language than the site's says so, for screen readers, translation
            and fediverse language filters. -#}
        {% set langHint %}A language tag, such as fr or pt-BR. Leave it empty for the site’s language, {{ siteLanguage }}.{% endset %}
        {{ field.text('editor-lang', 'lang', 'Language', value=form.lang, autocomplete='off', spellcheck='false', error=(error if errorField == 'editor-lang' else ''), hintHtml=langHint, hintId='editor-lang-hint') }}
      {% endcall %}

      {% if kind.type == "post" and syndicationTargets.length %}
        {# TASK-155: the targets content/_data/syndicationTargets.json declares.
           A target whose tag the post carries is selected without a tick. #}
        {% call collapse('Syndicate to', open.syndication, fields=true) %}
          {% for target in syndicationTargets %}
            {{ field.checkbox('editor-' + target.field, target.field, target.name | escape, checked=target.checked) }}
          {% endfor %}
          <p class="label block whitespace-normal text-xs">
            Writes <code>syndicate-to:</code> into the front matter. The post links to each target and
            sends it a webmention when it is published or updated. A post tagged with a target’s tag is
            sent there without a tick.
          </p>
        {% endcall %}
      {% endif %}

      {% call collapse('Display and discussion', open.display, fields=true) %}
        {# What this document says about comments, if anything. Three answers
           rather than two: the site's own rules, always open, always closed. #}
        {% call field.select('editor-comments', 'comments', 'Comments', hintHtml='Open or Closed writes <code>comments: true</code> or <code>comments: false</code> into the front matter, which beats Settings › Discussion’s choice for this type and its closing window in both directions. Comments switched off for the whole site stay off. What was already said, and fediverse replies, are shown either way.') %}
          <option value="{{ commentSettings.site }}"{% if form.comments == commentSettings.site %} selected{% endif %}>Follow the site settings ({{ commentsSiteDefault }})</option>
          <option value="{{ commentSettings.open }}"{% if form.comments == commentSettings.open %} selected{% endif %}>Open</option>
          <option value="{{ commentSettings.closed }}"{% if form.comments == commentSettings.closed %} selected{% endif %}>Closed</option>
        {% endcall %}

        {% if kind.type == "post" %}
          {# TASK-207: shown at the top of the author's fediverse profile, from
             the featured collection their actor links. #}
          {{ field.checkbox('editor-pinned', 'pinned', 'Pinned', checked=form.pinned, error=(error if errorField == 'editor-pinned' else ''), hintHtml='Writes <code>pinned:</code> and the moment you pinned it into the front matter. Pinned posts show first on your fediverse profile, newest pin first, up to five.') }}
        {% endif %}

        {% if kind.excludable %}
          {# doc-2's eleventyExcludeFromCollections: still published and still at
             its URL, but out of every collection a template lists from. #}
          {% set excludeHint %}Keeps the {{ kind.singular }} out of listings that gather content, without unpublishing it.{% endset %}
          {{ field.checkbox('editor-exclude', 'exclude', 'Hide from collections', checked=form.exclude, hintHtml=excludeHint) }}
        {% endif %}

        {% if kind.contactable %}
          {# The page offers a contact form under its content (TASK-56). Where a
             message goes is the contact address on the Settings screen; it is
             never on this page or in its HTML. #}
          {% set contactHint %}Writes <code>contact: true</code> into the front matter and puts a name, email, subject and message form under this {{ kind.singular }}. Messages arrive on the Messages screen and are emailed to the contact address on Settings.{% endset %}
          {{ field.checkbox('editor-contact', 'contact', 'Contact form', checked=form.contact, hintHtml=contactHint) }}
        {% endif %}
      {% endcall %}
    </div>
  </form>
  {% if editorActions | length %}
    <form id="editor-suggestions" hidden></form>
  {% endif %}

  {# CodeMirror, the preview tab and the upload control. A module script is
     deferred by definition, so it runs after the form is in the document.
     Nothing above depends on it: with the bundle missing or JavaScript off the
     textarea and the Preview button are the whole editor.

     The nonce is not what lets it run — `script-src 'self'` already does, and
     the admin has no inline script at all. It is here so the bundle can read
     it back off this element and hand it to CodeMirror, whose themes are
     injected as <style> elements at runtime and would otherwise be refused by
     `style-src`. Reading it through the element's `.nonce` property rather
     than a data attribute keeps it out of reach of a CSS selector. #}
  <script
    type="module"
    id="editor-script"
    src="{{ adminAsset('editor.js') }}"
    nonce="{{ cspNonce }}"
  ></script>

  {# The slug and permalink auto-fill, in a file of its own so the policy never
     has to allow an inline script. #}
  <script defer src="{{ adminAsset('slug.js') }}"></script>
  <script defer src="{{ adminAsset('upload-drop.js') }}"></script>
  {% if kind.type == 'post' %}
    <script defer src="{{ adminAsset('location.js') }}"></script>
  {% endif %}
  {% if editorActions | length %}
    <script defer src="{{ adminAsset('editor-actions.js') }}"></script>
  {% endif %}
  {% if sections and sections.shown.review %}
    <script defer src="{{ adminAsset('item-lookup.js') }}"></script>
  {% endif %}
{% endblock %}
