{# The listing behind /admin/posts and /admin/pages. One template for both:
   `kind` says which, and whether the table has a date column and taxonomy
   ones. `pages/documents/` is named after what its screens are about rather
   than after the menu, because Posts, Pages, Categories and Tags are four
   menu entries over three templates. #}
{% extends "layouts/shell.njk" %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import button, buttonLink %}
{% from "components/pagination.njk" import pagination %}
{% from "components/table.njk" import table, row, heading, cell, rowToggle %}
{% from "components/tabs.njk" import tabs %}

{% block title %}{{ kind.plural }}{% endblock %}

{% block content %}
  <div class="mb-6 flex flex-wrap items-center gap-4">
    <h1 class="text-2xl font-bold">{{ kind.plural }}</h1>
    {{ buttonLink('Add new', newUrl, color='primary') }}
  </div>

  <div class="mb-4 max-w-full overflow-x-auto contain-inline-size">
    {{ tabs(filters, 'Show ' + (kind.plural | lower)) }}
  </div>

  {% if unsaved %}
    {% if unsaved.length %}
      {% call table('Unsaved ' + (kind.plural | lower)) %}
        <thead>
          <tr>
            <th scope="col">Title</th>
            {{ heading('Kind') }}
            {{ heading('Of') }}
            {{ heading('Saved') }}
          </tr>
        </thead>
        <tbody>
          {% for copy in unsaved %}
            {% call row() %}
              <td>
                {% if copy.resumeUrl %}
                  <a class="link link-hover font-medium" href="{{ copy.resumeUrl }}">{{ copy.label }}</a>
                {% else %}
                  <span class="font-medium">{{ copy.label }}</span>
                {% endif %}
                <div class="-ms-2 mt-1 flex items-center gap-1 whitespace-nowrap">
                  {% if copy.resumeUrl %}
                    {{ buttonLink('Resume', copy.resumeUrl, style='ghost', size='xs') }}
                  {% endif %}
                  <form method="post" action="{{ discardUrl }}">
                    <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                    <input type="hidden" name="autosave" value="{{ copy.key }}" />
                    <input type="hidden" name="return" value="{{ returnUrl }}" />
                    {{ button('Discard', type='submit', style='ghost', size='xs', ariaLabel='Discard the unsaved changes to ' + copy.label) }}
                  </form>
                </div>
                {{ rowToggle(copy.label) }}
              </td>
              {% call cell('Kind', nowrap=true) %}{{ copy.kind }}{% endcall %}
              {% call cell('Of') %}{{ copy.of }}{% endcall %}
              {% call cell('Saved', nowrap=true) %}<time datetime="{{ copy.savedAt }}">{{ copy.at }}</time>{% endcall %}
            {% endcall %}
          {% endfor %}
        </tbody>
      {% endcall %}
    {% else %}
      <p>No unsaved changes.</p>
    {% endif %}
  {% elif documents.length %}
    {% call table(kind.plural) %}
      <thead>
        <tr>
          <th scope="col">Title</th>
          {{ heading('Author') }}
          {% if kind.tagged %}
            {{ heading('Tags') }}
          {% endif %}
          {% if kind.categorised %}
            {{ heading('Categories') }}
          {% endif %}
          {% if kind.dated %}
            {{ heading('Date') }}
          {% else %}
            {{ heading('Updated') }}
          {% endif %}
          {{ heading('Status') }}
        </tr>
      </thead>
      <tbody>
        {% for document in documents %}
          {% call row() %}
            <td>
              <a class="link link-hover font-medium" href="{{ document.editUrl }}">{{ document.title }}</a>{% if document.role %} &mdash; {{ document.role }}{% endif %}
              <div class="-ms-2 mt-1 flex items-center gap-1 whitespace-nowrap transition-opacity lg:[@media(hover:hover)]:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100">
                {{ buttonLink('Edit', document.editUrl, style='ghost', size='xs') }}
                <form method="post" action="{{ document.editUrl }}">
                  <input type="hidden" name="csrf_token" value="{{ csrfToken }}" />
                  <input type="hidden" name="return" value="{{ returnUrl }}" />
                  {% if document.trashed %}
                    {{ button('Restore', type='submit', name='action', value='restore', style='ghost', size='xs') }}
                  {% else %}
                    {{ button('Move to trash', type='submit', name='action', value='trash', style='ghost', size='xs') }}
                  {% endif %}
                </form>
                {% if document.viewUrl %}
                  {{ buttonLink('View', document.viewUrl, style='ghost', size='xs') }}
                {% endif %}
              </div>
              {{ rowToggle(document.title) }}
            </td>
            {% call cell('Author', nowrap=true) %}{{ document.author }}{% endcall %}
            {% if kind.tagged %}
              {% call cell('Tags') %}{{ document.tags }}{% endcall %}
            {% endif %}
            {% if kind.categorised %}
              {% call cell('Categories') %}{{ document.categories }}{% endcall %}
            {% endif %}
            {% if kind.dated %}
              {% call cell('Date', nowrap=true) %}{{ document.date | date('html') }}{% endcall %}
            {% else %}
              {% call cell('Updated', nowrap=true) %}{{ document.updated | date('html') }}{% endcall %}
            {% endif %}
            {% call cell('Status') %}
              {% if document.trashed %}
                {{ status('trashed', 'Trash') }}
              {% elif document.draft %}
                {{ status('draft', 'Draft') }}
              {% elif document.scheduled %}
                {{ status('scheduled', 'Scheduled') }}
              {% elif document.hidden %}
                {{ status('hidden', 'Hidden') }}
              {% else %}
                {{ status('published', 'Published') }}
              {% endif %}
            {% endcall %}
          {% endcall %}
        {% endfor %}
      </tbody>
    {% endcall %}

    <div class="mt-4">
      {{ pagination(page, previousUrl=previousUrl, nextUrl=nextUrl) }}
    </div>
  {% else %}
    <p>Nothing here.</p>
  {% endif %}
{% endblock %}
