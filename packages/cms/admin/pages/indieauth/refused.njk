{# A sign-in request that cannot go ahead (TASK-158). Shown rather than
   redirected, because the fault is in the address it would redirect to. #}
{% extends "layouts/base.njk" %}

{% block title %}Sign-in refused{% endblock %}

{% block content %}
  <h1>This sign-in cannot go ahead</h1>
  <p>{{ message }}</p>
  <p>Go back to the app and try again. If it keeps happening, the app may be set up wrongly.</p>
{% endblock %}
