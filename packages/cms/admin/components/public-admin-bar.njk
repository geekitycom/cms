{# The admin bar as the public site includes it (TASK-183, decision-30),
   straight after the theme's <body> tag, with the unpublished notice under
   it. #}
{% include "components/admin-bar.njk" %}{% if notice %}
<p class="geekity-unpublished-notice" style="all: initial; display: block; box-sizing: border-box; margin: 0; padding: 8px 16px; background: #fcf9e8; color: #1d2327; border-bottom: 1px solid #dba617; font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">{{ notice }}</p>
{%- endif %}
