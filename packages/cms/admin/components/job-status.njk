{# The latest run of a queued job, from `jobStatusView` in
   src/admin/job-status.ts. `{% call jobStatus(job, …) %}result{% endcall %}`
   emits its state as a badge and when it got there, then:

     queued       that it waits for the worker, and whether a restart sent it back
     running      a progress bar and "<verb> <done> of <total> <unit>"
     finished     the caller's body, which draws the job's own result
     failed       the error, in an alert
     interrupted  that restarts or crashes cut it off and it will not run again

   While it is queued or running, the box names `refreshUrl` in
   `data-job-refresh`. A page that loads static/job-status.js has it fetch
   that page every few seconds and swap in its box with the same
   `data-job-status` until the job ends. It swaps the closest
   `data-job-region` around the box instead when there is one, so a page can
   redraw the controls it hides while the job runs. Without JavaScript,
   `refreshUrl` is a Check again link. `verb` and `unit` word the progress.
   The error and every word passed in are escaped. #}
{% from "components/alert.njk" import alert %}
{% from "components/badge.njk" import status %}
{% from "components/button.njk" import buttonLink %}

{% macro jobStatus(job, refreshUrl, verb='Done', unit='items') -%}
<div class="flex flex-col gap-3" data-job-status="{{ job.name }}" data-job-state="{{ job.state }}" data-job-label="{{ job.label }}"{% if job.active %} data-job-refresh="{{ refreshUrl }}"{% endif %}>
  <p class="flex flex-wrap items-center gap-2">
    {{ status(job.state, job.label) }}
    <span class="text-sm"><time datetime="{{ job.at }}">{{ job.at | date('readable') }}</time></span>
  </p>
  {% if job.state == 'queued' %}
    <p data-job-message>Waiting for the worker to start it.{% if job.requeued %} A restart cut off the last try, so it is queued again as try {{ job.attempt }}.{% endif %}</p>
  {% elif job.state == 'running' %}
    {% if job.progress and job.progress.total %}
      <progress class="progress progress-primary w-full max-w-md" value="{{ job.progress.done }}" max="{{ job.progress.total }}" aria-label="{{ verb }} {{ job.progress.done }} of {{ job.progress.total }} {{ unit }}"></progress>
      <p data-job-message>{{ verb }} {{ job.progress.done }} of {{ job.progress.total }} {{ unit }}.{% if job.progress.note %} {{ job.progress.note }}{% endif %}</p>
    {% else %}
      <progress class="progress progress-primary w-full max-w-md" aria-label="Starting"></progress>
      <p data-job-message>Starting.</p>
    {% endif %}
  {% elif job.state == 'finished' %}
    {% if caller %}{{ caller() }}{% endif %}
  {% elif job.state == 'failed' %}
    {% call alert(color='error', style='soft') %}<span data-job-message>{{ job.error }}</span>{% endcall %}
  {% elif job.state == 'interrupted' %}
    <p data-job-message>Restarts or crashes cut it off {{ job.attempt }} times, so it is not run again on its own.</p>
  {% endif %}
  {% if job.active %}
    <div data-job-check-again>{{ buttonLink('Check again', refreshUrl, style='outline') }}</div>
  {% endif %}
</div>
{%- endmacro %}
