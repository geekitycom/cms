{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Browser code, not server code: it needs the DOM and must not be able to
    // reach for `node:` anything by accident.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
