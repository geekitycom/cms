<article class="post">
  <h1>{{ title }}</h1>
  {{ content | safe }}
  {#- In the post's own language when it names one, as the default theme
      writes it (TASK-189). -#}
  <p class="published">Published {{ date | date("readable", none, lang) }}</p>
</article>

{#
  The conversation, built from `content/_data/federation/` by the example
  config's `conversation` filter. The CMS renders the same shape through
  `themes/default/partials/conversation.njk`; this is the Eleventy half of the
  same promise, and `test/eleventy.test.ts` compares them.
#}
{% macro thread(reply) %}
{% if reply.withheld %}
<li class="comment comment-placeholder" id="comment-{{ reply.id }}">
  <p class="comment-withheld">This comment is no longer shown.</p>
  <ol class="children">{% for child in reply.replies %}{{ thread(child) }}{% endfor %}</ol>
</li>
{% else %}
<li class="comment comment-{{ reply.source }}" id="comment-{{ reply.id }}">
  <a class="comment-author" href="{{ reply.author.url }}">{{ reply.author.name }}</a>
  <a class="comment-permalink" href="{{ reply.url }}">
    <time datetime="{{ reply.published }}">{{ reply.published }}</time>
  </a>
  <div class="comment-body">{{ reply.content | safe }}</div>
  {% if reply.replies.length %}
  <ol class="children">{% for child in reply.replies %}{{ thread(child) }}{% endfor %}</ol>
  {% endif %}
</li>
{% endif %}
{% endmacro %}
{% set conversation = federation.inbox | conversation(activityStreams, geekitySlug) %}
{% if conversation.counts.total %}
<section class="conversation">
  <p class="conversation-counts">
    {{ conversation.counts.replies }} replies,
    {{ conversation.likes.length }} like{{ "s" if conversation.likes.length != 1 }},
    {{ conversation.boosts.length }} boost{{ "s" if conversation.boosts.length != 1 }},
    {{ conversation.mentions.length }} mention{{ "s" if conversation.mentions.length != 1 }}
  </p>
  {% if conversation.mentions.length %}
  <ul class="mention-list">
    {% for mention in conversation.mentions %}
    <li class="mention comment-{{ mention.source }}">
      <a href="{{ mention.url }}">{{ mention.author.name }}</a>
      {% if mention.author.avatar %}<img src="{{ mention.author.avatar }}" alt="">{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <ol class="comment-list">
    {% for reply in conversation.replies %}{{ thread(reply) }}{% endfor %}
  </ol>
</section>
{% endif %}
