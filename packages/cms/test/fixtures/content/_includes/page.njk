{#
  The menu the CMS puts on every page as `menu`, built here from
  `collections.menu`, which the example config assembles out of `site.navigation`
  and the pages whose front matter says `navigation: true`.
#}
<nav class="site-nav">
  <ul>
    {% for item in collections.menu %}
    <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
    {% endfor %}
  </ul>
</nav>
<article class="page">
  <h1>{{ title }}</h1>
  {{ content | safe }}
  {#
    The posts page: the CMS serves the post listing at this page's own URL,
    under its title and words, and the example config flags which page that is
    so a build can do the same.
  #}
  {% if isPostsPage %}
  <ul class="post-list">
    {% for post in collections.post | reverse %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</article>
{#
  The federation files the CMS publishes with the site, which Eleventy hands
  over as ordinary data because they live under `_data/`: `followers.json`
  becomes `federation.followers`, and each month of the inbox log becomes an
  entry of `federation.inbox` (the config registers `.jsonl` as a data format).
#}
<ul class="followers">
  {% for follower in federation.followers %}
  <li><a href="{{ follower.url }}">{{ follower.name or follower.handle }}</a></li>
  {% endfor %}
</ul>
<ul class="inbox">
  {% for month, activities in federation.inbox %}{% for activity in activities %}
  <li>{{ activity.type }} from {{ activity.actor }} in {{ month }}</li>
  {% endfor %}{% endfor %}
</ul>
