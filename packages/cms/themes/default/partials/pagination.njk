{# Previous/next pager. Expects `pagination`. Renders nothing on a one-page listing. #}
{% if pagination.totalPages > 1 %}
<nav class="pagination" aria-label="Pagination">
  {% if pagination.href.previous %}
  <a class="pagination-previous" rel="prev" href="{{ pagination.href.previous | url }}">Newer</a>
  {% endif %}
  <span class="pagination-position">
    Page {{ pagination.pageNumber + 1 }} of {{ pagination.totalPages }}
  </span>
  {% if pagination.href.next %}
  <a class="pagination-next" rel="next" href="{{ pagination.href.next | url }}">Older</a>
  {% endif %}
</nav>
{% endif %}
