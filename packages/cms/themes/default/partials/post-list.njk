{#
  The feed a listing is made of: `h-feed` of `h-entry` items (doc-9).

  Expects `posts`. Every entry opens on a kicker naming its kind and its date.
  An article is the only entry with a headline: its title as a linked
  `p-name`, its `summary` (the very line the feeds publish) as a `p-summary`
  cut to about 280 characters, and a Continue reading link, with the
  categories it is filed under in its kicker. A note, which has no title, is
  printed whole as its `e-content`, and its date in the kicker is the link to
  it. A reply is a note that first cites what it answers, and a reply with a
  title is an article that does. Tags are deliberately not here: an entry's
  tags belong under the entry, and a feed of twenty posts listing everyone's
  would be a wall of links rather than a list of writing.

  `feedHeading` is the heading level, which belongs to the layout rather than
  to the list: a listing is a page of entries and heads each one at 2, and a
  front page whose feed sits under a heading of its own sets 3 so the outline
  never skips a level.
#}
{% import "partials/kicker.njk" as kicker with context %}
{% import "partials/lang.njk" as language with context %}
{% set feedTitleTag = "h" + (feedHeading | default(2)) %}
{% if posts.length %}
<div class="feed h-feed">
  {% for post in posts %}
  {% if not loop.first %}
  <hr class="feed-separator">
  {% endif %}
  <article class="feed-item h-entry"{{ language.attr(post.lang) }}>
    {% if post.named %}
    {{ kicker.line(post.postType | capitalize, post.date, false, post.categories, lang=post.lang) }}
    {% else %}
    {{ kicker.line(post.postType | capitalize, post.date, post.url, [], post.label, lang=post.lang) }}
    {% endif %}
    {#- What a reply answers, from the same partial an entry cites it with. -#}
    {% if post.inReplyTo %}
    {% set inReplyTo = post.inReplyTo %}
    {% set replyContext = post.replyContext %}
    {% set lang = post.lang %}
    {% include "partials/reply-context.njk" %}
    {% endif %}
    {% if post.photos.length %}
    {% set photos = post.photos %}
    {% include "partials/photos.njk" %}
    {% endif %}
    {% if not post.named %}
    <div class="feed-excerpt e-content">{{ post.content | safe }}</div>
    {% else %}
    <{{ feedTitleTag }} class="feed-title p-name">
      <a href="{{ post.url | url }}" class="u-url">{{ post.title }}</a>
    </{{ feedTitleTag }}>
    {% if post.summary %}
    <div class="feed-excerpt p-summary">
      {#- `truncate` cuts at the last space before the length and adds an
          ellipsis, so a description short enough is printed whole and a long
          one never breaks a word. -#}
      <p>{{ post.summary | truncate(280) }}</p>
    </div>
    {% endif %}
    <p class="feed-more">
      <a href="{{ post.url | url }}" aria-label="Continue reading: {{ post.title }}">Continue reading<span aria-hidden="true"> &rarr;</span></a>
    </p>
    {% endif %}
  </article>
  {% endfor %}
</div>
{% else %}
<p class="empty">No posts found.</p>
{% endif %}
