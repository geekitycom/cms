{#
  The feed a listing is made of: `h-feed` of `h-entry` items, as the source
  design lists them (decision-16).

  Expects `posts`. A note, which has no title, is printed whole as its
  `e-content`, with its date as the link to it. Every other entry prints its
  title as a linked `p-name`, its `summary` — the very line the feeds publish —
  as a `p-summary` cut to about 280 characters, a Continue reading link, its
  publish date and the categories it is filed under. Tags are deliberately not here: an entry's tags belong
  under the entry, and a feed of twenty posts listing everyone's would be a
  wall of links rather than a list of writing.

  `feedHeading` is the heading level, which belongs to the layout rather than
  to the list: a listing is a page of entries and heads each one at 2, and a
  front page whose feed sits under a heading of its own sets 3 so the outline
  never skips a level.
#}
{% import "partials/tags.njk" as taxonomy with context %}
{% set feedTitleTag = "h" + (feedHeading | default(2)) %}
{% if posts.length %}
<div class="feed h-feed">
  {% for post in posts %}
  {% if not loop.first %}
  <hr class="feed-separator">
  {% endif %}
  <article class="feed-item h-entry">
    <div class="feed-content">
      {% if post.inReplyTo %}
      <p class="feed-reply small">In reply to <a class="u-in-reply-to" href="{{ post.inReplyTo }}">{{ post.inReplyTo }}</a></p>
      {% endif %}
      {% if not post.named %}
      <div class="feed-excerpt e-content">{{ post.content | safe }}</div>
      {% else %}
      <{{ feedTitleTag }} class="feed-title p-name">
        <a href="{{ post.url | url }}" class="u-url">{{ post.title }}</a>
      </{{ feedTitleTag }}>
      {% if post.summary %}
      <div class="feed-excerpt p-summary">
        {#- `truncate` cuts at the last space before the length and adds an
            ellipsis, so a description short enough is printed whole and a long
            one never breaks a word. -#}
        <p>{{ post.summary | truncate(280) }}</p>
      </div>
      {% endif %}
      <p class="feed-more">
        <a href="{{ post.url | url }}" aria-label="Continue reading: {{ post.title }}">Continue reading<span aria-hidden="true"> &rarr;</span></a>
      </p>
      {% endif %}
      <div class="feed-meta">
        {% if not post.named %}
        <p>
          <a href="{{ post.url | url }}" class="u-url">{% if post.date %}<time class="feed-date dt-published" datetime="{{ post.date | date("iso") }}">{{ post.date | date }}</time>{% else %}{{ post.label }}{% endif %}</a>
        </p>
        {% elif post.date %}
        <p>
          <time class="feed-date dt-published" datetime="{{ post.date | date("iso") }}">
            {{ post.date | date }}
          </time>
        </p>
        {% endif %}
        {{ taxonomy.categories(post.categories) }}
      </div>
    </div>
  </article>
  {% endfor %}
</div>
{% else %}
<p class="empty">No posts found.</p>
{% endif %}
