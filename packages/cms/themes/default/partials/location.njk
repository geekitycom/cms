{#
  Where the post was written (TASK-223), as much of it as Settings > Privacy
  shares (decision-29): a `p-location` inside the h-entry, an h-card when the
  place is named, an h-adr for its words, an h-geo for coordinates alone.

  `location.geo` is on the context only when the site shares exact
  coordinates, so this partial cannot print one the site chose to keep. The
  words are printed as text; the coordinates ride on `data` elements, visibly
  when they are all there is.
#}
<span class="p-location {{ location.type }}">
  {%- for word in location.words -%}
    <span class="{{ word.property }}">{{ word.text }}</span>{% if not loop.last %}, {% endif %}
  {%- endfor -%}
  {%- if location.geo -%}
    {%- if location.words.length -%}
      <data class="p-latitude" value="{{ location.geo.latitude }}"></data><data class="p-longitude" value="{{ location.geo.longitude }}"></data>
    {%- else -%}
      <data class="p-latitude" value="{{ location.geo.latitude }}">{{ location.geo.latitude }}</data>, <data class="p-longitude" value="{{ location.geo.longitude }}">{{ location.geo.longitude }}</data>
    {%- endif -%}
  {%- endif -%}
</span>
