{# Macros for taxonomy links. Import as
   `{% import "partials/tags.njk" as taxonomy with context %}` — the macros read
   the archive bases off `site`, and an import without the context cannot see
   it. #}

{# A list of tag links, under whatever base the site serves its archives at
   (`site.tagBase`, `tag` by default). Renders nothing when the list is empty. #}
{% macro list(tags) %}
{% if tags and tags.length %}
<ul class="tag-list">
  {% for tag in tags %}
  <li><a class="tag" href="{{ ("/" + (site.tagBase or "tag") + "/" + (tag | urlencode) + "/") | url }}">{{ tag }}</a></li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}

{# The same for categories, which are the second taxonomy and archive under
   `site.categoryBase` (`category` by default). Renders nothing when the list
   is empty. #}
{% macro categories(categories) %}
{% if categories and categories.length %}
<ul class="category-list">
  {% for category in categories %}
  <li><a class="category" href="{{ ("/" + (site.categoryBase or "category") + "/" + (category | urlencode) + "/") | url }}">{{ category }}</a></li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}
