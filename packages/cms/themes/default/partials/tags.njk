{# Macros for taxonomy links. Import as
   `{% import "partials/tags.njk" as taxonomy with context %}` — the macros read
   the archive bases off `site`, and an import without the context cannot see
   it. #}

{# A list of tag links, under whatever base the site serves its archives at
   (`site.tagBase`, `tag` by default). The same paragraph of `p-category`
   links the categories are — under an entry the two read as one line of what
   it is filed under, categories first — with `rel="tag"`, which is what a
   parser reads a tag by. Renders nothing when the list is empty. #}
{% macro list(tags) %}
{% if tags and tags.length %}
<p class="post-categories">
  {% for tag in tags %}
  <a href="{{ ("/" + (site.tagBase or "tag") + "/" + (tag | urlencode) + "/") | url }}" class="p-category" rel="tag">{{ tag }}</a>
  {% endfor %}
</p>
{% endif %}
{% endmacro %}

{# The same for categories, which are the second taxonomy and archive under
   `site.categoryBase` (`category` by default). One paragraph of `p-category`
   links, which is what the design prints in a feed item's meta line and under
   an entry. Renders nothing when the list is empty. #}
{% macro categories(categories) %}
{% if categories and categories.length %}
<p class="post-categories">
  {% for category in categories %}
  <a href="{{ ("/" + (site.categoryBase or "category") + "/" + (category | urlencode) + "/") | url }}" class="p-category" rel="category">{{ category }}</a>
  {% endfor %}
</p>
{% endif %}
{% endmacro %}
