{#
  What has been said about a post: replies as a thread, and likes, boosts and
  mentions as counts with the people behind them.

  Rendered from `layouts/post.njk` with the `conversation` on the context,
  which is only there when there is something in it, so a post nobody has
  answered renders none of this. A site replaces the whole section with a
  `partials/conversation.njk` of its own in the theme it wears; the shape it is
  handed is documented in the theme README under "The conversation".

  The macros come first because Nunjucks defines one where it stands rather
  than hoisting it, and the section below calls all three.
#}
{#
  One reply and everything under it. A macro rather than an include so it can
  call itself: a reply that answers a reply is the same thing one level in.
#}
{% macro comment(reply) %}
<li class="comment h-cite comment-{{ reply.source }}" id="comment-{{ reply.id }}">
  <article>
    <header class="comment-header">
      {% if reply.author.avatar %}
      <img class="comment-avatar u-photo" src="{{ reply.author.avatar }}" alt="" width="48" height="48" loading="lazy">
      {% endif %}
      {% if reply.author.url %}
      <a class="comment-author p-author h-card" href="{{ reply.author.url }}" rel="nofollow ugc noopener noreferrer">{{ reply.author.name }}</a>
      {% else %}
      <span class="comment-author p-author h-card">{{ reply.author.name }}</span>
      {% endif %}
      {% if reply.author.handle and reply.author.handle != reply.author.name %}
      <span class="comment-handle">{{ reply.author.handle }}</span>
      {% endif %}
      {% if reply.url %}
      <a class="comment-permalink u-url" href="{{ reply.url }}"{% if reply.source != "comment" %} rel="nofollow noopener noreferrer"{% endif %}>
        <time class="dt-published" datetime="{{ reply.published | date("iso") }}">{{ reply.published | date }}</time>
      </a>
      {% else %}
      <time class="dt-published" datetime="{{ reply.published | date("iso") }}">{{ reply.published | date }}</time>
      {% endif %}
    </header>
    <div class="comment-body e-content p-content">
      {{ reply.content | safe }}
    </div>
    {#
      Answering a comment on this site needs no JavaScript: the link carries
      the comment's id to the form, which puts it in a hidden field. A
      fediverse reply is answered on the server that holds it, and a webmention
      is answered on the page that sent it, so neither gets such a link.
    #}
    {% if commentForm and reply.source == "comment" %}
    <p class="comment-reply">
      <a href="{{ page.url }}?reply_to={{ reply.id }}#respond">Reply</a>
    </p>
    {% endif %}
  </article>
  {% if reply.replies.length %}
  <ol class="comment-replies">
    {% for child in reply.replies %}
    {{ comment(child) }}
    {% endfor %}
  </ol>
  {% endif %}
</li>
{% endmacro %}

{#
  A count of one kind of reaction with the actors behind it, closed until a
  reader opens it. `<details>` rather than a hover, so it works on a phone and
  needs no script.
#}
{% macro reactions(actors, one, many) %}
{% if actors.length %}
<details class="reaction-group">
  <summary>{{ actors.length }} {{ one if actors.length == 1 else many }}</summary>
  <ul class="reaction-list">
    {% for actor in actors %}
    <li class="reaction h-card">
      <a href="{{ actor.author.url or actor.url }}" rel="nofollow noopener noreferrer">
        {% if actor.author.avatar %}
        <img class="reaction-avatar u-photo" src="{{ actor.author.avatar }}" alt="" width="24" height="24" loading="lazy">
        {% endif %}
        <span class="reaction-name p-name">{{ actor.author.name }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}

{#
  The pages that linked here without answering. A webmention only: the
  fediverse has no way of saying "I wrote about this" that is not a reply or a
  boost. Each one links to the page that sent it rather than to its author,
  because the page is the thing worth reading.
#}
{% macro mentions(items) %}
{% if items.length %}
<details class="reaction-group">
  <summary>{{ items.length }} {{ "mention" if items.length == 1 else "mentions" }}</summary>
  <ul class="reaction-list">
    {% for item in items %}
    <li class="reaction h-cite">
      <a href="{{ item.url }}" rel="nofollow ugc noopener noreferrer">
        {% if item.author.avatar %}
        <img class="reaction-avatar u-photo" src="{{ item.author.avatar }}" alt="" width="24" height="24" loading="lazy">
        {% endif %}
        <span class="reaction-name p-name">{{ item.author.name }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}

<section class="conversation" id="comments">
  <h2 class="conversation-title">
    {{ conversation.counts.replies }} {{ "reply" if conversation.counts.replies == 1 else "replies" }}
  </h2>

  {% if conversation.likes.length or conversation.boosts.length or conversation.mentions.length %}
  <div class="conversation-reactions">
    {{ reactions(conversation.likes, "like", "likes") }}
    {{ reactions(conversation.boosts, "boost", "boosts") }}
    {{ mentions(conversation.mentions) }}
  </div>
  {% endif %}

  {% if conversation.replies.length %}
  <ol class="comment-list">
    {% for reply in conversation.replies %}
    {{ comment(reply) }}
    {% endfor %}
  </ol>
  {% endif %}
</section>
