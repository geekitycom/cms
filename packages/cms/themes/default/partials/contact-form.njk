{#
  The form under a page whose front matter says `contact: true`.

  `contactForm` is on the context only when the page asked for one, so a layout
  asks `{% if contactForm %}` and nothing else. A site replaces this whole
  section with a `partials/contact-form.njk` of its own in the theme it wears;
  the shape it is handed is documented in the theme README under "The contact
  form".

  Where the message goes is deliberately not here and not anywhere a template
  can reach: the address is read when a submission arrives, so it cannot end up
  in the HTML however this file is rewritten.

  It wears `comment-respond`, which is the source design's name for a form
  under an entry, because it is the same kind of form as the comment one and
  the two are better off sharing a set of rules than keeping two that drift.

  It works with JavaScript switched off, and there is no script on it.
#}
<section class="comment-respond contact-form" id="contact">
  {% if contactNotice %}
  {#
    The thank-you the redirect after a submission landed on. The form is not
    drawn again underneath it: the message has gone, and offering the fields
    back would invite a second copy of it.
  #}
  <h2 class="contact-form-title">Thank you</h2>
  <p class="contact-notice" role="status">{{ contactNotice }}</p>
  {% else %}
  <h2 class="contact-form-title">Send a message</h2>

  {#
    A refused submission leads with this, as the comment form does: what went
    wrong, and a link to each field to put right. It is an alert and takes
    focus on load; a field it links to is marked `aria-invalid` and names its
    message with `aria-describedby`.
  #}
  {% set problems = contactForm.problems %}
  {% if contactForm.error or problems.name or problems.email or problems.subject or problems.message %}
  <div class="contact-error" role="alert" tabindex="-1" autofocus aria-labelledby="contact-error-heading">
    <h3 id="contact-error-heading">{{ contactForm.error or 'Your message was not sent. Fix the fields marked below.' }}</h3>
    {% if problems.name or problems.email or problems.subject or problems.message %}
    <ul>
      {% for key in ['name', 'email', 'subject', 'message'] %}
      {% if problems[key] %}
      <li><a href="#contact-{{ key }}">{{ problems[key] }}</a></li>
      {% endif %}
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endif %}

  <form method="post" action="{{ contactForm.action }}">
    <input type="hidden" name="{{ contactForm.fields.page }}" value="{{ contactForm.page }}" />
    <input type="hidden" name="{{ contactForm.fields.loaded }}" value="{{ contactForm.loaded }}" />

    {#
      The honeypot. Hidden from sight and from assistive technology, out of the
      tab order, and told not to autofill: a person never sees it and never
      fills it in, so anything that does is not a person.
    #}
    <div class="contact-trap" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="{{ contactForm.fields.trap }}" type="text" tabindex="-1" autocomplete="off" value="" />
    </div>

    {#- Name and email side by side on a wide screen. -#}
    <div class="field-row">
    <p class="contact-field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="{{ contactForm.fields.name }}" type="text" value="{{ contactForm.values.name }}" maxlength="{{ contactForm.nameLength }}" autocomplete="name" required{% if problems.name %} aria-invalid="true" aria-describedby="contact-name-error"{% endif %} />
      {% if problems.name %}
      <span class="contact-field-error" id="contact-name-error">{{ problems.name }}</span>
      {% endif %}
    </p>

    <p class="contact-field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="{{ contactForm.fields.email }}" type="email" value="{{ contactForm.values.email }}" autocomplete="email" required{% if problems.email %} aria-invalid="true" aria-describedby="contact-email-error"{% endif %} />
      {% if problems.email %}
      <span class="contact-field-error" id="contact-email-error">{{ problems.email }}</span>
      {% endif %}
      <span class="contact-hint">So there is somewhere to reply to. It is never shown on the site.</span>
    </p>
    </div>

    <p class="contact-field">
      <label for="contact-subject">Subject <span class="contact-optional">(optional)</span></label>
      <input id="contact-subject" name="{{ contactForm.fields.subject }}" type="text" value="{{ contactForm.values.subject }}" maxlength="{{ contactForm.subjectLength }}"{% if problems.subject %} aria-invalid="true" aria-describedby="contact-subject-error"{% endif %} />
      {% if problems.subject %}
      <span class="contact-field-error" id="contact-subject-error">{{ problems.subject }}</span>
      {% endif %}
    </p>

    <p class="contact-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="{{ contactForm.fields.message }}" rows="8" maxlength="{{ contactForm.messageLength }}" required{% if problems.message %} aria-invalid="true" aria-describedby="contact-message-error"{% endif %}>{{ contactForm.values.message }}</textarea>
      {% if problems.message %}
      <span class="contact-field-error" id="contact-message-error">{{ problems.message }}</span>
      {% endif %}
    </p>

    <p class="form-submit">
      <button type="submit">Send message</button>
    </p>
  </form>
  {% endif %}
</section>
