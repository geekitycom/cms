{% extends "layouts/base.njk" %}
{% import "partials/kicker.njk" as kicker with context %}

{% block content %}
<article class="server-error">
  {{ kicker.line("Server error") }}
  <h1 class="page-title">Something went wrong.</h1>
  <p>This page could not be shown because of a problem on the server. Try again in a moment, or go <a href="{{ "/" | url }}">home</a>.</p>
</article>
{% endblock %}
