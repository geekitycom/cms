{% extends "layouts/base.njk" %}

{% block title %}Tagged &ldquo;{{ tag }}&rdquo;{% if pagination.pageNumber > 0 %}, page {{ pagination.pageNumber + 1 }}{% endif %} &middot; {{ site.title }}{% endblock %}

{% import "partials/feeds.njk" as feeds %}
{% set tagRoot = "/" + (site.tagBase or "tag") + "/" + (tag | urlencode) + "/" %}
{% block alternates %}
{{ super() }}
{{ feeds.feedLinks(tagRoot, site.title + ": " + tag) }}
{% endblock %}

{% block content %}
<h1 class="page-title">Tagged &ldquo;{{ tag }}&rdquo;</h1>
{% include "partials/post-list.njk" %}
{% include "partials/pagination.njk" %}
{% endblock %}
