{#
  One person's archive, at `/author/{username}/`.

  decision-14 makes this URL their ActivityPub actor as well, so a peer asking
  for the actor and a reader asking for the page are at the same address; this
  is the page half of it. `author` is the profile — `name`, and whatever of
  `bio`, `avatar` and `links` they have written — and it is the same shape a
  byline under a post is given.
#}
{% extends "layouts/base.njk" %}

{% block title %}{{ author.name }}{% if pagination.pageNumber > 0 %}, page {{ pagination.pageNumber + 1 }}{% endif %} &middot; {{ site.title }}{% endblock %}

{% import "partials/feeds.njk" as feeds %}
{% block alternates %}
{{ super() }}
{{ feeds.feedLinks(author.url, site.title + ": " + author.name) }}
{% endblock %}

{% block content %}
<header class="author-header h-card">
  {% if author.avatar %}
  <img class="author-avatar u-photo" src="{{ author.avatar | url }}" alt="" width="96" height="96">
  {% endif %}
  <h1 class="page-title p-name">{{ author.name }}</h1>
  {% if author.bio %}
  <p class="author-bio p-note">{{ author.bio }}</p>
  {% endif %}
  {% if author.links.length %}
  <ul class="author-links">
    {% for link in author.links %}
    <li><a class="u-url" rel="me" href="{{ link.href }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</header>

<p class="tag-count">
  {{ pagination.total }} {% if pagination.total == 1 %}entry{% else %}entries{% endif %}.
</p>
{% include "partials/post-list.njk" %}
{% include "partials/pagination.njk" %}
{% endblock %}
