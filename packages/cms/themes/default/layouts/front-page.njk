{#
  The front page: the page the Reading setting names, read at `/`.

  A site that wants more on its front page overrides this file in its own
  theme. `newestPosts(count)` lists the newest published posts as listing
  entries and `postsPage` names the page carrying the listing; the theme README
  has an example. On a solo author site the base layout keeps the homepage's
  `rel="me"` claims in the head whatever this file prints (decision-45).
#}
{% extends "layouts/base.njk" %}

{% block content %}
{% if title %}
<h2 class="section-title">{{ title }}</h2>
{% endif %}
<div class="page-body e-content">
  {{ content | safe }}
</div>

{# A homepage may ask for a contact form like any other page (TASK-56). #}
{% if contactForm %}
{% include "partials/contact-form.njk" %}
{% endif %}
{% endblock %}
