{% extends "layouts/base.njk" %}

{% block title %}Filed under &ldquo;{{ category }}&rdquo;{% if pagination.pageNumber > 0 %}, page {{ pagination.pageNumber + 1 }}{% endif %} &middot; {{ site.title }}{% endblock %}

{% import "partials/feeds.njk" as feeds %}
{% set categoryRoot = "/" + (site.categoryBase or "category") + "/" + (category | urlencode) + "/" %}
{% block alternates %}
{{ super() }}
{{ feeds.feedLinks(categoryRoot, site.title + ": " + category) }}
{% endblock %}

{% block content %}
{#
  The archive's header. `categoryDescription` is what the design prints under
  the name; nothing in the CMS writes one yet, so the header is the heading
  alone until something does — a site whose own context carries one gets it
  printed without overriding this layout.
#}
<header class="category-header">
  <h1 class="page-title">Filed under &ldquo;{{ category }}&rdquo;</h1>
  {% if categoryDescription %}
  <div class="category-description">{{ categoryDescription }}</div>
  {% endif %}
</header>
{% include "partials/post-list.njk" %}
{% include "partials/pagination.njk" %}
{% endblock %}
