{% extends "layouts/base.njk" %}

{% block content %}
<article class="page h-entry">
  <header class="page-header">
    <h1 class="page-title p-name">{{ title }}</h1>
  </header>

  <div class="page-body e-content">
    {{ content | safe }}
  </div>
</article>

{# Only a page whose front matter says `contact: true` has one (TASK-56). #}
{% if contactForm %}
{% include "partials/contact-form.njk" %}
{% endif %}
{% endblock %}
