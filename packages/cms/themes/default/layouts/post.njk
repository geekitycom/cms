{% extends "layouts/base.njk" %}
{% import "partials/tags.njk" as taxonomy with context %}

{% block content %}
<article class="post h-entry">
  <header class="post-header">
    <h1 class="post-title p-name">{{ title }}</h1>
    {% if date %}
    <p class="post-meta">
      Published
      <time class="dt-published" datetime="{{ date | date("iso") }}">{{ date | date }}</time>
      {% if updated %}
      &middot; updated
      <time class="dt-updated" datetime="{{ updated | date("iso") }}">{{ updated | date }}</time>
      {% endif %}
    </p>
    {% endif %}
  </header>

  <div class="post-body e-content">
    {{ content | safe }}
  </div>

  {% if tags.length or categories.length %}
  <footer class="post-footer">
    {{ taxonomy.categories(categories) }}
    {{ taxonomy.list(tags) }}
  </footer>
  {% endif %}
</article>

{# Only a post that has been replied to, liked or boosted has one of these. #}
{% if conversation %}
{% include "partials/conversation.njk" %}
{% endif %}

{# And only one that is still taking comments has a form (TASK-50). #}
{% if commentForm %}
{% include "partials/comment-form.njk" %}
{% endif %}
{% endblock %}
