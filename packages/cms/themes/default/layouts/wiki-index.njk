{#
  The wiki index: every published wiki page at the wiki base, A to Z by title,
  on one page with no pager.

  `wikiGroups` holds a group for each first letter, in order: a `letter`
  (upper case and without its accent, or `#` for titles that start with a
  digit or a symbol) and its `pages`, each a listing entry with a `url`, a
  `label` and a `description`. It is drawn as the archive of months is, a
  heading over an `ol.list-none` of links, with a line of the letters above
  it to jump to one.
#}
{% extends "layouts/base.njk" %}

{% block title %}{{ title }} &middot; {{ site.title }}{% endblock %}

{% import "partials/kicker.njk" as kicker with context %}
{% block content %}
<header class="archive-header">
  {{ kicker.line("Wiki") }}
  <h1 class="page-title">{{ title }}</h1>
</header>
<nav class="wiki-index-letters" aria-label="Jump to a letter">
  {% for group in wikiGroups %}
  <a href="#wiki-index-{{ group.letter | urlencode }}">{{ group.letter }}</a>
  {% endfor %}
</nav>
<section class="archive wiki-index">
  {% for group in wikiGroups %}
  <h2 id="wiki-index-{{ group.letter }}">{{ group.letter }}</h2>
  <ol class="list-none">
    {% for entry in group.pages %}
    <li><a href="{{ entry.url | url }}"><span>{{ entry.label }}</span></a></li>
    {% endfor %}
  </ol>
  {% endfor %}
</section>
{% endblock %}
