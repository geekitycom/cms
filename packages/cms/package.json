{
  "name": "@geekity/cms",
  "version": "0.23.0",
  "type": "module",
  "description": "A file-first CMS: Markdown content, a SQLite index, a Hono server that is both the editor and the public site.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "geekity": "./dist/cli.js"
  },
  "files": [
    "dist",
    "admin",
    "themes",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-editor.js && pnpm build:theme && pnpm build:admin",
    "build:editor": "node scripts/build-editor.js",
    "build:admin": "tailwindcss -i admin/src/admin.css -o admin/static/admin.css --optimize",
    "build:highlight": "node scripts/build-highlight.js",
    "build:theme": "tailwindcss -i themes/default/src/style.css -o themes/default/static/style.css --optimize",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pretest": "pnpm build:theme && pnpm build:admin",
    "test": "tsx --import ./src/__testing__/offline.ts --test \"src/**/*.test.ts\"",
    "test:11ty": "tsx --test \"test/*.test.ts\"",
    "fed:smoke": "tsx scripts/fed-smoke.ts",
    "pretest:coverage": "pnpm build:theme && pnpm build:admin",
    "test:coverage": "tsx --import ./src/__testing__/offline.ts --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p editor/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fedify/fedify": "^2.4.0",
    "@fedify/hono": "^2.4.0",
    "@fedify/vocab": "^2.4.0",
    "@hono/node-server": "^2.1.3",
    "@js-temporal/polyfill": "^0.5.1",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "nodemailer": "^10.0.14",
    "nunjucks": "^3.2.4",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@fedify/cli": "2.4.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/cli": "^4.3.3",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.47",
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0",
    "microformats-parser": "^2.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
