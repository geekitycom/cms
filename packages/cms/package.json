{
  "name": "@geekity/cms",
  "version": "0.47.0",
  "type": "module",
  "description": "A file-first CMS: Markdown content, a SQLite index, a Hono server that is both the editor and the public site.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekitycom/cms.git",
    "directory": "packages/cms"
  },
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-entry.d.ts",
      "import": "./dist/config-entry.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "geekity": "./dist/cli.js"
  },
  "files": [
    "dist",
    "admin",
    "themes",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-editor.js && pnpm build:theme && pnpm build:admin",
    "build:editor": "node scripts/build-editor.js",
    "build:admin": "tailwindcss -i admin/src/admin.css -o admin/static/admin.css --optimize",
    "build:highlight": "node scripts/build-highlight.js",
    "build:theme": "tailwindcss -i themes/default/src/style.css -o themes/default/static/style.css --optimize",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pretest": "tsc -p tsconfig.build.json && pnpm build:theme && pnpm build:admin",
    "test": "node --import ./src/__testing__/offline.ts --test \"src/**/*.test.ts\"",
    "test:shard": "node scripts/test-shard.ts",
    "test:weights": "node scripts/test-shard.ts --measure",
    "test:11ty": "node --test \"test/*.test.ts\"",
    "fed:smoke": "tsx scripts/fed-smoke.ts",
    "pretest:coverage": "tsc -p tsconfig.build.json && pnpm build:theme && pnpm build:admin",
    "test:coverage": "node --import ./src/__testing__/offline.ts --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p editor/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@fedify/fedify": "^2.4.5",
    "@fedify/hono": "^2.4.5",
    "@fedify/sqlite": "^2.4.5",
    "@fedify/vocab": "^2.4.5",
    "@geekity/md2gemini": "workspace:^0.1.2",
    "@hono/node-server": "^2.1.5",
    "@js-temporal/polyfill": "^0.5.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.14",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "nodemailer": "^10.2.1",
    "nunjucks": "^3.2.4",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@fedify/cli": "2.4.5",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/cli": "^4.3.3",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "@types/semver": "^7.8.0",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.50",
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0",
    "microformats-parser": "^2.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@^6.0.3"
  }
}
