<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head><title>Nested</title></head>
  <body>
    <outline title="Software">
      <outline text="Tools">
        <outline text="Git news" xmlUrl="https://git.example/feed" htmlUrl="javascript:alert(1)"/>
        <outline text="Empty folder"/>
      </outline>
      <outline text="Rust" type="rss" xmlUrl="https://rust.example/feed.xml" htmlUrl="https://rust.example/"/>
    </outline>
    <outline text="Git news again" type="rss" xmlUrl="https://git.example/feed"/>
    <outline type="rss" xmlUrl="https://untitled.example/feed"/>
    <outline text="Gopher" type="rss" xmlUrl="gopher://old.example/feed"/>
    <outline text="Top level" type="rss" xmlUrl="https://top.example/feed" category="/Ignored" frss:ttl="1" xmlns:frss="https://freshrss.org/opml"/>
  </body>
</opml>
