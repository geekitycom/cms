{
  "name": "@geekity/plugin-llm",
  "version": "0.0.0",
  "type": "module",
  "description": "Geekity CMS plugin that connects the site to a language model through the OpenAI chat-completions API, OpenRouter by default.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "geekity": {
    "plugin": true,
    "hostApi": 1,
    "requires": {}
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-plugin-bundle.js",
    "test": "tsx --import ../cms/src/__testing__/offline.ts --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@geekity/cms": "workspace:^"
  },
  "devDependencies": {
    "@geekity/cms": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  }
}
