{
  "name": "@geekity/md2gemini",
  "version": "0.1.2",
  "type": "module",
  "description": "Converts Markdown to gemtext, the text format of the Gemini protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekitycom/cms.git",
    "directory": "packages/md2gemini"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
