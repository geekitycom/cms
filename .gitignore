node_modules/
dist/
*.tsbuildinfo

# Eleventy build output, if anyone builds a content directory in place
_site/

# The admin editor's bundle, written by `pnpm build` from packages/cms/editor/
packages/cms/admin/static/editor.js

# SQLite index and other derived state, including data/images/ — the image
# variants sharp derives from the originals under content/uploads/.
# data/users.json and data/keys/ are the exceptions: the password hashes and
# the actor's private key pairs are not derived, and are not a site's to
# publish either, which is the other reason this line is here.
data/
apps/*/data/

# Packed tarballs
*.tgz

# Secrets
.env
.env.*
!.env.example

# OS noise
.DS_Store

# The demo boots against its checked-in content directory in tests and dev,
# so the state the CMS keeps under content/ at runtime (decision-9) is residue
# here rather than anything the demo means to publish: federation followers
# and the inbox log, comments, and documents moved to the trash. A real site
# keeps all three. Uploads stay tracked, because the demo's are deliberate.
apps/demo/content/_data/federation/
apps/demo/content/_data/comments/
apps/demo/content/_trash/
